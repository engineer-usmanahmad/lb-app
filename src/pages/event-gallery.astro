---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch events with their images from database
const { data: events, error } = await supabase
  .from('events')
  .select(`
    *,
    event_images (*)
  `)
  .order('is_featured', { ascending: false })
  .order('event_date', { ascending: false });

if (error) {
  console.error('Error fetching events:', error);
}

// Get unique categories for filters
const categories = [...new Set(events?.map(event => event.category) || [])];
---

<Layout title="Event Gallery - LbisTech">
  <main class="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-indigo-100">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-r from-purple-600 via-pink-600 to-indigo-700 text-white">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <div class="text-center">
          <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-white to-pink-200 bg-clip-text text-transparent">
            Event Gallery
          </h1>
          <p class="text-xl md:text-2xl text-pink-100 max-w-3xl mx-auto leading-relaxed">
            Explore our vibrant collection of workshops, seminars, and training events that showcase our commitment to excellence in education
          </p>
        </div>
      </div>
      <!-- Decorative elements -->
      <div class="absolute top-0 left-0 w-full h-full overflow-hidden">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-pink-300/20 rounded-full blur-3xl"></div>
      </div>
    </section>

    <!-- Filters Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-white rounded-2xl shadow-xl p-8 mb-12">
        <div class="flex flex-col lg:flex-row gap-6 items-center justify-between">
          <!-- Search Bar -->
          <div class="flex-1 max-w-md">
            <div class="relative">
              <input
                type="text"
                id="searchInput"
                placeholder="Search events by title or location..."
                class="w-full pl-12 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition-all duration-300"
              />
              <svg class="absolute left-4 top-3.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>

          <!-- Category Filter Buttons -->
          <div class="flex flex-wrap gap-3">
            <button class="filter-btn active px-6 py-2 rounded-full bg-purple-600 text-white hover:bg-purple-700 transition-all duration-300" data-filter="all">
              All Events
            </button>
            {categories.map(category => (
              <button class="filter-btn px-6 py-2 rounded-full bg-gray-200 text-gray-700 hover:bg-purple-600 hover:text-white transition-all duration-300" data-filter={category}>
                {category}
              </button>
            ))}
          </div>

          <!-- View Toggle -->
          <div class="flex bg-gray-100 rounded-xl p-1">
            <button id="gridView" class="view-toggle active px-4 py-2 rounded-lg bg-white shadow-sm text-gray-700 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
              </svg>
            </button>
            <button id="masonryView" class="view-toggle px-4 py-2 rounded-lg text-gray-500 hover:text-gray-700 transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-7H5m14 14H5"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Events Grid -->
      <div id="eventsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {events?.map((event) => (
          <div class="event-card group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 overflow-hidden"
               data-category={event.category}
               data-title={event.title.toLowerCase()}
               data-location={event.location?.toLowerCase() || ''}>
            
            <!-- Image Container -->
            <div class="relative overflow-hidden h-64 bg-gradient-to-br from-purple-100 to-pink-100">
              {event.event_images && event.event_images.length > 0 ? (
                <div class="relative w-full h-full">
                  <img 
                    src={event.event_images.find(img => img.is_cover)?.image_url || event.event_images[0].image_url} 
                    alt={event.event_images.find(img => img.is_cover)?.image_alt || event.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                  
                  <!-- Image Count Badge -->
                  {event.event_images.length > 1 && (
                    <div class="absolute top-4 right-4 bg-black/70 text-white px-3 py-1 rounded-full text-sm font-semibold backdrop-blur-sm">
                      <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      {event.event_images.length}
                    </div>
                  )}
                </div>
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <div class="text-center">
                    <svg class="w-16 h-16 text-purple-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <p class="text-purple-600 font-semibold">Event</p>
                  </div>
                </div>
              )}
              
              <!-- Featured Badge -->
              {event.is_featured && (
                <div class="absolute top-4 left-4 bg-gradient-to-r from-yellow-400 to-orange-500 text-white px-3 py-1 rounded-full text-sm font-semibold shadow-lg">
                  ⭐ Featured
                </div>
              )}
              
              <!-- View Gallery Button -->
              <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <button class="view-gallery-btn bg-white text-purple-600 px-6 py-3 rounded-xl font-semibold hover:bg-purple-50 transition-colors duration-300 shadow-lg transform translate-y-4 group-hover:translate-y-0"
                        data-event-id={event.id}
                        data-event-title={event.title}>
                  <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  View Gallery
                </button>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                  {event.category}
                </span>
                <span class="text-sm text-gray-500">
                  {new Date(event.event_date).toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'short',
                    day: 'numeric'
                  })}
                </span>
              </div>
              
              <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-purple-600 transition-colors duration-300">
                {event.title}
              </h3>
              
              {event.location && (
                <div class="flex items-center text-gray-600 mb-3">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span class="text-sm">{event.location}</span>
                </div>
              )}
              
              {event.short_description && (
                <p class="text-gray-600 text-sm leading-relaxed">
                  {event.short_description}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- No Results Message -->
      <div id="noResults" class="hidden text-center py-16">
        <div class="max-w-md mx-auto">
          <svg class="w-24 h-24 text-gray-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">No events found</h3>
          <p class="text-gray-600">Try adjusting your search or filter criteria.</p>
        </div>
      </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="lightboxModal" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4">
      <div class="relative max-w-6xl max-h-full w-full">
        <!-- Close Button -->
        <button id="closeLightbox" class="absolute -top-12 right-0 text-white hover:text-gray-300 transition-colors duration-300">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <!-- Image Container -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-2xl">
          <div class="relative">
            <img id="lightboxImage" src="" alt="" class="w-full max-h-[70vh] object-contain">
            
            <!-- Navigation Arrows -->
            <button id="prevImage" class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-black/50 text-white p-3 rounded-full hover:bg-black/70 transition-colors duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
            
            <button id="nextImage" class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-black/50 text-white p-3 rounded-full hover:bg-black/70 transition-colors duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>

          <!-- Image Info -->
          <div class="p-6">
            <h3 id="lightboxTitle" class="text-xl font-bold text-gray-900 mb-2"></h3>
            <p id="lightboxCaption" class="text-gray-600"></p>
            <div class="flex items-center justify-between mt-4">
              <span id="imageCounter" class="text-sm text-gray-500"></span>
              <div class="flex gap-2">
                <div id="thumbnailStrip" class="flex gap-2 max-w-md overflow-x-auto"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ events }}>
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchInput');
      const filterButtons = document.querySelectorAll('.filter-btn');
      const eventCards = document.querySelectorAll('.event-card');
      const noResults = document.getElementById('noResults');
      const eventsGrid = document.getElementById('eventsGrid');
      const viewGalleryBtns = document.querySelectorAll('.view-gallery-btn');
      
      // Lightbox elements
      const lightboxModal = document.getElementById('lightboxModal');
      const lightboxImage = document.getElementById('lightboxImage');
      const lightboxTitle = document.getElementById('lightboxTitle');
      const lightboxCaption = document.getElementById('lightboxCaption');
      const imageCounter = document.getElementById('imageCounter');
      const thumbnailStrip = document.getElementById('thumbnailStrip');
      const closeLightbox = document.getElementById('closeLightbox');
      const prevImage = document.getElementById('prevImage');
      const nextImage = document.getElementById('nextImage');

      let currentCategoryFilter = 'all';
      let currentSearchTerm = '';
      let currentEventImages = [];
      let currentImageIndex = 0;

      // Filter functionality
      function filterCards() {
        let visibleCount = 0;

        eventCards.forEach(card => {
          const cardCategory = card.dataset.category;
          const cardTitle = card.dataset.title;
          const cardLocation = card.dataset.location;

          const matchesCategory = currentCategoryFilter === 'all' || cardCategory === currentCategoryFilter;
          const matchesSearch = !currentSearchTerm || 
            cardTitle.includes(currentSearchTerm.toLowerCase()) || 
            cardLocation.includes(currentSearchTerm.toLowerCase());

          if (matchesCategory && matchesSearch) {
            card.style.display = 'block';
            card.style.animation = 'fadeInUp 0.5s ease-out';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Show/hide no results message
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          eventsGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          eventsGrid.classList.remove('hidden');
        }
      }

      // Search functionality
      searchInput.addEventListener('input', function() {
        currentSearchTerm = this.value.trim();
        filterCards();
      });

      // Category filter buttons
      filterButtons.forEach(button => {
        button.addEventListener('click', function() {
          // Update active state
          filterButtons.forEach(btn => {
            btn.classList.remove('active', 'bg-purple-600', 'text-white');
            btn.classList.add('bg-gray-200', 'text-gray-700');
          });
          
          this.classList.add('active', 'bg-purple-600', 'text-white');
          this.classList.remove('bg-gray-200', 'text-gray-700');

          currentCategoryFilter = this.dataset.filter;
          filterCards();
        });
      });

      // Lightbox functionality
      function openLightbox(eventId, eventTitle) {
        const event = events.find(e => e.id === eventId);
        if (!event || !event.event_images || event.event_images.length === 0) return;

        currentEventImages = event.event_images;
        currentImageIndex = 0;
        
        lightboxTitle.textContent = eventTitle;
        showImage(0);
        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function showImage(index) {
        if (index < 0 || index >= currentEventImages.length) return;
        
        currentImageIndex = index;
        const image = currentEventImages[index];
        
        lightboxImage.src = image.image_url;
        lightboxImage.alt = image.image_alt || '';
        lightboxCaption.textContent = image.caption || '';
        imageCounter.textContent = `${index + 1} of ${currentEventImages.length}`;
        
        // Update thumbnails
        updateThumbnails();
      }

      function updateThumbnails() {
        thumbnailStrip.innerHTML = '';
        currentEventImages.forEach((image, index) => {
          const thumb = document.createElement('img');
          thumb.src = image.image_url;
          thumb.alt = image.image_alt || '';
          thumb.className = `w-12 h-12 object-cover rounded cursor-pointer border-2 transition-all duration-300 ${
            index === currentImageIndex ? 'border-purple-500' : 'border-gray-300 hover:border-purple-300'
          }`;
          thumb.addEventListener('click', () => showImage(index));
          thumbnailStrip.appendChild(thumb);
        });
      }

      function closeLightboxModal() {
        lightboxModal.classList.add('hidden');
        lightboxModal.classList.remove('flex');
        document.body.style.overflow = 'auto';
      }

      // Event listeners for lightbox
      viewGalleryBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const eventId = this.dataset.eventId;
          const eventTitle = this.dataset.eventTitle;
          openLightbox(eventId, eventTitle);
        });
      });

      closeLightbox.addEventListener('click', closeLightboxModal);
      
      prevImage.addEventListener('click', () => {
        const newIndex = currentImageIndex > 0 ? currentImageIndex - 1 : currentEventImages.length - 1;
        showImage(newIndex);
      });
      
      nextImage.addEventListener('click', () => {
        const newIndex = currentImageIndex < currentEventImages.length - 1 ? currentImageIndex + 1 : 0;
        showImage(newIndex);
      });

      // Close lightbox on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !lightboxModal.classList.contains('hidden')) {
          closeLightboxModal();
        }
        if (e.key === 'ArrowLeft' && !lightboxModal.classList.contains('hidden')) {
          prevImage.click();
        }
        if (e.key === 'ArrowRight' && !lightboxModal.classList.contains('hidden')) {
          nextImage.click();
        }
      });

      // Close lightbox on background click
      lightboxModal.addEventListener('click', function(e) {
        if (e.target === this) {
          closeLightboxModal();
        }
      });

      // Add CSS animations
      const style = document.createElement('style');
      style.textContent = `
        @keyframes fadeInUp {
          from {
            opacity: 0;
            transform: translateY(30px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
        
        .event-card {
          animation: fadeInUp 0.6s ease-out;
        }
        
        .event-card:hover {
          box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        #thumbnailStrip {
          scrollbar-width: thin;
          scrollbar-color: #a855f7 #f3f4f6;
        }

        #thumbnailStrip::-webkit-scrollbar {
          height: 4px;
        }

        #thumbnailStrip::-webkit-scrollbar-track {
          background: #f3f4f6;
          border-radius: 2px;
        }

        #thumbnailStrip::-webkit-scrollbar-thumb {
          background: #a855f7;
          border-radius: 2px;
        }
      `;
      document.head.appendChild(style);
    });
  </script>
</Layout>