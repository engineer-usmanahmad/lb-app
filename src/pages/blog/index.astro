
---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

// Fetch published blog posts
const { data: posts } = await supabase
  .from('blog_posts')
  .select(`
    *,
    admin_users:author_id (
      first_name,
      last_name
    )
  `)
  .eq('status', 'published')
  .order('published_at', { ascending: false });

const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<Layout title="Blog - LbisTech">
  <Header />
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-900 to-primary-700 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        LbisTech Blog
      </h1>
      <p class="text-xl text-primary-100 max-w-3xl mx-auto">
        Stay updated with the latest insights, tutorials, and industry news in technology education and professional development.
      </p>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      {posts && posts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
              {post.featured_image && (
                <img 
                  src={post.featured_image} 
                  alt={post.title}
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-6">
                <div class="text-sm text-gray-500 mb-2">
                  {post.published_at && formatDate(post.published_at)}
                  {post.admin_users && (
                    <span class="ml-2">
                      by {post.admin_users.first_name} {post.admin_users.last_name}
                    </span>
                  )}
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">
                  <a href={`/blog/${post.slug}`} class="hover:text-coral-500 transition-colors">
                    {post.title}
                  </a>
                </h2>
                {post.excerpt && (
                  <p class="text-gray-600 mb-4 line-clamp-3">
                    {post.excerpt}
                  </p>
                )}
                <a 
                  href={`/blog/${post.slug}`}
                  class="text-coral-500 hover:text-coral-600 font-semibold inline-flex items-center"
                >
                  Read More
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <div class="w-16 h-16 mx-auto mb-4 bg-gray-200 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">No blog posts yet</h3>
          <p class="text-gray-600">Check back soon for our latest insights and tutorials.</p>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
