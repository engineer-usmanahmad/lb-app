---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/events');
}

// Fetch the specific event with its images
const { data: event, error } = await supabase
  .from('events')
  .select(`
    *,
    event_images (
      id,
      image_url,
      image_alt,
      caption,
      is_cover,
      display_order
    )
  `)
  .eq('id', id)
  .single();

if (error || !event) {
  console.error('Error fetching event:', error);
  return Astro.redirect('/events');
}

// Sort images - cover image first, then by display order
const sortedImages = event.event_images?.sort((a, b) => {
  if (a.is_cover && !b.is_cover) return -1;
  if (!a.is_cover && b.is_cover) return 1;
  return a.display_order - b.display_order;
}) || [];

const coverImage = sortedImages.find(img => img.is_cover) || sortedImages[0];
const galleryImages = sortedImages.filter(img => !img.is_cover);

// Format date
const eventDate = new Date(event.event_date);
const formattedDate = eventDate.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={`${event.title} - LbisTech Events`}>
  <Header />
  
  <!-- Event Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-900 via-primary-800 to-coral-600 text-white py-16 overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#grid)" />
      </svg>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Breadcrumb -->
        <nav class="mb-6">
          <ol class="flex items-center justify-center space-x-2 text-sm">
            <li><a href="/" class="hover:text-coral-300 transition-colors">Home</a></li>
            <li class="text-coral-300">/</li>
            <li><a href="/events" class="hover:text-coral-300 transition-colors">Events</a></li>
            <li class="text-coral-300">/</li>
            <li class="text-coral-200">{event.title}</li>
          </ol>
        </nav>
        
        <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">
          {event.title}
        </h1>
        
        <div class="flex flex-wrap items-center justify-center gap-6 text-lg">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-coral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span>{formattedDate}</span>
          </div>
          
          {event.location && (
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-coral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>{event.location}</span>
            </div>
          )}
          
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-coral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            <span class="bg-coral-500 text-white px-3 py-1 rounded-full text-sm font-medium">
              {event.category}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Event Content -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
          <!-- Event Details -->
          <div class="space-y-8">
            <div class="bg-white rounded-2xl shadow-lg p-8">
              <h2 class="text-2xl font-bold text-primary-900 mb-6">Event Details</h2>
              
              {event.short_description && (
                <div class="prose prose-lg max-w-none">
                  <div class="text-gray-700 leading-relaxed" set:html={event.short_description}></div>
                </div>
              )}
              
              <div class="mt-8 grid sm:grid-cols-2 gap-6">
                <div class="bg-primary-50 rounded-xl p-6">
                  <h3 class="font-semibold text-primary-900 mb-2">Date & Time</h3>
                  <p class="text-primary-700">{formattedDate}</p>
                </div>
                
                {event.location && (
                  <div class="bg-coral-50 rounded-xl p-6">
                    <h3 class="font-semibold text-coral-900 mb-2">Location</h3>
                    <p class="text-coral-700">{event.location}</p>
                  </div>
                )}
                
                <div class="bg-green-50 rounded-xl p-6">
                  <h3 class="font-semibold text-green-900 mb-2">Category</h3>
                  <p class="text-green-700">{event.category}</p>
                </div>
              </div>
            </div>
            
            <!-- Back to Events Button -->
            <div class="text-center">
              <a 
                href="/events" 
                class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to All Events
              </a>
            </div>
          </div>
          
          <!-- Event Images -->
          <div class="space-y-6">
            {coverImage && (
              <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="aspect-video relative cursor-pointer group" data-image-index="0">
                  <img 
                    src={coverImage.image_url} 
                    alt={coverImage.image_alt || event.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    <div class="bg-white/90 rounded-full p-3">
                      <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                      </svg>
                    </div>
                  </div>
                  {coverImage.caption && (
                    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
                      <p class="text-white text-sm">{coverImage.caption}</p>
                    </div>
                  )}
                </div>
              </div>
            )}
            
            {galleryImages.length > 0 && (
              <div class="bg-white rounded-2xl shadow-lg p-6">
                <h3 class="text-xl font-bold text-primary-900 mb-4">Event Gallery</h3>
                <div class="grid grid-cols-2 gap-4">
                  {galleryImages.map((image, index) => (
                    <div key={image.id} class="aspect-square relative rounded-xl overflow-hidden group cursor-pointer" data-image-index={coverImage ? index + 1 : index}>
                      <img 
                        src={image.image_url} 
                        alt={image.image_alt || `${event.title} gallery image`}
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
                      />
                      <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                        <div class="bg-white/90 rounded-full p-2">
                          <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                          </svg>
                        </div>
                      </div>
                      {image.caption && (
                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-3">
                          <p class="text-white text-xs">{image.caption}</p>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
            
            {sortedImages.length === 0 && (
              <div class="bg-white rounded-2xl shadow-lg p-8 text-center">
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">No Images Available</h3>
                <p class="text-gray-600">Images for this event will be uploaded soon.</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden flex items-center justify-center">
    <div class="relative max-w-7xl max-h-full w-full h-full flex items-center justify-center p-4">
      <!-- Close Button -->
      <button 
        onclick="closeLightbox()" 
        class="absolute top-4 right-4 z-10 bg-white/20 hover:bg-white/30 text-white rounded-full p-2 transition-colors duration-200"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      
      <!-- Previous Button -->
      <button 
        id="prevBtn"
        onclick="previousImage()" 
        class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-white/20 hover:bg-white/30 text-white rounded-full p-3 transition-colors duration-200"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      <!-- Next Button -->
      <button 
        id="nextBtn"
        onclick="nextImage()" 
        class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-white/20 hover:bg-white/30 text-white rounded-full p-3 transition-colors duration-200"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
      
      <!-- Image Container -->
      <div class="relative max-w-full max-h-full">
        <img 
          id="lightboxImage" 
          src="" 
          alt="" 
          class="max-w-full max-h-full object-contain rounded-lg shadow-2xl"
        />
        <div id="lightboxCaption" class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4 text-white text-center hidden">
          <p class="text-sm"></p>
        </div>
      </div>
      
      <!-- Image Counter -->
      <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 bg-white/20 text-white px-4 py-2 rounded-full text-sm">
        <span id="imageCounter">1 / 1</span>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script define:vars={{ images: [
  ...(coverImage ? [{
    url: coverImage.image_url,
    alt: coverImage.image_alt || event.title,
    caption: coverImage.caption || ''
  }] : []),
  ...galleryImages.map((image) => ({
    url: image.image_url,
    alt: image.image_alt || `${event.title} gallery image`,
    caption: image.caption || ''
  }))
] }}>
  let currentImageIndex = 0;

  // Add click event listeners to image containers
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-image-index]').forEach(container => {
      container.addEventListener('click', function() {
        const index = parseInt(this.getAttribute('data-image-index'));
        openLightbox(index);
      });
    });
  });

  function openLightbox(index) {
    currentImageIndex = index;
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightboxImage');
    const lightboxCaption = document.getElementById('lightboxCaption');
    const imageCounter = document.getElementById('imageCounter');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    if (images.length > 0) {
      const image = images[currentImageIndex];
      lightboxImage.src = image.url;
      lightboxImage.alt = image.alt;
      
      // Update caption
      if (image.caption) {
        lightboxCaption.querySelector('p').textContent = image.caption;
        lightboxCaption.classList.remove('hidden');
      } else {
        lightboxCaption.classList.add('hidden');
      }
      
      // Update counter
      imageCounter.textContent = `${currentImageIndex + 1} / ${images.length}`;
      
      // Show/hide navigation buttons
      prevBtn.style.display = images.length > 1 ? 'block' : 'none';
      nextBtn.style.display = images.length > 1 ? 'block' : 'none';
      
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    lightbox.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  function nextImage() {
    if (images.length > 1) {
      currentImageIndex = (currentImageIndex + 1) % images.length;
      openLightbox(currentImageIndex);
    }
  }

  function previousImage() {
    if (images.length > 1) {
      currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
      openLightbox(currentImageIndex);
    }
  }

  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    const lightbox = document.getElementById('lightbox');
    if (!lightbox.classList.contains('hidden')) {
      switch(e.key) {
        case 'Escape':
          closeLightbox();
          break;
        case 'ArrowLeft':
          previousImage();
          break;
        case 'ArrowRight':
          nextImage();
          break;
      }
    }
  });

  // Close lightbox when clicking outside the image
  document.getElementById('lightbox').addEventListener('click', function(e) {
    if (e.target === this) {
      closeLightbox();
    }
  });
</script>

<style>
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
</style>