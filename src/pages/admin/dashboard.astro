---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

/// Fetch dashboard data
const { data: contactStats } = await supabase
  .from('contact_submissions')
  .select('status')
  .order('created_at', { ascending: false });

const { data: enrollmentStats } = await supabase
  .from('enrollment_submissions')
  .select('status, course_id')
  .order('created_at', { ascending: false });

const { data: recentContacts } = await supabase
  .from('contact_submissions')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

const { data: recentEnrollments } = await supabase
  .from('enrollment_submissions')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

const { data: recentPosts } = await supabase
  .from('blog_posts')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

const { data: blogStats } = await supabase
  .from('blog_posts')
  .select('status')
  .order('created_at', { ascending: false });

// Fetch forms data from Form Builder
const { data: forms } = await supabase
  .from('form_templates')
  .select('*')
  .order('created_at', { ascending: false });

// Fetch success stories data
const { data: successStories } = await supabase
  .from('success_stories')
  .select('*')
  .order('created_at', { ascending: false });

// Fetch events data
const { data: events } = await supabase
  .from('events')
  .select(`
    *,
    event_images (
      id,
      image_url,
      is_cover
    )
  `)
  .order('created_at', { ascending: false });

// Calculate stats
const totalContacts = contactStats?.length || 0;
const newContacts = contactStats?.filter(c => c.status === 'new').length || 0;
const totalEnrollments = enrollmentStats?.length || 0;
const pendingEnrollments = enrollmentStats?.filter(e => e.status === 'pending').length || 0;

// Course enrollment stats
const courseEnrollments = enrollmentStats?.reduce((acc, curr) => {
  acc[curr.course_id] = (acc[curr.course_id] || 0) + 1;
  return acc;
}, {} as Record<string, number>) || {};

// Blog stats
const totalPosts = blogStats?.length || 0;
const publishedPosts = blogStats?.filter(p => p.status === 'published').length || 0;
const draftPosts = blogStats?.filter(p => p.status === 'draft').length || 0;

// Success stories stats
const successStoriesCount = successStories?.length || 0;
const featuredStoriesCount = successStories?.filter(s => s.is_featured).length || 0;
const uniqueProvidersCount = [...new Set(successStories?.map(s => s.provider) || [])].length;

// Events stats
const eventsCount = events?.length || 0;
const totalEventImages = events?.reduce((acc, event) => acc + (event.event_images?.length || 0), 0) || 0;
const uniqueEventCategories = [...new Set(events?.map(e => e.category) || [])].length;
---

<Layout title="Admin Dashboard - LbisTech">
  <Header />
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
            <p class="text-gray-600">Manage contacts, enrollments, and forms</p>
          </div>
          <div class="flex items-center space-x-4">
            <span class="text-sm text-gray-500">Last updated: {new Date().toLocaleString()}</span>
            <a href="/" class="text-coral-500 hover:text-coral-600">← Back to Site</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 mb-8">
        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Total Contacts</dt>
                  <dd class="text-lg font-medium text-gray-900">{totalContacts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-coral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM9 17H4l5 5v-5zM15 7h5l-5-5v5zM9 7H4L9 2v5z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">New Contacts</dt>
                  <dd class="text-lg font-medium text-coral-500">{newContacts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Total Enrollments</dt>
                  <dd class="text-lg font-medium text-gray-900">{totalEnrollments}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Pending Enrollments</dt>
                  <dd class="text-lg font-medium text-yellow-600">{pendingEnrollments}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Total Blog Posts</dt>
                  <dd class="text-lg font-medium text-gray-900">{totalPosts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Published Posts</dt>
                  <dd class="text-lg font-medium text-green-600">{publishedPosts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Course Enrollment Statistics -->
      <div class="mb-8 bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Course Enrollment Statistics</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {Object.entries(courseEnrollments).map(([courseId, count]) => (
              <div class="p-4 bg-gray-50 rounded-lg">
                <p class="text-sm font-medium text-gray-900 capitalize">{courseId.replace('-', ' ')}</p>
                <p class="text-2xl font-bold text-coral-500">{count}</p>
                <p class="text-xs text-gray-500">Total Enrollments</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Blog Management -->
      <div class="mb-8">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg leading-6 font-medium text-gray-900">Blog Management</h3>
              <button id="create-post-btn" class="bg-coral-500 hover:bg-coral-600 text-white px-4 py-2 rounded-lg transition-colors">
                Create New Post
              </button>
            </div>
            <div class="space-y-2">
              {recentPosts?.map(post => (
                <div class="post-item border border-gray-200 rounded-lg">
                  <div class="flex items-center justify-between p-4 bg-gray-50">
                    <div class="flex items-center">
                      <span class="w-8 h-8 bg-purple-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-3">
                        📝
                      </span>
                      <div>
                        <h4 class="font-semibold text-gray-900">{post.title}</h4>
                        <p class="text-sm text-gray-500">
                          {new Date(post.created_at).toLocaleDateString()} -
                          <span class={`ml-1 ${post.status === 'published' ? 'text-green-600' : 'text-yellow-600'}`}>
                            {post.status}
                          </span>
                        </p>
                      </div>
                    </div>
                    <div class="flex space-x-3">
                      <button class="edit-post-btn text-coral-500 hover:text-coral-600 text-sm font-medium" data-post={JSON.stringify(post)}>Edit</button>
                      {post.status === 'published' && (
                        <a href={`/blog/${post.slug}`} target="_blank" class="text-blue-500 hover:text-blue-600 text-sm font-medium">View</a>
                      )}
                      <button
                        class="delete-post-btn text-red-600 hover:text-red-700 text-sm font-medium"
                        data-id={post.id}
                        data-title={post.title}
                      >
                        Delete
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Our Success Management -->
      <div class="mb-8">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg leading-6 font-medium text-gray-900">Our Success Management</h3>
              <a href="/admin/success-stories" class="bg-purple-500 hover:bg-purple-600 text-white px-4 py-2 rounded-lg transition-colors">
                Manage Success Stories
              </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <div class="bg-purple-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <svg class="h-8 w-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-purple-900">Total Stories</p>
                    <p class="text-2xl font-bold text-purple-600">{successStoriesCount || 0}</p>
                  </div>
                </div>
              </div>
              <div class="bg-green-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <svg class="h-8 w-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-green-900">Featured</p>
                    <p class="text-2xl font-bold text-green-600">{featuredStoriesCount || 0}</p>
                  </div>
                </div>
              </div>
              <div class="bg-blue-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <svg class="h-8 w-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-blue-900">Providers</p>
                    <p class="text-2xl font-bold text-blue-600">{uniqueProvidersCount || 0}</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="text-sm text-gray-600">
              <p>Manage student certifications and success stories. Add new achievements, edit existing ones, and showcase your students' accomplishments.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Event Gallery Management -->
      <div class="mb-8">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg leading-6 font-medium text-gray-900">Event Gallery Management</h3>
              <a href="/admin/events" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-colors">
                Manage Events
              </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <div class="bg-blue-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <svg class="h-8 w-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-blue-900">Total Events</p>
                    <p class="text-2xl font-bold text-blue-600">{eventsCount || 0}</p>
                  </div>
                </div>
              </div>
              <div class="bg-green-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <svg class="h-8 w-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-green-900">Total Images</p>
                    <p class="text-2xl font-bold text-green-600">{totalEventImages || 0}</p>
                  </div>
                </div>
              </div>
              <div class="bg-purple-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <svg class="h-8 w-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-purple-900">Categories</p>
                    <p class="text-2xl font-bold text-purple-600">{uniqueEventCategories || 0}</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="text-sm text-gray-600">
              <p>Manage event galleries with drag-and-drop image uploads. Create events, organize images, and showcase your activities.</p>
            </div>
          </div>
        </div>
      </div>



      <!-- Form Management -->
      <div class="mb-8">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-4 sm:p-5">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Form Management</h3>
            <!-- Compact professional card grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Feedback Management Card -->
              <a href="/admin/feedback-forms" class="group block rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50 to-purple-50 hover:from-indigo-100 hover:to-purple-100 shadow-sm hover:shadow-lg transition-all">
                <div class="p-5 h-full flex items-start justify-between">
                  <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 text-white shadow-md">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h6m5 8H6a2 2 0 01-2-2V6a2 2 0 012-2h8.5a1 1 0 01.7.3l4.5 4.5a1 1 0 01.3.7V18a2 2 0 01-2 2z" />
                      </svg>
                    </span>
                    <div>
                      <div class="text-base font-semibold text-indigo-800">Feedback Management</div>
                      <div class="text-sm text-gray-600">Review submissions, individual responses, summaries</div>
                    </div>
                  </div>
                  <svg class="w-5 h-5 text-indigo-500 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>

              <!-- Open Form Builder Card -->
              <a href="/admin/form-builder" class="group block rounded-2xl border border-purple-200 bg-gradient-to-br from-purple-50 to-pink-50 hover:from-purple-100 hover:to-pink-100 shadow-sm hover:shadow-lg transition-all">
                <div class="p-5 h-full flex items-start justify-between">
                  <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-tr from-purple-600 to-pink-500 text-white shadow-md">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                      </svg>
                    </span>
                    <div>
                      <div class="text-base font-semibold text-purple-800">Open Form Builder</div>
                      <div class="text-sm text-gray-600">Create and edit forms with drag-and-drop</div>
                    </div>
                  </div>
                  <svg class="w-5 h-5 text-purple-500 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>



      <!-- Enrollment Management and Recent Contacts Side by Side -->
      <div class="mb-8 grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Enrollment Management -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Enrollment Management</h3>
            <div class="space-y-2">
              {recentEnrollments?.map(enrollment => (
                <div class="enrollment-item border border-gray-200 rounded-lg">
                  <button class="enrollment-header w-full flex items-center justify-between p-4 bg-gray-50 hover:bg-gray-100 transition-colors text-left" data-enrollment={enrollment.id}>
                    <div class="flex items-center">
                      <span class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-3">
                        🎓
                      </span>
                      <div>
                        <h4 class="font-semibold text-gray-900">Enrollment #{enrollment.id} - {enrollment.first_name} {enrollment.last_name}</h4>
                        <p class="text-sm text-gray-500">{enrollment.course_id} - {new Date(enrollment.created_at).toLocaleDateString()}</p>
                      </div>
                    </div>
                    <div class="flex items-center space-x-2">
                      <span class={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                        enrollment.status === 'pending' ? 'bg-yellow-100 text-yellow-800' :
                        enrollment.status === 'enrolled' ? 'bg-green-100 text-green-800' :
                        enrollment.status === 'payment_pending' ? 'bg-blue-100 text-blue-800' :
                        'bg-gray-100 text-gray-800'
                      }`}>
                        {enrollment.status}
                      </span>
                      <svg class="enrollment-arrow w-5 h-5 text-gray-400 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </button>

                  <div class="enrollment-content hidden p-4 bg-white border-t border-gray-200">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                      <div>
