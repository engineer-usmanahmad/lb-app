      function attachEnrollmentEventListeners() {
        // Enrollment expandable functionality
        const enrollmentHeaders = document.querySelectorAll('.enrollment-header');
        enrollmentHeaders.forEach(header => {
          header.addEventListener('click', function() {
            const enrollmentItem = this.closest('.enrollment-item');
            const content = enrollmentItem.querySelector('.enrollment-content');
            const arrow = this.querySelector('.enrollment-arrow');

            content.classList.toggle('hidden');
            if (content.classList.contains('hidden')) {
              arrow.style.transform = 'rotate(0deg)';
            } else {
              arrow.style.transform = 'rotate(180deg)';
            }
          });
        });
        
        // Enrollment status update functionality
        const updateEnrollmentStatusButtons = document.querySelectorAll('.update-enrollment-status-btn');
        updateEnrollmentStatusButtons.forEach(button => {
          button.addEventListener('click', function(e) {
            e.stopPropagation();
            const enrollmentId = this.getAttribute('data-id');
            const currentStatus = this.getAttribute('data-status');
            if (!enrollmentId) return alert('Enrollment ID missing.');
            
            // Create modal for status update
            const statusOptions = [
              { value: 'pending', label: 'Pending' },
              { value: 'enrolled', label: 'Enrolled' },
              { value: 'payment_pending', label: 'Payment Pending' },
              { value: 'cancelled', label: 'Cancelled' }
            ];
            
            // Create modal HTML
            const modalHTML = `
              <div id="statusModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
                <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
                  <div class="mt-3">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Update Enrollment Status</h3>
                    <p class="text-sm text-gray-600 mb-4">Current Status: <span class="font-semibold">${currentStatus}</span></p>
                    <div class="mb-4">
                      <label class="block text-sm font-medium text-gray-700 mb-2">Select New Status:</label>
                      <select id="statusSelect" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        ${statusOptions.map(option => 
                          `<option value="${option.value}" ${option.value === currentStatus ? 'selected' : ''}>${option.label}</option>`
                        ).join('')}
                      </select>
                    </div>
                    <div class="flex justify-end space-x-3">
                      <button id="cancelBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">Cancel</button>
                      <button id="updateBtn" class="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600">Update Status</button>
                    </div>
                  </div>
                </div>
              </div>
            `;
            
            // Add modal to page
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            // Handle modal interactions
            const modal = document.getElementById('statusModal');
            const statusSelect = document.getElementById('statusSelect');
            const cancelBtn = document.getElementById('cancelBtn');
            const updateBtn = document.getElementById('updateBtn');
            
            // Close modal function
            const closeModal = () => {
              modal.remove();
            };
            
            // Cancel button
            cancelBtn.addEventListener('click', closeModal);
            
            // Click outside to close
            modal.addEventListener('click', (e) => {
              if (e.target === modal) closeModal();
            });
            
            // Update button
            updateBtn.addEventListener('click', () => {
              const newStatus = statusSelect.value;
              if (newStatus === currentStatus) {
                closeModal();
                return;
              }
              
              // Update status via API (no comments required)
              updateEnrollmentStatus(enrollmentId, newStatus, '', this);
              closeModal();
            });
          });
        });
      }
      
