        // Image insertion functionality
        const insertImageBtn = document.getElementById('insert-image-btn');
        const imageModal = document.getElementById('image-upload-modal');
        const cancelImageBtn = document.getElementById('cancel-image-btn');
        const insertImageConfirmBtn = document.getElementById('insert-image-confirm-btn');
        const imageUrlInput = document.getElementById('image-url-input');
        const imageAltInput = document.getElementById('image-alt-input');
        const imageWidthInput = document.getElementById('image-width-input');
        
        if (insertImageBtn && imageModal) {
          insertImageBtn.addEventListener('click', function() {
            imageModal.classList.remove('hidden');
            imageUrlInput.focus();
          });
        }
        
        if (cancelImageBtn && imageModal) {
          cancelImageBtn.addEventListener('click', function() {
            imageModal.classList.add('hidden');
            clearImageInputs();
          });
        }
        
        if (insertImageConfirmBtn) {
          insertImageConfirmBtn.addEventListener('click', function() {
            const url = imageUrlInput.value.trim();
            const alt = imageAltInput.value.trim();
            const width = imageWidthInput.value.trim();
            
            if (url) {
              let imgHtml = `<img src="${url}" alt="${alt || 'Image'}"`;
              if (width) {
                imgHtml += ` style="width: ${width}px; max-width: 100%;"`;
              } else {
                imgHtml += ` style="max-width: 100%; height: auto;"`;
              }
              imgHtml += ` />`;
              
              editorContent.focus();
              document.execCommand('insertHTML', false, imgHtml);
              imageModal.classList.add('hidden');
              clearImageInputs();
              scheduleAutoSave();
            }
          });
        }
        
        function clearImageInputs() {
          if (imageUrlInput) imageUrlInput.value = '';
          if (imageAltInput) imageAltInput.value = '';
          if (imageWidthInput) imageWidthInput.value = '';
        }
        
        // Close modal on outside click
        if (imageModal) {
          imageModal.addEventListener('click', function(e) {
            if (e.target === imageModal) {
              imageModal.classList.add('hidden');
              clearImageInputs();
            }
          });
        }
        
        // Handle toolbar button clicks
        editorToolbar.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const button = e.target.closest('.editor-btn');
          const select = e.target.closest('.editor-select');
          
          if (button) {
            const command = button.getAttribute('data-command');
            if (command) {
              // Store current selection before executing command
              const selection = window.getSelection();
              const range = selection.rangeCount > 0 ? selection.getRangeAt(0) : null;
              
              executeCommand(command);
            }
          } else if (select) {
            const command = select.getAttribute('data-command');
            const value = select.value;
            if (value) {
              executeCommand(command, value);
              select.value = ''; // Reset select
            }
          }
        });
        
        // Handle select changes
        editorToolbar.addEventListener('change', function(e) {
          const select = e.target.closest('.editor-select');
          if (select) {
            const command = select.getAttribute('data-command');
            const value = select.value;
            if (value) {
              executeCommand(command, value);
              select.value = ''; // Reset select
            }
          }
        });
        
        function executeCommand(command, value = null) {
          // Ensure editor is focused and selection is maintained
          editorContent.focus();
          
          // Small delay to ensure focus is properly set
          setTimeout(() => {
            if (command === 'createLink') {
              const selection = window.getSelection();
              const selectedText = selection.toString();
              const url = prompt('Enter the URL:', 'https://');
              if (url && url !== 'https://') {
                if (selectedText) {
                  document.execCommand(command, false, url);
                } else {
                  const linkText = prompt('Enter link text:', url);
                  if (linkText) {
                    const linkHtml = `<a href="${url}" target="_blank">${linkText}</a>`;
                    document.execCommand('insertHTML', false, linkHtml);
                  }
                }
              }
            } else if (command === 'formatBlock' && value) {
              document.execCommand(command, false, `<${value}>`);
            } else {
              document.execCommand(command, false, value);
            }
            
            // Ensure editor stays focused after command
            editorContent.focus();
            scheduleAutoSave();
          }, 10);
        }
        
        // Color picker handlers (removed duplicate declarations)
        if (textColorPicker) {
          textColorPicker.addEventListener('change', function() {
            editorContent.focus();
            setTimeout(() => {
              document.execCommand('foreColor', false, this.value);
              editorContent.focus();
              scheduleAutoSave();
            }, 10);
          });
        }
        
        if (bgColorPicker) {
          bgColorPicker.addEventListener('change', function() {
            editorContent.focus();
            setTimeout(() => {
              document.execCommand('backColor', false, this.value);
              editorContent.focus();
              scheduleAutoSave();
            }, 10);
          });
        }
         
         // Auto-save on content change
         editorContent.addEventListener('input', scheduleAutoSave);
         
         // Auto-save on title change
        const titleInput = document.getElementById('post-title');
        if (titleInput) {
          titleInput.addEventListener('input', scheduleAutoSave);
        }
        
        // Prevent form submission on Enter in editor
        editorContent.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' && e.ctrlKey) {
            e.preventDefault();
            document.getElementById('create-post-form').dispatchEvent(new Event('submit'));
          }
        });
        
        // Update toolbar button states based on current selection
        editorContent.addEventListener('mouseup', updateToolbarState);
        editorContent.addEventListener('keyup', updateToolbarState);
        
        function updateToolbarState() {
          const commands = ['bold', 'italic', 'underline', 'strikeThrough'];
          commands.forEach(command => {
            const button = editorToolbar.querySelector(`[data-command="${command}"]`);
            if (button) {
              if (document.queryCommandState(command)) {
                button.classList.add('bg-blue-200');
              } else {
                button.classList.remove('bg-blue-200');
              }
            }
          });
          
          // Update alignment buttons
          const alignCommands = ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'];
          alignCommands.forEach(command => {
            const button = editorToolbar.querySelector(`[data-command="${command}"]`);
            if (button) {
              if (document.queryCommandState(command)) {
                button.classList.add('bg-blue-200');
              } else {
                button.classList.remove('bg-blue-200');
              }
            }
          });
        }
        
        // Load draft on initialization
        loadDraft();
        
        // Clear draft on successful form submission (using existing createPostForm reference)
        if (createPostForm) {
          createPostForm.addEventListener('submit', function() {
            setTimeout(clearDraft, 1000); // Clear after successful submission
          });
        }
        
        // Mobile responsiveness - collapse toolbar on small screens
        function handleMobileToolbar() {
          if (window.innerWidth < 768) {
            editorToolbar.classList.add('flex-col', 'items-start');
          } else {
            editorToolbar.classList.remove('flex-col', 'items-start');
          }
        }
        
        window.addEventListener('resize', handleMobileToolbar);
        handleMobileToolbar(); // Initial check
      });
  </script>
</Layout>