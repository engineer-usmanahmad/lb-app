            <input type="url" id="post-featured-image" name="featured_image" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500">
          </div>

          <div>
            <label for="post-content" class="block text-sm font-medium text-gray-700 mb-1">Content</label>
            
            <!-- Rich Text Editor Toolbar -->
            <div id="editor-toolbar" class="border border-gray-300 border-b-0 rounded-t-md bg-gray-50 p-2 flex flex-wrap gap-1">
              <!-- Text Formatting -->
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="bold" title="Bold">
                <strong>B</strong>
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="italic" title="Italic">
                <em>I</em>
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="underline" title="Underline">
                <u>U</u>
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="strikeThrough" title="Strikethrough">
                <s>S</s>
              </button>
              
              <div class="border-l border-gray-300 mx-1"></div>
              
              <!-- Font Family -->
              <select class="editor-select text-sm border border-gray-300 rounded px-2 py-1" data-command="fontName">
                <option value="">Font Family</option>
                <option value="Arial">Arial</option>
                <option value="Helvetica">Helvetica</option>
                <option value="Times New Roman">Times New Roman</option>
                <option value="Georgia">Georgia</option>
                <option value="Verdana">Verdana</option>
                <option value="Courier New">Courier New</option>
                <option value="Impact">Impact</option>
                <option value="Comic Sans MS">Comic Sans MS</option>
              </select>
              
              <!-- Font Size -->
              <select class="editor-select text-sm border border-gray-300 rounded px-2 py-1" data-command="fontSize">
                <option value="">Font Size</option>
                <option value="1">8pt</option>
                <option value="2">10pt</option>
                <option value="3">12pt</option>
                <option value="4">14pt</option>
                <option value="5">18pt</option>
                <option value="6">24pt</option>
                <option value="7">36pt</option>
              </select>
              
              <div class="border-l border-gray-300 mx-1"></div>
              
              <!-- Text Colors -->
              <div class="relative">
                <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" id="text-color-btn" title="Text Color">
                  <span style="color: #000;">A</span>
                </button>
                <input type="color" id="text-color-picker" class="absolute opacity-0 w-full h-full cursor-pointer" value="#000000">
              </div>
              
              <div class="relative">
                <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" id="bg-color-btn" title="Background Color">
                  <span style="background-color: #ffff00; padding: 0 2px;">H</span>
                </button>
                <input type="color" id="bg-color-picker" class="absolute opacity-0 w-full h-full cursor-pointer" value="#ffff00">
              </div>
              
              <div class="border-l border-gray-300 mx-1"></div>
              
              <!-- Headings -->
              <select class="editor-select text-sm border border-gray-300 rounded px-2 py-1" data-command="formatBlock">
                <option value="">Normal</option>
                <option value="h1">Heading 1</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
                <option value="h4">Heading 4</option>
                <option value="h5">Heading 5</option>
                <option value="h6">Heading 6</option>
                <option value="p">Paragraph</option>
                <option value="blockquote">Quote</option>
              </select>
              
              <div class="border-l border-gray-300 mx-1"></div>
              
              <!-- Lists -->
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="insertUnorderedList" title="Bullet List">
                • List
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="insertOrderedList" title="Numbered List">
                1. List
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="outdent" title="Decrease Indent">
                ⬅
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="indent" title="Increase Indent">
                ➡
              </button>
              
              <div class="border-l border-gray-300 mx-1"></div>
              
              <!-- Alignment -->
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="justifyLeft" title="Align Left">
                ⬅
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="justifyCenter" title="Align Center">
                ↔
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="justifyRight" title="Align Right">
                ➡
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="justifyFull" title="Justify">
                ⬌
              </button>
              
              <div class="border-l border-gray-300 mx-1"></div>
              
              <!-- Links and Media -->
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="createLink" title="Insert Link">
                🔗
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="unlink" title="Remove Link">
                🔗❌
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" id="insert-image-btn" title="Insert Image">
                🖼️
              </button>
              
              <div class="border-l border-gray-300 mx-1"></div>
              
              <!-- Utility -->
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="removeFormat" title="Clear Formatting">
                🧹
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="undo" title="Undo">
                ↶
              </button>
              <button type="button" class="editor-btn px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-200" data-command="redo" title="Redo">
                ↷
              </button>
            </div>
            
            <!-- Image Upload Modal -->
            <div id="image-upload-modal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
              <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
                <div class="mt-3">
                  <h3 class="text-lg font-medium text-gray-900 mb-4">Insert Image</h3>
                  <div class="space-y-4">
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-2">Image URL</label>
                      <input type="url" id="image-url-input" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500" placeholder="https://example.com/image.jpg">
                    </div>
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-2">Alt Text</label>
                      <input type="text" id="image-alt-input" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500" placeholder="Image description">
                    </div>
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-2">Width (optional)</label>
                      <input type="number" id="image-width-input" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500" placeholder="300" min="50" max="800">
                    </div>
                    <div class="flex justify-end space-x-2 pt-4">
                      <button type="button" id="cancel-image-btn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">Cancel</button>
                      <button type="button" id="insert-image-confirm-btn" class="px-4 py-2 bg-coral-500 text-white rounded-md hover:bg-coral-600">Insert Image</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Rich Text Editor -->
            <div id="post-content-editor" 
                 contenteditable="true" 
                 class="w-full min-h-48 px-3 py-2 border border-gray-300 border-t-0 rounded-b-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white"
                 style="max-height: 400px; overflow-y: auto;"
                 spellcheck="false">
            </div>
            
            <!-- Hidden textarea for form submission (synced programmatically) -->
            <textarea id="post-content" name="content" class="hidden"></textarea>
          </div>

          <div>
            <label for="post-status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select id="post-status" name="status" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500">
              <option value="draft">Draft</option>
              <option value="published">Published</option>
