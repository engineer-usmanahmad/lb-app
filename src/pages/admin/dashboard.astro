          <div>
            <label for="field-type" class="block text-sm font-medium text-gray-700 mb-1">Field Type</label>
            <select id="field-type" name="field_type" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500">
              <option value="">Select a type</option>
              <option value="short_answer">Short Answer</option>
              <option value="paragraph">Paragraph</option>
              <option value="radio">Multiple Choice (Radio)</option>
              <option value="checkbox">Checkboxes</option>
              <option value="select">Dropdown (Select)</option>
              <option value="rating">Rating (1-5)</option>
              <option value="date">Date</option>
              <option value="time">Time</option>
            </select>
          </div>

          <div>
            <label for="field-required" class="block text-sm font-medium text-gray-700 mb-1">Required</label>
            <input type="checkbox" id="field-required" name="required" class="h-4 w-4 text-coral-500 focus:ring-coral-500 border-gray-300 rounded">
          </div>

          <div id="field-options-container" class="hidden">
            <label for="field-options" class="block text-sm font-medium text-gray-700 mb-1">Options (comma-separated)</label>
            <input type="text" id="field-options" name="options" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500">
            <p class="text-xs text-gray-500 mt-1">e.g., Yes,No or Option 1,Option 2,Option 3</p>
          </div>

          <div class="flex justify-end space-x-3 pt-4">
            <button type="button" id="cancel-field" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-md transition-colors">
              Cancel
            </button>
            <button type="submit" id="submit-field-btn" class="px-4 py-2 text-sm font-medium text-white bg-coral-500 hover:bg-coral-600 rounded-md transition-colors">
              Add Field
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Submissions Modal -->
  <div id="submissions-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-5xl w-full max-h-90vh">
        <!-- Fixed header -->
        <div class="sticky top-0 bg-white z-10">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex justify-between items-center">
            <h3 id="submissions-modal-title" class="text-lg font-medium text-gray-900">Submissions</h3>
            <button id="close-submissions-modal" class="text-gray-400 hover:text-gray-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
        </div>
        <!-- Scrollable content -->
        <div class="overflow-y-auto" style="max-height: calc(90vh - 70px); overflow-x: hidden;">
          <div class="p-6 space-y-4">
            <div class="flex justify-between items-center mb-4">
              <h4 class="text-lg font-medium text-gray-900">Form Submissions</h4>
              <button id="export-csv-btn" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition-colors">
                Export to CSV
              </button>
            </div>
            <div id="submissions-content">
              {/* Submissions will be loaded here */}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Function to load submission counts for all forms
    async function loadAllSubmissionCounts() {
      try {
        const response = await fetch('/api/admin/submissions?count_only=true');
        const result = await response.json();
        
        if (result.success && result.data) {
          // Create a map of form_id to count
          const countMap = {};
          result.data.forEach(item => {
            countMap[item.form_id] = item.count;
          });
          
          // Update all submission count elements
          const countElements = document.querySelectorAll('.submission-count');
          countElements.forEach(element => {
            const formId = element.getAttribute('data-form-id');
            const countValue = element.querySelector('.count-value');
            
            if (formId && countValue) {
              const count = countMap[formId] || 0;
              countValue.textContent = count;
              
              // Apply color based on count
              if (count > 10) {
                element.classList.remove('bg-blue-500');
                element.classList.add('bg-green-500');
              } else if (count > 0) {
                element.classList.remove('bg-blue-500');
                element.classList.add('bg-yellow-500');
              } else {
                element.classList.remove('bg-blue-500');
                element.classList.add('bg-gray-500');
              }
            }
          });
        } else {
          console.error('Failed to load submission counts:', result.error);
        }
      } catch (error) {
        console.error('Error loading submission counts:', error);
      }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
      // Load submission counts for all forms
      loadAllSubmissionCounts();
      
      // Contact expandable functionality
      const contactHeaders = document.querySelectorAll('.contact-header');
      contactHeaders.forEach(header => {
        header.addEventListener('click', function() {
          const contactItem = this.closest('.contact-item');
          const content = contactItem.querySelector('.contact-content');
          const arrow = this.querySelector('.contact-arrow');

          content.classList.toggle('hidden');
          if (content.classList.contains('hidden')) {
            arrow.style.transform = 'rotate(0deg)';
          } else {
            arrow.style.transform = 'rotate(180deg)';
          }
        });
      });
      
      // Contact status update functionality
      const markResolvedButtons = document.querySelectorAll('.mark-resolved-btn');
      markResolvedButtons.forEach(button => {
        button.addEventListener('click', async function(e) {
          e.stopPropagation(); // Prevent triggering the expandable functionality
          const contactId = this.getAttribute('data-id');
          if (!contactId) return alert('Contact ID missing.');
          
          // Prompt for comments
          const comments = prompt('Add resolution comments (optional):');
          if (comments === null) return; // User cancelled
          
          try {
            const requestBody = {
              id: contactId,
              status: 'resolved'
            };
            
            // Add comments if provided
            if (comments && comments.trim()) {
              requestBody.comments = comments.trim();
            }
            
            const contactResponse = await fetch('/api/admin/update-contact-status', {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json'
              },
              credentials: 'include',
              body: JSON.stringify(requestBody)
            });
            
            const contactResult = await contactResponse.json();
            if (contactResponse.ok && contactResult.success) {
              // Update UI to show resolved status
              const contactItem = this.closest('.contact-item');
              const statusBadge = contactItem.querySelector('.contact-header .rounded-full');
              if (statusBadge) {
                statusBadge.textContent = 'resolved';
                statusBadge.classList.remove('bg-yellow-100', 'text-yellow-800', 'bg-red-100', 'text-red-800');
                statusBadge.classList.add('bg-green-100', 'text-green-800');
              }
              
              // Replace button with resolved status
              const buttonContainer = this.parentElement;
              buttonContainer.innerHTML = '<span class="bg-green-100 text-green-800 px-3 py-1 rounded text-sm font-medium">Resolved</span>';
              
              // Add comments display if comments were provided
              if (comments && comments.trim()) {
                const existingComments = contactItem.querySelector('.resolution-comments');
                if (!existingComments) {
                  const commentsDiv = document.createElement('div');
                  commentsDiv.className = 'resolution-comments mt-3 p-3 bg-blue-50 rounded border-l-4 border-blue-500';
                  commentsDiv.innerHTML = `
                    <span class="text-sm font-medium text-blue-700">Resolution Comments:</span>
                    <p class="text-sm text-blue-900 mt-1">${comments.trim()}</p>
                  `;
                  buttonContainer.parentNode.appendChild(commentsDiv);
                }
              }
              alert('Contact marked as resolved!');
            } else {
              alert('Error: ' + (contactResult?.error || 'Unknown error'));
            }
          } catch (error) {
            console.error('Error:', error);
            alert('Error updating contact status. Please try again.');
          }
        });
      });
      
      // View All Enrollments functionality
      const viewAllEnrollmentsBtn = document.getElementById('viewAllEnrollmentsBtn');
      let showingAllEnrollments = false;
      
      viewAllEnrollmentsBtn?.addEventListener('click', async function() {
        if (showingAllEnrollments) {
          // Hide all enrollments and show only recent ones
          location.reload(); // Simple way to reset to original state
          return;
        }
        
        try {
          this.innerHTML = '<svg class="animate-spin w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>Loading...';
          
          const response = await fetch('/api/admin/enrollments', {
            credentials: 'include'
          });
          if (!response.ok) throw new Error('Failed to fetch enrollments');
          
          const result = await response.json();
          const allEnrollments = result.data || [];
          
          // Update the enrollments container - target the Enrollment Management section specifically
          const enrollmentSection = Array.from(document.querySelectorAll('h3')).find(h3 => h3.textContent.includes('Enrollment Management'));
          const enrollmentsContainer = enrollmentSection?.parentElement.querySelector('.space-y-2');
          
          if (!enrollmentsContainer) {
            console.error('Enrollments container not found');
            alert('Error: Could not find enrollments container. Please refresh the page.');
            return;
          }
          
          if (allEnrollments.length === 0) {
            enrollmentsContainer.innerHTML = '<p class="text-gray-500 text-center py-4">No enrollments found.</p>';
          } else {
            enrollmentsContainer.innerHTML = allEnrollments.map(enrollment => `
              <div class="enrollment-item border border-gray-200 rounded-lg">
                <button class="enrollment-header w-full flex items-center justify-between p-4 bg-gray-50 hover:bg-gray-100 transition-colors text-left" data-enrollment="${enrollment.id}">
                  <div class="flex items-center">
                    <span class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-3">
                      🎓
                    </span>
                    <div>
                      <h4 class="font-semibold text-gray-900">Enrollment #${enrollment.id} - ${enrollment.first_name} ${enrollment.last_name}</h4>
                      <p class="text-sm text-gray-500">${enrollment.course_id} - ${new Date(enrollment.created_at).toLocaleDateString()}</p>
                    </div>
                  </div>
                  <div class="flex items-center space-x-2">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                      enrollment.status === 'pending' ? 'bg-yellow-100 text-yellow-800' :
                      enrollment.status === 'enrolled' ? 'bg-green-100 text-green-800' :
                      enrollment.status === 'not_interested' ? 'bg-red-100 text-red-800' :
                      enrollment.status === 'free_training' ? 'bg-blue-100 text-blue-800' :
                      'bg-gray-100 text-gray-800'
                    }">
                      ${enrollment.status.replace('_', ' ')}
                    </span>
                    <svg class="enrollment-arrow w-5 h-5 text-gray-400 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                </button>

                <div class="enrollment-content hidden p-4 bg-white border-t border-gray-200">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <span class="text-sm font-medium text-gray-700">First Name:</span>
                      <span class="text-sm text-gray-900 ml-2">${enrollment.first_name}</span>
                    </div>
                    <div>
                      <span class="text-sm font-medium text-gray-700">Last Name:</span>
                      <span class="text-sm text-gray-900 ml-2">${enrollment.last_name}</span>
                    </div>
                    <div>
                      <span class="text-sm font-medium text-gray-700">Email:</span>
                      <span class="text-sm text-gray-900 ml-2">${enrollment.email}</span>
                    </div>
                    <div>
                      <span class="text-sm font-medium text-gray-700">Phone:</span>
                      <span class="text-sm text-gray-900 ml-2">${enrollment.phone}</span>
                    </div>
                    <div>
                      <span class="text-sm font-medium text-gray-700">Experience Level:</span>
                      <span class="text-sm text-gray-900 ml-2 capitalize">${enrollment.experience_level}</span>
                    </div>
                    <div>
                      <span class="text-sm font-medium text-gray-700">Course Type:</span>
                      <span class="text-sm text-gray-900 ml-2">${enrollment.is_free ? 'Free' : 'Paid'}</span>
                    </div>
                  </div>
                  <div class="mb-4">
                    <span class="text-sm font-medium text-gray-700">Learning Goals:</span>
                    <div class="mt-1 p-3 bg-gray-50 rounded border-l-4 border-green-500">
                      <p class="text-sm text-gray-900">${enrollment.learning_goals}</p>
                    </div>
                  </div>
                  ${enrollment.comments ? `
                    <div class="mb-4">
                      <span class="text-sm font-medium text-gray-700">Comments:</span>
                      <div class="mt-1 p-3 bg-blue-50 rounded border-l-4 border-blue-500">
                        <p class="text-sm text-blue-900">${enrollment.comments}</p>
                      </div>
                    </div>
                  ` : ''}
                  <div class="flex space-x-2">
                    <button class="update-enrollment-status-btn bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm" data-id="${enrollment.id}" data-status="${enrollment.status}">Update Status</button>
                  </div>
                </div>
              </div>
            `).join('');
            
            // Re-attach event listeners for new elements
            attachEnrollmentEventListeners();
          }
          
          showingAllEnrollments = true;
          this.innerHTML = `
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
            </svg>
            Show Recent Only
          `;
          
        } catch (error) {
          console.error('Error loading all enrollments:', error);
          alert('Error loading enrollments. Please try again.');
          this.innerHTML = `
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
            View All Enrollments
          `;
        }
      });
      
      function attachEnrollmentEventListeners() {
        // Enrollment expandable functionality
        const enrollmentHeaders = document.querySelectorAll('.enrollment-header');
        enrollmentHeaders.forEach(header => {
          header.addEventListener('click', function() {
            const enrollmentItem = this.closest('.enrollment-item');
            const content = enrollmentItem.querySelector('.enrollment-content');
            const arrow = this.querySelector('.enrollment-arrow');

            content.classList.toggle('hidden');
            if (content.classList.contains('hidden')) {
              arrow.style.transform = 'rotate(0deg)';
            } else {
              arrow.style.transform = 'rotate(180deg)';
            }
          });
        });
        
        // Enrollment status update functionality
        const updateEnrollmentStatusButtons = document.querySelectorAll('.update-enrollment-status-btn');
        updateEnrollmentStatusButtons.forEach(button => {
          button.addEventListener('click', function(e) {
            e.stopPropagation();
            const enrollmentId = this.getAttribute('data-id');
            const currentStatus = this.getAttribute('data-status');
            if (!enrollmentId) return alert('Enrollment ID missing.');
            
            // Create modal for status update
            const statusOptions = [
              { value: 'pending', label: 'Pending' },
              { value: 'enrolled', label: 'Enrolled' },
              { value: 'payment_pending', label: 'Payment Pending' },
              { value: 'cancelled', label: 'Cancelled' }
            ];
            
            // Create modal HTML
            const modalHTML = `
              <div id="statusModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
                <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
                  <div class="mt-3">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Update Enrollment Status</h3>
                    <p class="text-sm text-gray-600 mb-4">Current Status: <span class="font-semibold">${currentStatus}</span></p>
                    <div class="mb-4">
                      <label class="block text-sm font-medium text-gray-700 mb-2">Select New Status:</label>
                      <select id="statusSelect" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        ${statusOptions.map(option => 
                          `<option value="${option.value}" ${option.value === currentStatus ? 'selected' : ''}>${option.label}</option>`
                        ).join('')}
                      </select>
                    </div>
                    <div class="flex justify-end space-x-3">
                      <button id="cancelBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">Cancel</button>
                      <button id="updateBtn" class="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600">Update Status</button>
                    </div>
                  </div>
                </div>
              </div>
            `;
            
            // Add modal to page
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            // Handle modal interactions
            const modal = document.getElementById('statusModal');
            const statusSelect = document.getElementById('statusSelect');
            const cancelBtn = document.getElementById('cancelBtn');
            const updateBtn = document.getElementById('updateBtn');
            
            // Close modal function
            const closeModal = () => {
              modal.remove();
            };
            
            // Cancel button
            cancelBtn.addEventListener('click', closeModal);
            
            // Click outside to close
            modal.addEventListener('click', (e) => {
              if (e.target === modal) closeModal();
            });
            
            // Update button
            updateBtn.addEventListener('click', () => {
              const newStatus = statusSelect.value;
              if (newStatus === currentStatus) {
                closeModal();
                return;
              }
              
              // Update status via API (no comments required)
              updateEnrollmentStatus(enrollmentId, newStatus, '', this);
              closeModal();
            });
          });
        });
      }
      
      // Initial attachment of event listeners
      attachEnrollmentEventListeners();
      
      // Function to load all submission counts for forms
      async function loadAllSubmissionCounts() {
        console.log('Loading all submission counts...');
        const submissionCountElements = document.querySelectorAll('.submission-count');
        console.log(`Found ${submissionCountElements.length} submission count elements`);
        
        // First attempt - load all counts
        const loadPromises = [];
        
        for (const element of submissionCountElements) {
          const formId = element.getAttribute('data-form-id');
          if (!formId) {
            console.warn('Found submission count element without form ID');
            continue;
          }
          
          console.log(`Loading count for form ${formId}`);
          
          const loadPromise = (async () => {
            try {
              const response = await fetch(`/api/admin/form-submissions-count?formId=${encodeURIComponent(formId)}`);
              const result = await response.json();
              
              if (response.ok && result.success) {
                const countElement = element.querySelector('.count-value');
                if (countElement) {
                  countElement.textContent = result.count || '0';
                  console.log(`Updated count for form ${formId}: ${result.count || '0'}`);
                } else {
                  console.warn(`Count element not found for form ${formId}`);
                }
              } else {
                console.error(`Failed to load submission count for form ${formId}:`, result?.error || 'Unknown error');
              }
            } catch (error) {
              console.error(`Error loading submission count for form ${formId}:`, error);
            }
          })();
          
          loadPromises.push(loadPromise);
        }
        
        // Wait for all initial loads to complete
        await Promise.all(loadPromises);
        
        // Second attempt - retry for any counts that didn't load
        console.log('First attempt complete, checking for any missing counts...');
        setTimeout(() => {
          const pendingCounts = document.querySelectorAll('.count-value');
          console.log(`Checking ${pendingCounts.length} count elements for missing values`);
          
          for (const element of pendingCounts) {
            if (element.textContent === '...' || element.textContent === '') {
              const formElement = element.closest('.submission-count');
              if (formElement) {
                const formId = formElement.getAttribute('data-form-id');
                if (formId) {
                  console.log(`Retrying count for form ${formId}`);
                  fetch(`/api/admin/form-submissions-count?formId=${encodeURIComponent(formId)}`, {
                    // Add cache-busting parameter
                    headers: {
                      'Cache-Control': 'no-cache',
                      'Pragma': 'no-cache'
                    }
                  })
                    .then(response => response.json())
                    .then(result => {
                      if (result.success) {
                        element.textContent = result.count || '0';
                        console.log(`Retry successful for form ${formId}: ${result.count || '0'}`);
                      } else {
                        console.error(`Retry failed for form ${formId}:`, result?.error || 'Unknown error');
                      }
                    })
                    .catch(error => console.error(`Error in retry for form ${formId}:`, error));
                }
              }
            }
          }
          
          // Third attempt after a longer delay
          setTimeout(() => {
            console.log('Final attempt to load any remaining missing counts...');
            const stillPendingCounts = document.querySelectorAll('.count-value');
            
            for (const element of stillPendingCounts) {
              if (element.textContent === '...' || element.textContent === '') {
                const formElement = element.closest('.submission-count');
                if (formElement) {
                  const formId = formElement.getAttribute('data-form-id');
                  if (formId) {
                    console.log(`Final retry for form ${formId}`);
                    // Force a value of 0 if we still can't load it
                    element.textContent = '0';
                    
                    // Still try to load the actual value
                    fetch(`/api/admin/form-submissions-count?formId=${encodeURIComponent(formId)}?nocache=${Date.now()}`)
                      .then(response => response.json())
                      .then(result => {
                        if (result.success) {
                          element.textContent = result.count || '0';
                          console.log(`Final retry successful for form ${formId}: ${result.count || '0'}`);
                        }
                      })
                      .catch(error => console.error(`Error in final retry for form ${formId}:`, error));
                  }
                }
              }
            }
          }, 2000);
        }, 1000);
      }
      
      // Load submission counts when page loads
      loadAllSubmissionCounts();
      
      // Function to update enrollment status
      async function updateEnrollmentStatus(id, status, comments, buttonElement) {
        try {
          const enrollmentResponse = await fetch('/api/admin/update-enrollment-status', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json'
            },
            credentials: 'include',
            body: JSON.stringify({
              enrollment_id: id,
              status: status,
              comments: comments
            })
          });
          
          const enrollmentResult = await enrollmentResponse.json();
          if (enrollmentResponse.ok && enrollmentResult.success) {
            // Update UI to show new status
            const enrollmentItem = buttonElement.closest('.enrollment-item');
            const statusBadge = enrollmentItem.querySelector('.enrollment-header .rounded-full');
            if (statusBadge) {
              statusBadge.textContent = status;
              
              // Remove all existing status classes
              statusBadge.classList.remove(
                'bg-yellow-100', 'text-yellow-800',
                'bg-green-100', 'text-green-800',
                'bg-blue-100', 'text-blue-800',
                'bg-red-100', 'text-red-800',
                'bg-gray-100', 'text-gray-800'
              );
              
              // Add appropriate status classes
              if (status === 'pending') {
                statusBadge.classList.add('bg-yellow-100', 'text-yellow-800');
              } else if (status === 'enrolled') {
                statusBadge.classList.add('bg-green-100', 'text-green-800');
              } else if (status === 'payment_pending') {
                statusBadge.classList.add('bg-blue-100', 'text-blue-800');
              } else if (status === 'cancelled') {
                statusBadge.classList.add('bg-red-100', 'text-red-800');
              } else {
                statusBadge.classList.add('bg-gray-100', 'text-gray-800');
              }
            }
            
            // Update the button's data-status attribute
            buttonElement.setAttribute('data-status', status);
            
            alert(`Enrollment status updated to: ${status}`);
          } else {
            alert('Error: ' + (enrollmentResult?.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error updating enrollment status. Please try again.');
        }
      }

      // Blog post management
      console.log('Setting up blog post management...');
      const createPostBtn = document.getElementById('create-post-btn');
      const createPostModal = document.getElementById('create-post-modal');
