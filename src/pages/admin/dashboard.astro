            <button type="submit" id="submit-post-btn" class="px-4 py-2 text-sm font-medium text-white bg-coral-500 hover:bg-coral-600 rounded-md transition-colors">
              Create Post
            </button>
          </div>
        </form>
      </div>
    </div>
