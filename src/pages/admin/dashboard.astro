---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

// Fetch dashboard data
const { data: contactStats } = await supabase
  .from('contact_submissions')
  .select('status')
  .order('created_at', { ascending: false });

const { data: enrollmentStats } = await supabase
  .from('enrollment_submissions')
  .select('status, course_id')
  .order('created_at', { ascending: false });

const { data: recentContacts } = await supabase
  .from('contact_submissions')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

const { data: recentEnrollments } = await supabase
  .from('enrollment_submissions')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

const { data: recentPosts } = await supabase
  .from('blog_posts')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

const { data: blogStats } = await supabase
  .from('blog_posts')
  .select('status')
  .order('created_at', { ascending: false });

// Fetch forms data
const { data: forms } = await supabase
  .from('forms')
  .select('*')
  .order('created_at', { ascending: false });

// Calculate stats
const totalContacts = contactStats?.length || 0;
const newContacts = contactStats?.filter(c => c.status === 'new').length || 0;
const totalEnrollments = enrollmentStats?.length || 0;
const pendingEnrollments = enrollmentStats?.filter(e => e.status === 'pending').length || 0;

// Course enrollment stats
const courseEnrollments = enrollmentStats?.reduce((acc, curr) => {
  acc[curr.course_id] = (acc[curr.course_id] || 0) + 1;
  return acc;
}, {} as Record<string, number>) || {};

// Blog stats
const totalPosts = blogStats?.length || 0;
const publishedPosts = blogStats?.filter(p => p.status === 'published').length || 0;
const draftPosts = blogStats?.filter(p => p.status === 'draft').length || 0;
---

<Layout title="Admin Dashboard - LbisTech">
  <Header />
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
            <p class="text-gray-600">Manage contacts, enrollments, and forms</p>
          </div>
          <div class="flex items-center space-x-4">
            <span class="text-sm text-gray-500">Last updated: {new Date().toLocaleString()}</span>
            <a href="/" class="text-coral-500 hover:text-coral-600">← Back to Site</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 mb-8">
        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Total Contacts</dt>
                  <dd class="text-lg font-medium text-gray-900">{totalContacts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-coral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM9 17H4l5 5v-5zM15 7h5l-5-5v5zM9 7H4L9 2v5z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">New Contacts</dt>
                  <dd class="text-lg font-medium text-coral-500">{newContacts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Total Enrollments</dt>
                  <dd class="text-lg font-medium text-gray-900">{totalEnrollments}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Pending Enrollments</dt>
                  <dd class="text-lg font-medium text-yellow-600">{pendingEnrollments}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Total Blog Posts</dt>
                  <dd class="text-lg font-medium text-gray-900">{totalPosts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">Published Posts</dt>
                  <dd class="text-lg font-medium text-green-600">{publishedPosts}</dd>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Blog Management -->
      <div class="mb-8">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg leading-6 font-medium text-gray-900">Blog Management</h3>
              <button id="create-post-btn" class="bg-coral-500 hover:bg-coral-600 text-white px-4 py-2 rounded-lg transition-colors">
                Create New Post
              </button>
            </div>
            <div class="space-y-2">
              {recentPosts?.map(post => (
                <div class="post-item border border-gray-200 rounded-lg">
                  <div class="flex items-center justify-between p-4 bg-gray-50">
                    <div class="flex items-center">
                      <span class="w-8 h-8 bg-purple-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-3">
                        📝
                      </span>
                      <div>
                        <h4 class="font-semibold text-gray-900">{post.title}</h4>
                        <p class="text-sm text-gray-500">
                          {new Date(post.created_at).toLocaleDateString()} -
                          <span class={`ml-1 ${post.status === 'published' ? 'text-green-600' : 'text-yellow-600'}`}>
                            {post.status}
                          </span>
                        </p>
                      </div>
                    </div>
                    <div class="flex space-x-3">
                      <button class="edit-post-btn text-coral-500 hover:text-coral-600 text-sm font-medium" data-post={JSON.stringify(post)}>Edit</button>
                      {post.status === 'published' && (
                        <a href={`/blog/${post.slug}`} target="_blank" class="text-blue-500 hover:text-blue-600 text-sm font-medium">View</a>
                      )}
                      <button
                        class="delete-post-btn text-red-600 hover:text-red-700 text-sm font-medium"
                        data-id={post.id}
                        data-title={post.title}
                      >
                        Delete
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Form Management -->
      <div class="mb-8">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg leading-6 font-medium text-gray-900">Form Management</h3>
              <button id="create-form-btn" class="bg-coral-500 hover:bg-coral-600 text-white px-4 py-2 rounded-lg transition-colors">
                Create New Form
              </button>
            </div>
            <div class="space-y-2">
              {forms?.map(form => (
                <div class="form-item border border-gray-200 rounded-lg">
                  <div class="flex items-center justify-between p-4 bg-gray-50">
                    <div class="flex items-center">
                      <span class="w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-3">
                        📄
                      </span>
                      <div>
                        <h4 class="font-semibold text-gray-900">{form.name}</h4>
                        <p class="text-sm text-gray-500">
                          {form.description || 'No description'} -
                          <span class={`ml-1 ${form.is_active ? 'text-green-600' : 'text-red-600'}`}>
                            {form.is_active ? 'Active' : 'Inactive'}
                          </span>
                        </p>
                      </div>
                    </div>
                    <div class="flex space-x-3">
                      <button class="edit-form-btn text-coral-500 hover:text-coral-600 text-sm font-medium" data-form={JSON.stringify(form)}>Edit</button>
                      <button class="manage-fields-btn text-purple-500 hover:text-purple-600 text-sm font-medium" data-form-id={form.id} data-form-name={form.name}>Fields</button>
                      <button class="view-submissions-btn text-green-500 hover:text-green-600 text-sm font-medium" data-form-id={form.id} data-form-name={form.name}>Submissions</button>
                      <button class="copy-link-btn text-blue-500 hover:text-blue-600 text-sm font-medium" data-slug={form.slug}>Copy Link</button>
                      <button class="whatsapp-share-btn text-green-500 hover:text-green-600 text-sm font-medium" data-slug={form.slug} data-name={form.name}>Share</button>
                      <button
                        class="delete-form-btn text-red-600 hover:text-red-700 text-sm font-medium"
                        data-id={form.id}
                        data-name={form.name}
                      >
                        Delete
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Recent Contacts -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Recent Contacts</h3>
            <div class="space-y-2">
              {recentContacts?.map(contact => (
                <div class="contact-item border border-gray-200 rounded-lg">
                  <button class="contact-header w-full flex items-center justify-between p-4 bg-gray-50 hover:bg-gray-100 transition-colors text-left" data-contact={contact.id}>
                    <div class="flex items-center">
                      <span class="w-8 h-8 bg-coral-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-3">
                        📧
                      </span>
                      <div>
                        <h4 class="font-semibold text-gray-900">Contact #{contact.id} - {contact.first_name} {contact.last_name}</h4>
                        <p class="text-sm text-gray-500">{new Date(contact.created_at).toLocaleDateString()}</p>
                      </div>
                    </div>
                    <div class="flex items-center space-x-2">
                      <span class={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                        contact.status === 'new' ? 'bg-red-100 text-red-800' :
                        contact.status === 'in_progress' ? 'bg-yellow-100 text-yellow-800' :
                        contact.status === 'resolved' ? 'bg-green-100 text-green-800' :
                        'bg-gray-100 text-gray-800'
                      }`}>
                        {contact.status}
                      </span>
                      <svg class="contact-arrow w-5 h-5 text-gray-400 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </button>

                  <div class="contact-content hidden p-4 bg-white border-t border-gray-200">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                      <div>
                        <span class="text-sm font-medium text-gray-700">Full Name:</span>
                        <span class="text-sm text-gray-900 ml-2">{contact.first_name} {contact.last_name}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Email:</span>
                        <span class="text-sm text-gray-900 ml-2">{contact.email}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Phone:</span>
                        <span class="text-sm text-gray-900 ml-2">{contact.phone}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Course Interest:</span>
                        <span class="text-sm text-gray-900 ml-2">{contact.course_interest}</span>
                      </div>
                    </div>
                    <div class="mb-4">
                      <span class="text-sm font-medium text-gray-700">Message:</span>
                      <div class="mt-1 p-3 bg-gray-50 rounded border-l-4 border-coral-500">
                        <p class="text-sm text-gray-900">{contact.message}</p>
                      </div>
                    </div>
                    <div class="flex space-x-2">
                      <button class="bg-coral-500 hover:bg-coral-600 text-white px-3 py-1 rounded text-sm">Reply</button>
                      <button class="mark-resolved-btn bg-gray-500 hover:bg-gray-600 text-white px-3 py-1 rounded text-sm" data-id="{contact.id}">Mark Resolved</button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Recent Enrollments -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Recent Enrollments</h3>
            <div class="space-y-2">
              {recentEnrollments?.map(enrollment => (
                <div class="enrollment-item border border-gray-200 rounded-lg">
                  <button class="enrollment-header w-full flex items-center justify-between p-4 bg-gray-50 hover:bg-gray-100 transition-colors text-left" data-enrollment={enrollment.id}>
                    <div class="flex items-center">
                      <span class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-3">
                        🎓
                      </span>
                      <div>
                        <h4 class="font-semibold text-gray-900">Enrollment #{enrollment.id} - {enrollment.first_name} {enrollment.last_name}</h4>
                        <p class="text-sm text-gray-500">{enrollment.course_id} - {new Date(enrollment.created_at).toLocaleDateString()}</p>
                      </div>
                    </div>
                    <div class="flex items-center space-x-2">
                      <span class={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${
                        enrollment.status === 'pending' ? 'bg-yellow-100 text-yellow-800' :
                        enrollment.status === 'enrolled' ? 'bg-green-100 text-green-800' :
                        enrollment.status === 'payment_pending' ? 'bg-blue-100 text-blue-800' :
                        'bg-gray-100 text-gray-800'
                      }`}>
                        {enrollment.status}
                      </span>
                      <svg class="enrollment-arrow w-5 h-5 text-gray-400 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </button>

                  <div class="enrollment-content hidden p-4 bg-white border-t border-gray-200">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                      <div>
                        <span class="text-sm font-medium text-gray-700">First Name:</span>
                        <span class="text-sm text-gray-900 ml-2">{enrollment.first_name}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Last Name:</span>
                        <span class="text-sm text-gray-900 ml-2">{enrollment.last_name}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Email:</span>
                        <span class="text-sm text-gray-900 ml-2">{enrollment.email}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Phone:</span>
                        <span class="text-sm text-gray-900 ml-2">{enrollment.phone}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Course:</span>
                        <span class="text-sm text-gray-900 ml-2">{enrollment.course_id}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Experience Level:</span>
                        <span class="text-sm text-gray-900 ml-2 capitalize">{enrollment.experience_level}</span>
                      </div>
                      <div>
                        <span class="text-sm font-medium text-gray-700">Course Type:</span>
                        <span class="text-sm text-gray-900 ml-2">{enrollment.is_free ? 'Free' : 'Paid'}</span>
                      </div>
                    </div>
                    <div class="mb-4">
                      <span class="text-sm font-medium text-gray-700">Learning Goals:</span>
                      <div class="mt-1 p-3 bg-gray-50 rounded border-l-4 border-green-500">
                        <p class="text-sm text-gray-900">{enrollment.learning_goals}</p>
                      </div>
                    </div>
                    <div class="flex space-x-2">
                      <button class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm">Send Course Details</button>
                      <button class="update-enrollment-status-btn bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm" data-id="{enrollment.id}" data-status="{enrollment.status}">Update Status</button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Course Enrollment Stats -->
      <div class="mt-8 bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Course Enrollment Statistics</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {Object.entries(courseEnrollments).map(([courseId, count]) => (
              <div class="p-4 bg-gray-50 rounded-lg">
                <p class="text-sm font-medium text-gray-900 capitalize">{courseId.replace('-', ' ')}</p>
                <p class="text-2xl font-bold text-coral-500">{count}</p>
                <p class="text-xs text-gray-500">Total Enrollments</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Blog Post Creation Modal -->
  <div id="create-post-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-90vh overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex justify-between items-center">
            <h3 class="text-lg font-medium text-gray-900">Create New Blog Post</h3>
            <button id="close-modal" class="text-gray-400 hover:text-gray-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <form id="create-post-form" class="p-6 space-y-4">
          <div>
            <label for="post-title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
            <input type="text" id="post-title" name="title" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500">
          </div>

          <div>
            <label for="post-slug" class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
            <input type="text" id="post-slug" name="slug" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500">
            <p class="text-xs text-gray-500 mt-1">URL-friendly version (auto-generated from title)</p>
          </div>

          <div>
            <label for="post-excerpt" class="block text-sm font-medium text-gray-700 mb-1">Excerpt (Optional)</label>
            <textarea id="post-excerpt" name="excerpt" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500"></textarea>
          </div>

          <div>
            <label for="post-featured-image" class="block text-sm font-medium text-gray-700 mb-1">Featured Image URL (Optional)</label>
            <input type="url" id="post-featured-image" name="featured_image" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500">
          </div>

          <div>
            <label for="post-content" class="block text-sm font-medium text-gray-700 mb-1">Content</label>
            <textarea id="post-content" name="content" rows="8" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500"></textarea>
          </div>

          <div>
