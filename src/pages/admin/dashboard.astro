  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Contact expandable functionality
      const contactHeaders = document.querySelectorAll('.contact-header');
      contactHeaders.forEach(header => {
        header.addEventListener('click', function() {
          const contactItem = this.closest('.contact-item');
          const content = contactItem.querySelector('.contact-content');
          const arrow = this.querySelector('.contact-arrow');

          content.classList.toggle('hidden');
          if (content.classList.contains('hidden')) {
            arrow.style.transform = 'rotate(0deg)';
          } else {
            arrow.style.transform = 'rotate(180deg)';
          }
        });
      });
      
      // Contact status update functionality
      const markResolvedButtons = document.querySelectorAll('.mark-resolved-btn');
      markResolvedButtons.forEach(button => {
        button.addEventListener('click', async function(e) {
          e.stopPropagation(); // Prevent triggering the expandable functionality
          const contactId = this.getAttribute('data-id');
          if (!contactId) return alert('Contact ID missing.');
          
          try {
            const contactResponse = await fetch('/api/admin/update-contact-status', {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                id: contactId,
                status: 'resolved'
              })
            });
            
            const contactResult = await contactResponse.json();
            if (contactResponse.ok && contactResult.success) {
              // Update UI to show resolved status
              const contactItem = this.closest('.contact-item');
              const statusBadge = contactItem.querySelector('.status-badge');
              if (statusBadge) {
                statusBadge.textContent = 'Resolved';
                statusBadge.classList.remove('bg-yellow-100', 'text-yellow-800', 'bg-blue-100', 'text-blue-800');
                statusBadge.classList.add('bg-green-100', 'text-green-800');
              }
              this.disabled = true;
              this.classList.add('opacity-50', 'cursor-not-allowed');
              alert('Contact marked as resolved!');
            } else {
              alert('Error: ' + (contactResult?.error || 'Unknown error'));
            }
          } catch (error) {
            console.error('Error:', error);
            alert('Error updating contact status. Please try again.');
          }
        });
      });

      // Enrollment expandable functionality
      const enrollmentHeaders = document.querySelectorAll('.enrollment-header');
      enrollmentHeaders.forEach(header => {
        header.addEventListener('click', function() {
          const enrollmentItem = this.closest('.enrollment-item');
          const content = enrollmentItem.querySelector('.enrollment-content');
          const arrow = this.querySelector('.enrollment-arrow');

          content.classList.toggle('hidden');
          if (content.classList.contains('hidden')) {
            arrow.style.transform = 'rotate(0deg)';
          } else {
            arrow.style.transform = 'rotate(180deg)';
          }
        });
      });
      
      // Enrollment status update functionality
      const updateEnrollmentStatusButtons = document.querySelectorAll('.update-enrollment-status-btn');
      updateEnrollmentStatusButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.stopPropagation(); // Prevent triggering the expandable functionality
          const enrollmentId = this.getAttribute('data-id');
          const currentStatus = this.getAttribute('data-status');
          if (!enrollmentId) return alert('Enrollment ID missing.');
          
          // Create status options based on current status
          const statusOptions = ['pending', 'approved', 'rejected', 'completed'];
          
          // Create a simple dropdown for status selection
          const newStatus = prompt(
            `Current status: ${currentStatus}\nSelect new status:\n- pending\n- approved\n- rejected\n- completed`, 
            currentStatus
          );
          
          // Validate selection
          if (!newStatus || !statusOptions.includes(newStatus) || newStatus === currentStatus) {
            return; // User cancelled or invalid selection
          }
          
          // Update status via API
          updateEnrollmentStatus(enrollmentId, newStatus, this);
        });
      });
      
      // Function to update enrollment status
      async function updateEnrollmentStatus(id, status, buttonElement) {
        try {
          const enrollmentResponse = await fetch('/api/admin/update-enrollment-status', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: id,
              status: status
            })
          });
          
          const enrollmentResult = await enrollmentResponse.json();
          if (enrollmentResponse.ok && enrollmentResult.success) {
            // Update UI to show new status
            const enrollmentItem = buttonElement.closest('.enrollment-item');
            const statusBadge = enrollmentItem.querySelector('.enrollment-header .rounded-full');
            if (statusBadge) {
              statusBadge.textContent = status;
              
              // Remove all existing status classes
              statusBadge.classList.remove(
                'bg-yellow-100', 'text-yellow-800',
                'bg-green-100', 'text-green-800',
                'bg-blue-100', 'text-blue-800',
                'bg-gray-100', 'text-gray-800'
              );
              
              // Add appropriate status classes
              if (status === 'pending') {
                statusBadge.classList.add('bg-yellow-100', 'text-yellow-800');
              } else if (status === 'approved') {
                statusBadge.classList.add('bg-green-100', 'text-green-800');
              } else if (status === 'rejected') {
                statusBadge.classList.add('bg-red-100', 'text-red-800');
              } else if (status === 'completed') {
                statusBadge.classList.add('bg-blue-100', 'text-blue-800');
              } else {
                statusBadge.classList.add('bg-gray-100', 'text-gray-800');
              }
            }
            
            // Update the button's data-status attribute
            buttonElement.setAttribute('data-status', status);
            
            alert(`Enrollment status updated to: ${status}`);
          } else {
            alert('Error: ' + (enrollmentResult?.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error updating enrollment status. Please try again.');
        }
      }

      // Blog post management
      const createPostBtn = document.getElementById('create-post-btn');
      const createPostModal = document.getElementById('create-post-modal');
      const closeModal = document.getElementById('close-modal');
      const cancelPost = document.getElementById('cancel-post');
      const createPostForm = document.getElementById('create-post-form');
      const postTitle = document.getElementById('post-title');
      const postSlug = document.getElementById('post-slug');
      
      // Edit post buttons
      document.querySelectorAll('.edit-post-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          try {
            const post = JSON.parse(this.getAttribute('data-post'));
            document.getElementById('post-modal-title').textContent = 'Edit Post';
            document.getElementById('submit-post-btn').textContent = 'Update Post';
            document.getElementById('post-id').value = post.id;
            document.getElementById('post-title').value = post.title;
            document.getElementById('post-slug').value = post.slug;
            document.getElementById('post-content').value = post.content || '';
            document.getElementById('post-status').value = post.status || 'draft';
            createPostModal?.classList.remove('hidden');
          } catch (error) {
            console.error('Error parsing post data:', error);
            alert('Error editing post. Please try again.');
          }
        });
      });

      // Auto-generate slug from title
      postTitle?.addEventListener('input', function() {
        const slug = this.value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');
        if (postSlug) postSlug.value = slug;
      });

      // Modal controls
      createPostBtn?.addEventListener('click', function() {
        createPostModal?.classList.remove('hidden');
      });
      closeModal?.addEventListener('click', function() {
        createPostModal?.classList.add('hidden');
      });
      cancelPost?.addEventListener('click', function() {
        createPostModal?.classList.add('hidden');
      });
      createPostModal?.addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
      });

      // Handle create form submission
      createPostForm?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        // TODO: replace with actual admin ID from your session/auth
        formData.append('author_id', '00000000-0000-0000-0000-000000000000');
        try {
          const response = await fetch('/api/admin/blog', { method: 'POST', body: formData });
          const result = await response.json();
          if (response.ok && result.success) {
            alert('Blog post created successfully!');
            createPostModal?.classList.add('hidden');
            location.reload();
          } else {
            alert('Error creating post: ' + (result?.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error creating post. Please try again.');
        }
      });

      // --- DELETE POST HANDLER ---
      const deleteButtons = document.querySelectorAll('.delete-post-btn');
      deleteButtons.forEach(btn => {
        btn.addEventListener('click', async function () {
          const id = this.getAttribute('data-id');
          const title = this.getAttribute('data-title') || 'this post';
          if (!id) return alert('Post ID missing.');

          const ok = confirm(`Are you sure you want to delete “${title}”? This action cannot be undone.`);
          if (!ok) return;

          try {
            const res = await fetch(`/api/admin/blog?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
            const result = await res.json();
            if (!res.ok) {
              console.error('Delete failed:', result);
              return alert(`Failed to delete: ${result?.error || 'Unknown error'}`);
            }
            const postItem = this.closest('.post-item');
            if (postItem) postItem.remove();
            alert('Post deleted successfully.');
            // Optionally refresh counters:
            // location.reload();
          } catch (err) {
            console.error('Delete error:', err);
            alert('Error deleting post. Please try again.');
          }
        });
      });

      // --- FORM MANAGEMENT ---
      let currentFormId = null;
      let currentFormSlug = null;

      // Form creation/edit modals
      const createFormBtn = document.getElementById('create-form-btn');
      const createFormModal = document.getElementById('create-form-modal');
      const closeFormModal = document.getElementById('close-form-modal');
      const cancelForm = document.getElementById('cancel-form');
      const formForm = document.getElementById('form-form');
      const formName = document.getElementById('form-name');
      const formSlug = document.getElementById('form-slug');

      // Auto-generate slug from name
      formName?.addEventListener('input', function() {
        const slug = this.value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');
        if (formSlug) formSlug.value = slug;
      });

      // Modal controls
      createFormBtn?.addEventListener('click', function() {
        document.getElementById('form-modal-title').textContent = 'Create New Form';
        document.getElementById('submit-form-btn').textContent = 'Create Form';
        formForm?.reset();
        document.getElementById('form-id').value = '';
        document.getElementById('form-success-actions').classList.add('hidden');
        createFormModal?.classList.remove('hidden');
      });

      [closeFormModal, cancelForm].forEach(btn => {
        btn?.addEventListener('click', function() {
          createFormModal?.classList.add('hidden');
        });
      });

      createFormModal?.addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
      });

      // Handle form submission
      formForm?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const isEdit = !!formData.get('id');
        const method = isEdit ? 'PUT' : 'POST';

        try {
          const response = await fetch('/api/admin/forms', { method, body: formData });
          const result = await response.json();

          if (response.ok && result.success) {
            alert(`Form ${isEdit ? 'updated' : 'created'} successfully!`);
            if (!isEdit) {
              currentFormSlug = result.data.slug;
              document.getElementById('form-success-actions').classList.remove('hidden');
            } else {
              createFormModal?.classList.add('hidden');
              location.reload();
            }
          } else {
            alert('Error: ' + (result?.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error saving form. Please try again.');
        }
      });

      // Success actions
      document.getElementById('copy-new-form-link')?.addEventListener('click', function() {
        copyFormLink(currentFormSlug);
      });

      document.getElementById('whatsapp-new-form')?.addEventListener('click', function() {
        shareOnWhatsApp(currentFormSlug, formName.value);
      });

      document.getElementById('manage-new-form-fields')?.addEventListener('click', function() {
        createFormModal?.classList.add('hidden');
        // Find the form in the data and open fields modal
        location.reload(); // Simple approach for now
      });

      // Edit form buttons
      document.querySelectorAll('.edit-form-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const form = JSON.parse(this.getAttribute('data-form'));
          document.getElementById('form-modal-title').textContent = 'Edit Form';
          document.getElementById('submit-form-btn').textContent = 'Update Form';
          document.getElementById('form-id').value = form.id;
          document.getElementById('form-name').value = form.name;
          document.getElementById('form-slug').value = form.slug;
          document.getElementById('form-description').value = form.description || '';
          document.getElementById('form-is-active').checked = form.is_active;
          document.getElementById('form-success-actions').classList.add('hidden');
          createFormModal?.classList.remove('hidden');
        });
      });

      // Copy link buttons
      document.querySelectorAll('.copy-link-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const slug = this.getAttribute('data-slug');
          copyFormLink(slug);
        });
      });

      // WhatsApp share buttons
      document.querySelectorAll('.whatsapp-share-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const slug = this.getAttribute('data-slug');
          const name = this.getAttribute('data-name');
          shareOnWhatsApp(slug, name);
        });
      });

      // Delete form buttons
      document.querySelectorAll('.delete-form-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
          const id = this.getAttribute('data-id');
          const name = this.getAttribute('data-name');

          const ok = confirm(`Are you sure you want to delete form "${name}"? This will also delete all submissions. This action cannot be undone.`);
          if (!ok) return;

          try {
            const res = await fetch(`/api/admin/forms?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
            const result = await res.json();
            if (!res.ok) {
              return alert(`Failed to delete: ${result?.error || 'Unknown error'}`);
            }
            const formItem = this.closest('.form-item');
            if (formItem) formItem.remove();
            alert('Form deleted successfully.');
          } catch (err) {
            console.error('Delete error:', err);
            alert('Error deleting form. Please try again.');
          }
        });
      });

      // --- FIELDS MANAGEMENT ---
      const fieldsModal = document.getElementById('fields-modal');
      const closeFieldsModal = document.getElementById('close-fields-modal');
      const addFieldBtn = document.getElementById('add-field-btn');
      const fieldModal = document.getElementById('field-modal');
      const closeFieldModal = document.getElementById('close-field-modal');
      const cancelField = document.getElementById('cancel-field');
      const fieldForm = document.getElementById('field-form');
      const fieldLabel = document.getElementById('field-label');
      const fieldName = document.getElementById('field-name');
      const fieldType = document.getElementById('field-type');
      const fieldOptionsContainer = document.getElementById('field-options-container');

      // Auto-generate field name from label
      fieldLabel?.addEventListener('input', function() {
        const name = this.value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '_')
          .replace(/(^_|_$)/g, '');
        if (fieldName) fieldName.value = name;
      });

      // Show/hide options based on field type
      fieldType?.addEventListener('change', function() {
        const needsOptions = ['radio', 'checkbox', 'select'].includes(this.value);
        if (needsOptions) {
          fieldOptionsContainer?.classList.remove('hidden');
        } else {
          fieldOptionsContainer?.classList.add('hidden');
        }
      });

      // Manage fields buttons
      document.querySelectorAll('.manage-fields-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
          currentFormId = this.getAttribute('data-form-id');
          const formName = this.getAttribute('data-form-name');
          document.getElementById('fields-modal-title').textContent = `Manage Fields - ${formName}`;
          await loadFormFields(currentFormId);
          fieldsModal?.classList.remove('hidden');
        });
      });

      // Fields modal controls
      closeFieldsModal?.addEventListener('click', function() {
        fieldsModal?.classList.add('hidden');
      });

      fieldsModal?.addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
      });

      // Add field button
      addFieldBtn?.addEventListener('click', function() {
        document.getElementById('field-modal-title').textContent = 'Add Field';
        document.getElementById('submit-field-btn').textContent = 'Add Field';
        fieldForm?.reset();
        document.getElementById('field-id').value = '';
        document.getElementById('field-form-id').value = currentFormId;
        fieldOptionsContainer?.classList.add('hidden');
        fieldModal?.classList.remove('hidden');
      });

      // Field modal controls
      [closeFieldModal, cancelField].forEach(btn => {
        btn?.addEventListener('click', function() {
          fieldModal?.classList.add('hidden');
        });
      });

      fieldModal?.addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
      });

      // Handle field submission
      fieldForm?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const isEdit = !!formData.get('id');
        const method = isEdit ? 'PUT' : 'POST';

        try {
          const response = await fetch('/api/admin/form-fields', { method, body: formData });
          const result = await response.json();

          if (response.ok && result.success) {
            fieldModal?.classList.add('hidden');
            await loadFormFields(currentFormId);
          } else {
            alert('Error: ' + (result?.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error saving field. Please try again.');
        }
      });

      // --- SUBMISSIONS ---
      document.querySelectorAll('.view-submissions-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
          const formId = this.getAttribute('data-form-id');
          const formName = this.getAttribute('data-form-name');
          document.getElementById('submissions-modal-title').textContent = `Submissions - ${formName}`;
          await loadSubmissions(formId);
          document.getElementById('submissions-modal').classList.remove('hidden');
        });
      });

      document.getElementById('close-submissions-modal')?.addEventListener('click', function() {
        document.getElementById('submissions-modal').classList.add('hidden');
      });

      document.getElementById('export-csv-btn')?.addEventListener('click', function() {
        exportSubmissionsCSV();
      });

      // --- HELPER FUNCTIONS ---
      function copyFormLink(slug) {
        // Create the correct URL format for forms
        const url = `${window.location.origin}/forms/${slug}`;
        console.log('Copying form URL:', url); // Debug log
        navigator.clipboard.writeText(url).then(() => {
          alert('Form link copied to clipboard!');
        }).catch(() => {
          prompt('Copy this link:', url);
        });
      }

      function shareOnWhatsApp(slug, formName) {
        // Create the correct URL format for forms
        const url = `${window.location.origin}/forms/${slug}`;
        console.log('Sharing form URL:', url); // Debug log
        const text = `Fill this form: ${formName}\n${url}`;
        const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(text)}`;
        window.open(whatsappUrl, '_blank');
      }

      async function loadFormFields(formId) {
        try {
          const response = await fetch(`/api/admin/form-fields?form_id=${formId}`);
          if (!response.ok) {
            // For now, we'll just show empty state
            document.getElementById('fields-list').innerHTML = '<p class="text-gray-500">No fields yet. Add your first field!</p>';
            return;
          }

          const result = await response.json();
          const fields = result.data || [];

          const fieldsList = document.getElementById('fields-list');
          if (fields.length === 0) {
            fieldsList.innerHTML = '<p class="text-gray-500">No fields yet. Add your first field!</p>';
            return;
          }

          fieldsList.innerHTML = fields.map(field => `
            <div class="field-item border border-gray-200 rounded-lg p-4 bg-gray-50">
              <div class="flex justify-between items-center">
                <div>
                  <h5 class="font-medium text-gray-900">${field.label} ${field.required ? '<span class="text-red-500">*</span>' : ''}</h5>
                  <p class="text-sm text-gray-500">${field.field_type} (${field.field_name})</p>
                  ${field.options && field.options.length > 0 ? `<p class="text-xs text-gray-400">Options: ${field.options.join(', ')}</p>` : ''}
                </div>
                <div class="flex space-x-2">
                  <button class="edit-field-btn text-coral-500 hover:text-coral-600 text-sm" data-field='${JSON.stringify(field)}'>Edit</button>
                  <button class="delete-field-btn text-red-600 hover:text-red-700 text-sm" data-id="${field.id}" data-label="${field.label}">Delete</button>
                </div>
              </div>
            </div>
          `).join('');

          // Add event listeners for edit and delete buttons
          fieldsList.querySelectorAll('.edit-field-btn').forEach(btn => {
            btn.addEventListener('click', function() {
              const field = JSON.parse(this.getAttribute('data-field'));
              document.getElementById('field-modal-title').textContent = 'Edit Field';
              document.getElementById('submit-field-btn').textContent = 'Update Field';
              document.getElementById('field-id').value = field.id;
              document.getElementById('field-form-id').value = field.form_id;
              document.getElementById('field-label').value = field.label;
              document.getElementById('field-name').value = field.field_name;
              document.getElementById('field-type').value = field.field_type;
              document.getElementById('field-required').checked = field.required;

              if (field.options && field.options.length > 0) {
                document.getElementById('field-options').value = field.options.join(', ');
                fieldOptionsContainer?.classList.remove('hidden');
              } else {
                fieldOptionsContainer?.classList.add('hidden');
              }

              fieldModal?.classList.remove('hidden');
            });
          });

          fieldsList.querySelectorAll('.delete-field-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
              const id = this.getAttribute('data-id');
              const label = this.getAttribute('data-label');

              const ok = confirm(`Are you sure you want to delete field "${label}"?`);
              if (!ok) return;

              try {
                const res = await fetch(`/api/admin/form-fields?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
                const result = await res.json();
                if (!res.ok) {
                  return alert(`Failed to delete: ${result?.error || 'Unknown error'}`);
                }
                await loadFormFields(currentFormId);
              } catch (err) {
                console.error('Delete error:', err);
                alert('Error deleting field. Please try again.');
              }
            });
          });

        } catch (error) {
          console.error('Error loading fields:', error);
          document.getElementById('fields-list').innerHTML = '<p class="text-red-500">Error loading fields</p>';
        }
      }

      let currentSubmissions = [];

      async function loadSubmissions(formId) {
        try {
          const response = await fetch(`/api/admin/submissions?form_id=${formId}`);
          const result = await response.json();

          if (!response.ok) {
            document.getElementById('submissions-content').innerHTML = '<p class="text-red-500">Error loading submissions</p>';
            return;
          }

          currentSubmissions = result.data || [];

          if (currentSubmissions.length === 0) {
            document.getElementById('submissions-content').innerHTML = '<p class="text-gray-500">No submissions yet.</p>';
            return;
          }

          // Get all unique keys from submissions
          const allKeys = new Set();
          currentSubmissions.forEach(sub => {
            Object.keys(sub.data).forEach(key => allKeys.add(key));
          });

          const keys = Array.from(allKeys);

          const table = `
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted At</th>
                    ${keys.map(key => `<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">${key}</th>`).join('')}
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  ${currentSubmissions.map(sub => `
                    <tr>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${new Date(sub.submitted_at).toLocaleString()}</td>
                      ${keys.map(key => {
                        const value = sub.data[key];
                        const displayValue = Array.isArray(value) ? value.join(', ') : (value || '-');
                        return `<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${displayValue}</td>`;
                      }).join('')}
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          `;

          document.getElementById('submissions-content').innerHTML = table;
        } catch (error) {
          console.error('Error loading submissions:', error);
          document.getElementById('submissions-content').innerHTML = '<p class="text-red-500">Error loading submissions</p>';
        }
      }

      function exportSubmissionsCSV() {
        if (currentSubmissions.length === 0) {
          alert('No submissions to export');
          return;
        }

        // Get all unique keys
        const allKeys = new Set();
        currentSubmissions.forEach(sub => {
          Object.keys(sub.data).forEach(key => allKeys.add(key));
        });

        const keys = Array.from(allKeys);
        const headers = ['Submitted At', ...keys];

        const csvContent = [
          headers.join(','),
          ...currentSubmissions.map(sub => {
            const row = [new Date(sub.submitted_at).toLocaleString()];
            keys.forEach(key => {
              const value = sub.data[key];
              const csvValue = Array.isArray(value) ? value.join('; ') : (value || '');
              // Escape commas and quotes
              const escapedValue = csvValue.toString().includes(',') || csvValue.toString().includes('"')
                ? `"${csvValue.toString().replace(/"/g, '""')}"`
                : csvValue;
              row.push(escapedValue);
            });
            return row.join(',');
          })
        ].join('\n');

        const blob = new Blob([csvContent], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `form-submissions-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);
      }
    });
  </script>
</Layout>