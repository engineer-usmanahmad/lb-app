      attachEnrollmentEventListeners();
      
      // Function to load all submission counts for forms
      async function loadAllSubmissionCounts() {
        console.log('Loading all submission counts...');
        const submissionCountElements = document.querySelectorAll('.submission-count');
        console.log(`Found ${submissionCountElements.length} submission count elements`);
        
        // First attempt - load all counts
        const loadPromises = [];
        
        for (const element of submissionCountElements) {
          const formId = element.getAttribute('data-form-id');
          if (!formId) {
            console.warn('Found submission count element without form ID');
            continue;
          }
          
          console.log(`Loading count for form ${formId}`);
          
          const loadPromise = (async () => {
            try {
              const response = await fetch(`/api/admin/form-submissions-count?formId=${encodeURIComponent(formId)}`);
              const result = await response.json();
              
              if (response.ok && result.success) {
                const countElement = element.querySelector('.count-value');
                if (countElement) {
                  countElement.textContent = result.count || '0';
                  console.log(`Updated count for form ${formId}: ${result.count || '0'}`);
                } else {
                  console.warn(`Count element not found for form ${formId}`);
                }
              } else {
                console.error(`Failed to load submission count for form ${formId}:`, result?.error || 'Unknown error');
              }
            } catch (error) {
              console.error(`Error loading submission count for form ${formId}:`, error);
            }
          })();
          
          loadPromises.push(loadPromise);
        }
        
        // Wait for all initial loads to complete
        await Promise.all(loadPromises);
        
        // Second attempt - retry for any counts that didn't load
        console.log('First attempt complete, checking for any missing counts...');
        setTimeout(() => {
          const pendingCounts = document.querySelectorAll('.count-value');
          console.log(`Checking ${pendingCounts.length} count elements for missing values`);
          
          for (const element of pendingCounts) {
            if (element.textContent === '...' || element.textContent === '') {
              const formElement = element.closest('.submission-count');
              if (formElement) {
                const formId = formElement.getAttribute('data-form-id');
                if (formId) {
                  console.log(`Retrying count for form ${formId}`);
                  fetch(`/api/admin/form-submissions-count?formId=${encodeURIComponent(formId)}`, {
                    // Add cache-busting parameter
                    headers: {
                      'Cache-Control': 'no-cache',
                      'Pragma': 'no-cache'
                    }
                  })
                    .then(response => response.json())
                    .then(result => {
                      if (result.success) {
                        element.textContent = result.count || '0';
                        console.log(`Retry successful for form ${formId}: ${result.count || '0'}`);
                      } else {
                        console.error(`Retry failed for form ${formId}:`, result?.error || 'Unknown error');
                      }
                    })
                    .catch(error => console.error(`Error in retry for form ${formId}:`, error));
                }
              }
            }
          }
          
          // Third attempt after a longer delay
          setTimeout(() => {
            console.log('Final attempt to load any remaining missing counts...');
            const stillPendingCounts = document.querySelectorAll('.count-value');
            
            for (const element of stillPendingCounts) {
              if (element.textContent === '...' || element.textContent === '') {
                const formElement = element.closest('.submission-count');
                if (formElement) {
                  const formId = formElement.getAttribute('data-form-id');
                  if (formId) {
                    console.log(`Final retry for form ${formId}`);
                    // Force a value of 0 if we still can't load it
                    element.textContent = '0';
                    
                    // Still try to load the actual value
                    fetch(`/api/admin/form-submissions-count?formId=${encodeURIComponent(formId)}?nocache=${Date.now()}`)
                      .then(response => response.json())
                      .then(result => {
                        if (result.success) {
                          element.textContent = result.count || '0';
                          console.log(`Final retry successful for form ${formId}: ${result.count || '0'}`);
                        }
                      })
                      .catch(error => console.error(`Error in final retry for form ${formId}:`, error));
                  }
                }
              }
            }
          }, 2000);
        }, 1000);
      }
      
      // Load submission counts when page loads
      loadAllSubmissionCounts();
      
      // Function to update enrollment status
      async function updateEnrollmentStatus(id, status, comments, buttonElement) {
        try {
          const enrollmentResponse = await fetch('/api/admin/update-enrollment-status', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json'
            },
            credentials: 'include',
            body: JSON.stringify({
              enrollment_id: id,
              status: status,
              comments: comments
            })
          });
          
          const enrollmentResult = await enrollmentResponse.json();
          if (enrollmentResponse.ok && enrollmentResult.success) {
            // Update UI to show new status
            const enrollmentItem = buttonElement.closest('.enrollment-item');
            const statusBadge = enrollmentItem.querySelector('.enrollment-header .rounded-full');
            if (statusBadge) {
              statusBadge.textContent = status;
              
              // Remove all existing status classes
              statusBadge.classList.remove(
                'bg-yellow-100', 'text-yellow-800',
                'bg-green-100', 'text-green-800',
                'bg-blue-100', 'text-blue-800',
                'bg-red-100', 'text-red-800',
                'bg-gray-100', 'text-gray-800'
              );
              
              // Add appropriate status classes
              if (status === 'pending') {
                statusBadge.classList.add('bg-yellow-100', 'text-yellow-800');
              } else if (status === 'enrolled') {
                statusBadge.classList.add('bg-green-100', 'text-green-800');
              } else if (status === 'payment_pending') {
                statusBadge.classList.add('bg-blue-100', 'text-blue-800');
              } else if (status === 'cancelled') {
                statusBadge.classList.add('bg-red-100', 'text-red-800');
              } else {
                statusBadge.classList.add('bg-gray-100', 'text-gray-800');
              }
            }
            
            // Update the button's data-status attribute
            buttonElement.setAttribute('data-status', status);
            
            alert(`Enrollment status updated to: ${status}`);
          } else {
            alert('Error: ' + (enrollmentResult?.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error updating enrollment status. Please try again.');
        }
      }

