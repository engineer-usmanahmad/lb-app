---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = import.meta.env.SUPABASE_URL as string;
const SUPABASE_SERVICE_ROLE_KEY = (import.meta.env.SUPABASE_SERVICE_ROLE_KEY as string | undefined) ?? (import.meta.env.SUPABASE_ANON_KEY as string);

if (!SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) {
  throw new Error('Missing Supabase environment variables');
}

const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY);

// Fetch existing AWS configuration
let awsConfig = null;
try {
  const { data } = await supabase
    .from('aws_config')
    .select('*')
    .single();
  awsConfig = data;
} catch (error) {
  console.log('No existing AWS config found');
}
---

<Layout title="AWS S3 Configuration - LB Institute Admin">
  <Header />
  
  <main class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">AWS S3 Configuration</h1>
            <p class="mt-2 text-gray-600">Configure AWS S3 settings for image storage</p>
          </div>
          <a href="/admin/dashboard" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
            Back to Dashboard
          </a>
        </div>
      </div>

      <!-- Configuration Status -->
      <div class="mb-6">
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class={`w-3 h-3 rounded-full ${awsConfig ? 'bg-green-400' : 'bg-red-400'}`}></div>
            </div>
            <div class="ml-3">
              <h3 class="text-lg font-medium text-gray-900">
                {awsConfig ? 'AWS S3 Configured' : 'AWS S3 Not Configured'}
              </h3>
              <p class="text-gray-600">
                {awsConfig ? 'S3 integration is active and ready for use' : 'Configure AWS S3 to enable cloud image storage'}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Configuration Form -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900">S3 Configuration</h2>
        </div>
        
        <form id="aws-config-form" class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- AWS Access Key ID -->
            <div>
              <label for="access_key_id" class="block text-sm font-medium text-gray-700 mb-2">
                AWS Access Key ID *
              </label>
              <input
                type="text"
                id="access_key_id"
                name="access_key_id"
                value={awsConfig?.access_key_id || ''}
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="AKIA..."
                required
              />
            </div>

            <!-- AWS Secret Access Key -->
            <div>
              <label for="secret_access_key" class="block text-sm font-medium text-gray-700 mb-2">
                AWS Secret Access Key *
              </label>
              <input
                type="password"
                id="secret_access_key"
                name="secret_access_key"
                value={awsConfig?.secret_access_key || ''}
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Enter secret key"
                required
              />
            </div>

            <!-- S3 Bucket Name -->
            <div>
              <label for="bucket_name" class="block text-sm font-medium text-gray-700 mb-2">
                S3 Bucket Name *
              </label>
              <input
                type="text"
                id="bucket_name"
                name="bucket_name"
                value={awsConfig?.bucket_name || ''}
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="my-bucket-name"
                required
              />
            </div>

            <!-- S3 Region -->
            <div>
              <label for="region" class="block text-sm font-medium text-gray-700 mb-2">
                AWS Region *
              </label>
              <select
                id="region"
                name="region"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                required
              >
                <option value="">Select Region</option>
                <option value="us-east-1" selected={awsConfig?.region === 'us-east-1'}>US East (N. Virginia)</option>
                <option value="us-east-2" selected={awsConfig?.region === 'us-east-2'}>US East (Ohio)</option>
                <option value="us-west-1" selected={awsConfig?.region === 'us-west-1'}>US West (N. California)</option>
                <option value="us-west-2" selected={awsConfig?.region === 'us-west-2'}>US West (Oregon)</option>
                <option value="eu-west-1" selected={awsConfig?.region === 'eu-west-1'}>Europe (Ireland)</option>
                <option value="eu-central-1" selected={awsConfig?.region === 'eu-central-1'}>Europe (Frankfurt)</option>
                <option value="eu-west-2" selected={awsConfig?.region === 'eu-west-2'}>Europe (London)</option>
                <option value="eu-west-3" selected={awsConfig?.region === 'eu-west-3'}>Europe (Paris)</option>
                <option value="ap-south-1" selected={awsConfig?.region === 'ap-south-1'}>Asia Pacific (Mumbai)</option>
                <option value="ap-southeast-1" selected={awsConfig?.region === 'ap-southeast-1'}>Asia Pacific (Singapore)</option>
                <option value="ap-southeast-2" selected={awsConfig?.region === 'ap-southeast-2'}>Asia Pacific (Sydney)</option>
                <option value="ap-northeast-1" selected={awsConfig?.region === 'ap-northeast-1'}>Asia Pacific (Tokyo)</option>
              </select>
            </div>
          </div>

          <!-- Folder Structure Settings -->
          <div class="border-t pt-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Folder Structure Settings</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="success_stories_folder" class="block text-sm font-medium text-gray-700 mb-2">
                  Success Stories Folder
                </label>
                <input
                  type="text"
                  id="success_stories_folder"
                  name="success_stories_folder"
                  value={awsConfig?.success_stories_folder || 'certifications'}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="certifications"
                />
              </div>

              <div>
                <label for="events_folder" class="block text-sm font-medium text-gray-700 mb-2">
                  Events Folder
                </label>
                <input
                  type="text"
                  id="events_folder"
                  name="events_folder"
                  value={awsConfig?.events_folder || 'events'}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="events"
                />
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t">
            <button
              type="button"
              id="test-connection"
              class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors"
            >
              Test Connection
            </button>
            <button
              type="submit"
              class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition-colors"
            >
              Save Configuration
            </button>
            {awsConfig && (
              <button
                type="button"
                id="delete-config"
                class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 transition-colors"
              >
                Delete Configuration
              </button>
            )}
          </div>
        </form>
      </div>

      <!-- Connection Test Results -->
      <div id="test-results" class="mt-6 hidden">
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Connection Test Results</h3>
          <div id="test-output" class="text-sm"></div>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('aws-config-form');
      const testButton = document.getElementById('test-connection');
      const deleteButton = document.getElementById('delete-config');
      const testResults = document.getElementById('test-results');
      const testOutput = document.getElementById('test-output');

      // Test S3 Connection
      testButton?.addEventListener('click', async function() {
        const formData = new FormData(form);
        formData.append('action', 'test');
        
        try {
          testButton.disabled = true;
          testButton.textContent = 'Testing...';
          
          const response = await fetch('/api/admin/aws-config', {
            method: 'POST',
            body: formData
          });
          
          const result = await response.json();
          
          testResults.classList.remove('hidden');
          
          if (result.success) {
            testOutput.innerHTML = `
              <div class="flex items-center text-green-600">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Connection successful! S3 bucket is accessible.
              </div>
            `;
          } else {
            testOutput.innerHTML = `
              <div class="flex items-center text-red-600">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
                Connection failed: ${result.error}
              </div>
            `;
          }
        } catch (error) {
          testResults.classList.remove('hidden');
          testOutput.innerHTML = `
            <div class="flex items-center text-red-600">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
              Error testing connection: ${error.message}
            </div>
          `;
        } finally {
          testButton.disabled = false;
          testButton.textContent = 'Test Connection';
        }
      });

      // Save Configuration
      form?.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(form);
        formData.append('action', 'save');
        
        try {
          const response = await fetch('/api/admin/aws-config', {
            method: 'POST',
            body: formData
          });
          
          const result = await response.json();
          
          if (result.success) {
            alert('AWS S3 configuration saved successfully!');
            window.location.reload();
          } else {
            alert('Error saving configuration: ' + result.error);
          }
        } catch (error) {
          alert('Error saving configuration: ' + error.message);
        }
      });

      // Delete Configuration
      deleteButton?.addEventListener('click', async function() {
        if (!confirm('Are you sure you want to delete the AWS S3 configuration?')) {
          return;
        }
        
        try {
          const response = await fetch('/api/admin/aws-config', {
            method: 'DELETE'
          });
          
          const result = await response.json();
          
          if (result.success) {
            alert('AWS S3 configuration deleted successfully!');
            window.location.reload();
          } else {
            alert('Error deleting configuration: ' + result.error);
          }
        } catch (error) {
          alert('Error deleting configuration: ' + error.message);
        }
      });
    });
  </script>
</Layout>