---
import Layout from '../../layouts/Layout.astro';
import { supabaseAdmin } from '../../lib/supabase-admin';
import AdvancedCharts from '../../components/charts/AdvancedCharts.astro';
import ComprehensiveAnalytics from '../../components/analytics/ComprehensiveAnalytics.astro';
import EnhancedFormFeatures from '../../components/forms/EnhancedFormFeatures.astro';
import AdvancedSharingOptions from '../../components/sharing/AdvancedSharingOptions.astro';
import PremiumUIEnhancements from '../../components/ui/PremiumUIEnhancements.astro';
import FormIntelligence from '../../components/intelligence/FormIntelligence.astro';
import WebSocketManager from '../../components/websocket/WebSocketManager.astro';

// Fetch comprehensive analytics data
const { data: forms } = await supabaseAdmin
  .from('review_forms')
  .select('*')
  .order('created_at', { ascending: false });

const { data: responses } = await supabaseAdmin
  .from('form_responses')
  .select('*')
  .order('created_at', { ascending: false });

const { data: analytics } = await supabaseAdmin
  .from('form_analytics_cache')
  .select('*')
  .order('created_at', { ascending: false });

// Calculate key metrics
const totalForms = forms?.length || 0;
const totalResponses = responses?.length || 0;
const activeForms = forms?.filter(form => form.is_active).length || 0;
const responseRate = totalForms > 0 ? ((totalResponses / totalForms) * 100).toFixed(1) : 0;

// Recent activity
const recentActivity = responses?.slice(0, 10) || [];

// Top performing forms
const formResponseCounts = forms?.map(form => ({
  ...form,
  responseCount: responses?.filter(r => r.form_id === form.id).length || 0
})).sort((a, b) => b.responseCount - a.responseCount).slice(0, 5) || [];

// Rating analysis
const ratings = responses?.map(r => r.rating).filter(Boolean) || [];
const averageRating = ratings.length > 0 ? (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(1) : 0;

// Response trends (last 30 days)
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

const recentResponses = responses?.filter(r => 
  new Date(r.created_at) >= thirtyDaysAgo
) || [];

const dailyResponseCounts = {};
for (let i = 29; i >= 0; i--) {
  const date = new Date();
  date.setDate(date.getDate() - i);
  const dateStr = date.toISOString().split('T')[0];
  dailyResponseCounts[dateStr] = recentResponses.filter(r => 
    r.created_at.startsWith(dateStr)
  ).length;
}

const pageTitle = "Complete Analytics System - Advanced Form Builder";
const pageDescription = "Comprehensive analytics dashboard with real-time updates, form intelligence, and premium features for professional feedback management.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="complete-analytics-system min-h-screen bg-gradient-to-br from-gray-50 via-blue-50 to-indigo-100">
    
    <!-- WebSocket Manager for Real-time Updates - Disabled to prevent connection issues -->
    <!-- <WebSocketManager wsUrl="ws://localhost:3001" /> -->
    
    <!-- Premium UI Enhancements -->
    <PremiumUIEnhancements />
    
    <!-- Header Section -->
    <div class="analytics-header bg-white shadow-lg border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Complete Analytics System</h1>
            <p class="text-gray-600">Advanced form builder with premium analytics, intelligence, and real-time features</p>
          </div>
          
          <!-- Real-time Status Indicators -->
          <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-2 bg-green-100 text-green-800 px-3 py-1 rounded-full">
              <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-medium">Live</span>
            </div>
            
            <div class="flex items-center space-x-2 bg-blue-100 text-blue-800 px-3 py-1 rounded-full">
              <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-medium">Real-time</span>
            </div>
            
            <div class="flex items-center space-x-2 bg-purple-100 text-purple-800 px-3 py-1 rounded-full">
              <div class="w-2 h-2 bg-purple-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-medium">AI Powered</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      
      <!-- Key Metrics Dashboard -->
      <div class="metrics-dashboard mb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Total Forms -->
          <div class="metric-card bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl shadow-lg p-6 text-white transform hover:scale-105 transition-all duration-300">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-blue-100 text-sm font-medium">Total Forms</p>
                <p class="text-3xl font-bold" id="total-forms-metric">{totalForms}</p>
              </div>
              <div class="metric-icon">
                <svg class="w-10 h-10 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
            </div>
            <div class="mt-4">
              <div class="flex items-center text-sm">
                <span class="text-blue-100">{activeForms} active forms</span>
              </div>
            </div>
          </div>

          <!-- Total Responses -->
          <div class="metric-card bg-gradient-to-r from-green-500 to-green-600 rounded-xl shadow-lg p-6 text-white transform hover:scale-105 transition-all duration-300">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-green-100 text-sm font-medium">Total Responses</p>
                <p class="text-3xl font-bold" id="total-responses-metric">{totalResponses}</p>
              </div>
              <div class="metric-icon">
                <svg class="w-10 h-10 text-green-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                </svg>
              </div>
            </div>
            <div class="mt-4">
              <div class="flex items-center text-sm">
                <span class="text-green-100">+{recentResponses.length} this month</span>
              </div>
            </div>
          </div>

          <!-- Response Rate -->
          <div class="metric-card bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl shadow-lg p-6 text-white transform hover:scale-105 transition-all duration-300">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-purple-100 text-sm font-medium">Response Rate</p>
                <p class="text-3xl font-bold" id="response-rate-metric">{responseRate}%</p>
              </div>
              <div class="metric-icon">
                <svg class="w-10 h-10 text-purple-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
            </div>
            <div class="mt-4">
              <div class="flex items-center text-sm">
                <span class="text-purple-100">Excellent engagement</span>
              </div>
            </div>
          </div>

          <!-- Average Rating -->
          <div class="metric-card bg-gradient-to-r from-yellow-500 to-orange-500 rounded-xl shadow-lg p-6 text-white transform hover:scale-105 transition-all duration-300">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-yellow-100 text-sm font-medium">Average Rating</p>
                <p class="text-3xl font-bold" id="average-rating-metric">{averageRating}</p>
              </div>
              <div class="metric-icon">
                <svg class="w-10 h-10 text-yellow-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                </svg>
              </div>
            </div>
            <div class="mt-4">
              <div class="flex items-center text-sm">
                <span class="text-yellow-100">Out of 5 stars</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Advanced Charts Section -->
      <div class="charts-section mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Advanced Analytics Charts</h2>
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-medium text-green-700">Live Data</span>
            </div>
          </div>
          
          <AdvancedCharts />
        </div>
      </div>

      <!-- Comprehensive Analytics -->
      <div class="comprehensive-analytics mb-8">
        <ComprehensiveAnalytics />
      </div>

      <!-- Form Intelligence Section -->
      <div class="form-intelligence mb-8">
        <FormIntelligence formId="analytics-system" />
      </div>

      <!-- Enhanced Form Features -->
      <div class="enhanced-forms mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Enhanced Form Features</h2>
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-medium text-blue-700">Interactive</span>
            </div>
          </div>
          
          <EnhancedFormFeatures />
        </div>
      </div>

      <!-- Advanced Sharing Options -->
      <div class="advanced-sharing mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Advanced Sharing & Distribution</h2>
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 bg-purple-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-medium text-purple-700">Multi-channel</span>
            </div>
          </div>
          
          <AdvancedSharingOptions />
        </div>
      </div>

      <!-- Recent Activity Feed -->
      <div class="activity-feed mb-8">
        <div class="bg-white rounded-xl shadow-lg p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Real-time Activity Feed</h2>
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
              <span class="text-sm font-medium text-red-700">Live Updates</span>
            </div>
          </div>
          
          <div id="activity-feed" class="space-y-4 max-h-96 overflow-y-auto">
            {recentActivity.map((activity, index) => (
              <div class="activity-item flex items-center space-x-4 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors duration-200">
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                  </div>
                </div>
                
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900">
                    New response received
                  </p>
                  <p class="text-sm text-gray-500">
                    Rating: {activity.rating}/5 • {new Date(activity.created_at).toLocaleString()}
                  </p>
                </div>
                
                <div class="flex-shrink-0">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    New
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Quick Actions Panel -->
      <div class="quick-actions">
        <div class="bg-white rounded-xl shadow-lg p-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Quick Actions</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- Create New Form -->
            <button class="quick-action-btn bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-lg p-4 hover:from-blue-600 hover:to-blue-700 transform hover:scale-105 transition-all duration-200">
              <div class="flex items-center space-x-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                <span class="font-medium">Create Form</span>
              </div>
            </button>

            <!-- Export Reports -->
            <button class="quick-action-btn bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg p-4 hover:from-green-600 hover:to-green-700 transform hover:scale-105 transition-all duration-200">
              <div class="flex items-center space-x-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span class="font-medium">Export Data</span>
              </div>
            </button>

            <!-- Share Forms -->
            <button class="quick-action-btn bg-gradient-to-r from-purple-500 to-purple-600 text-white rounded-lg p-4 hover:from-purple-600 hover:to-purple-700 transform hover:scale-105 transition-all duration-200">
              <div class="flex items-center space-x-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
                </svg>
                <span class="font-medium">Share Forms</span>
              </div>
            </button>

            <!-- View Analytics -->
            <button class="quick-action-btn bg-gradient-to-r from-orange-500 to-red-500 text-white rounded-lg p-4 hover:from-orange-600 hover:to-red-600 transform hover:scale-105 transition-all duration-200">
              <div class="flex items-center space-x-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span class="font-medium">View Reports</span>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Action Button -->
    <div class="fixed bottom-6 right-6">
      <button class="fab bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-full w-14 h-14 shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
      </button>
    </div>
  </div>
</Layout>

<script>
// Complete Analytics System JavaScript
class CompleteAnalyticsSystem {
  constructor() {
    this.init();
  }

  init() {
    this.setupRealTimeUpdates();
    this.setupQuickActions();
    this.setupActivityFeed();
    this.initializeAnimations();
  }

  setupRealTimeUpdates() {
    // Listen for WebSocket events
    if (window.wsManager) {
      window.wsManager.on('newResponse', (data) => {
        this.updateMetrics(data);
        this.addActivityItem(data);
      });

      window.wsManager.on('formUpdate', (data) => {
        this.updateFormMetrics(data);
      });

      window.wsManager.on('analyticsUpdate', (data) => {
        this.updateAnalyticsDashboard(data);
      });
    }

    // Simulate real-time updates for demo
    this.simulateRealTimeData();
  }

  updateMetrics(data) {
    // Update total responses
    const responsesMetric = document.getElementById('total-responses-metric');
    if (responsesMetric) {
      const currentCount = parseInt(responsesMetric.textContent) || 0;
      responsesMetric.textContent = currentCount + 1;
      this.animateMetric(responsesMetric);
    }

    // Update response rate
    const responseRateMetric = document.getElementById('response-rate-metric');
    if (responseRateMetric && data.responseRate) {
      responseRateMetric.textContent = data.responseRate + '%';
      this.animateMetric(responseRateMetric);
    }

    // Update average rating
    const ratingMetric = document.getElementById('average-rating-metric');
    if (ratingMetric && data.averageRating) {
      ratingMetric.textContent = data.averageRating;
      this.animateMetric(ratingMetric);
    }
  }

  updateFormMetrics(data) {
    const formsMetric = document.getElementById('total-forms-metric');
    if (formsMetric && data.action === 'created') {
      const currentCount = parseInt(formsMetric.textContent) || 0;
      formsMetric.textContent = currentCount + 1;
      this.animateMetric(formsMetric);
    }
  }

  animateMetric(element) {
    element.classList.add('animate-pulse');
    element.style.transform = 'scale(1.1)';
    
    setTimeout(() => {
      element.classList.remove('animate-pulse');
      element.style.transform = 'scale(1)';
    }, 1000);
  }

  addActivityItem(data) {
    const activityFeed = document.getElementById('activity-feed');
    if (!activityFeed) return;

    const activityItem = document.createElement('div');
    activityItem.className = 'activity-item flex items-center space-x-4 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors duration-200 opacity-0 transform translate-x-full';
    
    activityItem.innerHTML = `
      <div class="flex-shrink-0">
        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </div>
      </div>
      
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-900">
          New response received
        </p>
        <p class="text-sm text-gray-500">
          Rating: ${data.rating || 5}/5 • ${new Date().toLocaleString()}
        </p>
      </div>
      
      <div class="flex-shrink-0">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          New
        </span>
      </div>
    `;

    activityFeed.insertBefore(activityItem, activityFeed.firstChild);

    // Animate in
    setTimeout(() => {
      activityItem.classList.remove('opacity-0', 'translate-x-full');
    }, 100);

    // Remove old items if too many
    const items = activityFeed.querySelectorAll('.activity-item');
    if (items.length > 10) {
      items[items.length - 1].remove();
    }
  }

  setupQuickActions() {
    const quickActionBtns = document.querySelectorAll('.quick-action-btn');
    
    quickActionBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const text = btn.querySelector('span').textContent;
        this.handleQuickAction(text);
      });
    });
  }

  handleQuickAction(action) {
    switch (action) {
      case 'Create Form':
        this.showNotification('Redirecting to form builder...', 'info');
        // Redirect to form builder
        break;
      case 'Export Data':
        this.showNotification('Preparing data export...', 'info');
        // Trigger export
        break;
      case 'Share Forms':
        this.showNotification('Opening sharing options...', 'info');
        // Open sharing modal
        break;
      case 'View Reports':
        this.showNotification('Loading detailed reports...', 'info');
        // Navigate to reports
        break;
    }
  }

  setupActivityFeed() {
    const activityFeed = document.getElementById('activity-feed');
    if (activityFeed) {
      // Add scroll behavior
      activityFeed.addEventListener('scroll', () => {
        if (activityFeed.scrollTop + activityFeed.clientHeight >= activityFeed.scrollHeight - 10) {
          this.loadMoreActivity();
        }
      });
    }
  }

  loadMoreActivity() {
    // Simulate loading more activity items
    console.log('Loading more activity items...');
  }

  initializeAnimations() {
    // Animate metric cards on load
    const metricCards = document.querySelectorAll('.metric-card');
    metricCards.forEach((card, index) => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
      
      setTimeout(() => {
        card.style.transition = 'all 0.5s ease';
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
      }, index * 100);
    });

    // Animate sections on scroll
    this.setupScrollAnimations();
  }

  setupScrollAnimations() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, {
      threshold: 0.1
    });

    document.querySelectorAll('.charts-section, .comprehensive-analytics, .form-intelligence, .enhanced-forms, .advanced-sharing, .activity-feed, .quick-actions').forEach(section => {
      observer.observe(section);
    });
  }

  simulateRealTimeData() {
    // Simulate new responses every 10-30 seconds
    setInterval(() => {
      const mockData = {
        rating: Math.floor(Math.random() * 5) + 1,
        responseRate: (Math.random() * 20 + 80).toFixed(1),
        averageRating: (Math.random() * 2 + 3.5).toFixed(1)
      };
      
      this.updateMetrics(mockData);
      this.addActivityItem(mockData);
    }, Math.random() * 20000 + 10000); // 10-30 seconds

    // Simulate form updates every 2-5 minutes
    setInterval(() => {
      const mockFormData = {
        action: 'created',
        formTitle: 'New Training Feedback Form'
      };
      
      this.updateFormMetrics(mockFormData);
    }, Math.random() * 180000 + 120000); // 2-5 minutes
  }

  showNotification(message, type = 'info') {
    // Use WebSocket manager's notification system if available
    if (window.wsManager) {
      window.wsManager.showNotification(message, type);
    } else {
      // Fallback notification
      console.log(`${type.toUpperCase()}: ${message}`);
    }
  }

  updateAnalyticsDashboard(data) {
    // Update dashboard with new analytics data
    console.log('Updating analytics dashboard:', data);
  }
}

// Initialize the complete analytics system
document.addEventListener('DOMContentLoaded', () => {
  window.completeAnalyticsSystem = new CompleteAnalyticsSystem();
});
</script>

