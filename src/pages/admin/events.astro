---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

console.log('Events page loading...');

// Initialize variables
let events = [];
let error = null;

try {
  console.log('Fetching events data with images...');
  const result = await supabase
    .from('events')
    .select(`
      *,
      event_images (
        id,
        image_url,
        image_alt,
        is_cover,
        created_at
      )
    `)
    .order('created_at', { ascending: false });

  events = result.data || [];
  error = result.error;
  
  console.log('Events fetched:', events?.length || 0);
  
  if (error) {
    console.error('Error fetching events:', error);
  }
} catch (e) {
  console.error('Exception in events page:', e);
  error = e;
  events = [];
}

console.log('Events page frontmatter completed');
---

<Layout title="Event Gallery Management - Admin">
  <Header />
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Header Section -->
      <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-slate-200">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent mb-2">
              Event Gallery Management
            </h1>
            <p class="text-slate-600 text-lg">Manage your events, upload images, and showcase your activities</p>
          </div>
          <button 
            id="addEventBtn"
            class="bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white px-8 py-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 flex items-center gap-3"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add New Event
          </button>
        </div>
      </div>
      
      <!-- Error Display -->
      {error && (
        <div class="bg-red-50 border-l-4 border-red-400 p-6 rounded-xl mb-8 shadow-lg">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-red-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-red-700 font-medium">Error loading events: {error.message || 'Unknown error'}</p>
          </div>
        </div>
      )}
      
      <!-- Events Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
        {events.map((event) => {
          const primaryImage = event.event_images?.find(img => img.is_cover);
          const imageCount = event.event_images?.length || 0;
          
          return (
            <div class="bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 overflow-hidden border border-slate-200 group">
              <!-- Event Image -->
              <div class="relative h-48 bg-gradient-to-br from-blue-100 to-purple-100 overflow-hidden">
                {primaryImage ? (
                  <img 
                    src={primaryImage.image_url} 
                    alt={primaryImage.image_alt || event.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-16 h-16 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                )}
                
                <!-- Image Count Badge -->
                {imageCount > 0 && (
                  <div class="absolute top-3 right-3 bg-black/70 text-white px-3 py-1 rounded-full text-sm font-medium flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    {imageCount}
                  </div>
                )}
              </div>
              
              <!-- Event Content -->
              <div class="p-6">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-xl font-bold text-slate-800 group-hover:text-blue-600 transition-colors duration-200 line-clamp-2">
                    {event.title}
                  </h3>
                </div>
                
                <!-- Event Details -->
                <div class="space-y-2 mb-4">
                  <div class="flex items-center text-slate-600">
                    <svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span class="text-sm font-medium">{new Date(event.event_date).toLocaleDateString()}</span>
                  </div>
                  
                  <div class="flex items-center text-slate-600">
                    <svg class="w-4 h-4 mr-2 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                    <span class="text-sm font-medium">{event.category}</span>
                  </div>
                  
                  {event.location && (
                    <div class="flex items-center text-slate-600">
                      <svg class="w-4 h-4 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      </svg>
                      <span class="text-sm font-medium">{event.location}</span>
                    </div>
                  )}
                </div>
                
                {event.description && (
                  <p class="text-slate-600 text-sm mb-4 line-clamp-2">{event.description}</p>
                )}
                
                <!-- Status Badge -->
                <div class="flex items-center justify-between mb-4">
                  <span class={`px-3 py-1 rounded-full text-xs font-medium ${event.active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                    {event.active ? 'Active' : 'Inactive'}
                  </span>
                  <button 
                    class="toggle-active-btn text-sm font-medium px-3 py-1 rounded-lg transition-colors duration-200 ${event.active ? 'bg-red-50 hover:bg-red-100 text-red-700' : 'bg-green-50 hover:bg-green-100 text-green-700'}"
                    data-event-id={event.id}
                    data-current-status={event.active}
                  >
                    {event.active ? 'Deactivate' : 'Activate'}
                  </button>
                </div>
                
                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-2">
                  <button 
                    class="manage-images-btn flex-1 bg-blue-50 hover:bg-blue-100 text-blue-700 px-4 py-2 rounded-lg font-medium transition-colors duration-200 flex items-center justify-center gap-2"
                    data-event-id={event.id}
                    data-event-title={event.title}
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    Images
                  </button>
                  
                  <button 
                    class="edit-event-btn bg-green-50 hover:bg-green-100 text-green-700 px-4 py-2 rounded-lg font-medium transition-colors duration-200 flex items-center justify-center gap-2"
                    data-event-id={event.id}
                    data-event-title={event.title}
                    data-event-date={event.event_date}
                    data-event-location={event.location || ''}
                    data-event-description={event.short_description || ''}
                    data-event-category={event.category}
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    Edit
                  </button>
                  
                  <button 
                    class="delete-event-btn bg-red-50 hover:bg-red-100 text-red-700 px-4 py-2 rounded-lg font-medium transition-colors duration-200 flex items-center justify-center gap-2"
                    data-event-id={event.id}
                    data-event-title={event.title}
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Delete
                  </button>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      
      <!-- Empty State -->
      {events.length === 0 && !error && (
        <div class="text-center py-20">
          <div class="bg-white rounded-2xl shadow-xl p-12 max-w-md mx-auto border border-slate-200">
            <svg class="w-20 h-20 text-slate-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <h3 class="text-xl font-semibold text-slate-700 mb-2">No Events Yet</h3>
            <p class="text-slate-500 mb-6">Start by creating your first event to showcase your activities.</p>
            <button 
              id="addEventBtnEmpty"
              class="bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200"
            >
              Create First Event
            </button>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Edit Event Modal -->
  <div id="editEventModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-8">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-slate-800">Edit Event</h2>
          <button id="closeEditModal" class="text-slate-400 hover:text-slate-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="editEventForm" class="space-y-6">
          <input type="hidden" name="id" id="editEventId" />
          
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Event Title *</label>
            <input 
              type="text" 
              name="title" 
              id="editEventTitle"
              required
              class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="Enter event title"
            />
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Event Date *</label>
              <input 
                type="date" 
                name="event_date" 
                id="editEventDate"
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Category *</label>
              <select 
                name="category" 
                id="editEventCategory"
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
                <option value="">Select category</option>
                <option value="Workshop">Workshop</option>
                <option value="Seminar">Seminar</option>
                <option value="Training">Training</option>
                <option value="Conference">Conference</option>
                <option value="Webinar">Webinar</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Location</label>
            <input 
              type="text" 
              name="location" 
              id="editEventLocation"
              class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="Enter event location"
            />
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
            <div id="editEventDescriptionEditor" class="border border-slate-300 rounded-xl focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-transparent transition-all duration-200 min-h-[120px]"></div>
            <textarea 
              name="description" 
              id="editEventDescription"
              rows="4"
              class="hidden"
              placeholder="Enter event description"
            ></textarea>
          </div>
          
          <div class="flex gap-4 pt-4">
            <button 
              type="submit"
              class="flex-1 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-200"
            >
              Update Event
            </button>
            <button 
              type="button"
              id="cancelEditEvent"
              class="px-8 py-3 border border-slate-300 text-slate-700 rounded-xl font-semibold hover:bg-slate-50 transition-all duration-200"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Add Event Modal -->
  <div id="addEventModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-8">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-slate-800">Add New Event</h2>
          <button id="closeAddModal" class="text-slate-400 hover:text-slate-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="addEventForm" class="space-y-6">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Event Title *</label>
            <input 
              type="text" 
              name="title" 
              required
              class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="Enter event title"
            />
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Event Date *</label>
              <input 
                type="date" 
                name="event_date" 
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Category *</label>
              <select 
                name="category" 
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
                <option value="">Select category</option>
                <option value="Workshop">Workshop</option>
                <option value="Seminar">Seminar</option>
                <option value="Training">Training</option>
                <option value="Conference">Conference</option>
                <option value="Webinar">Webinar</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Location</label>
            <input 
              type="text" 
              name="location" 
              class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              placeholder="Enter event location"
            />
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
            <div id="addEventDescriptionEditor" class="border border-slate-300 rounded-xl focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-transparent transition-all duration-200 min-h-[120px]"></div>
            <textarea 
              name="description" 
              rows="4"
              class="hidden"
              placeholder="Enter event description"
            ></textarea>
          </div>
          
          <div class="flex gap-4 pt-4">
            <button 
              type="submit"
              class="flex-1 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-200"
            >
              Create Event
            </button>
            <button 
              type="button"
              id="cancelAddEvent"
              class="px-8 py-3 border border-slate-300 text-slate-700 rounded-xl font-semibold hover:bg-slate-50 transition-all duration-200"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Image Management Modal -->
  <div id="imageModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-8">
        <div class="flex justify-between items-center mb-6">
          <h2 id="imageModalTitle" class="text-2xl font-bold text-slate-800">Manage Event Images</h2>
          <button id="closeImageModal" class="text-slate-400 hover:text-slate-600 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <!-- Upload Section -->
        <div class="mb-8 p-6 bg-gradient-to-r from-blue-50 to-purple-50 rounded-xl border-2 border-dashed border-blue-300">
          <div class="text-center">
            <svg class="w-12 h-12 text-blue-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            <h3 class="text-lg font-semibold text-slate-700 mb-2">Upload Event Images</h3>
            <p class="text-slate-600 mb-4">Select multiple images to upload (JPEG, PNG, WebP - Max 10MB each)</p>
            <input 
              type="file" 
              id="imageUpload" 
              multiple 
              accept="image/jpeg,image/jpg,image/png,image/webp"
              class="hidden"
            />
            <button 
              id="selectImagesBtn"
              class="bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-200"
            >
              Select Images
            </button>
          </div>
        </div>
        
        <!-- Images Grid -->
        <div id="imagesGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <!-- Images will be loaded here -->
        </div>
        
        <!-- Loading State -->
        <div id="imagesLoading" class="text-center py-8 hidden">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
          <p class="text-slate-600">Loading images...</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading Overlay -->
  <div id="loadingOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50 flex items-center justify-center">
    <div class="bg-white rounded-2xl p-8 shadow-2xl">
      <div class="flex items-center gap-4">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
        <span class="text-slate-700 font-medium">Processing...</span>
      </div>
    </div>
  </div>

  <script is:inline>
    // Global variables
    let currentEventId = null;
    let currentEventTitle = '';

    // Wait for DOM to be fully loaded
    document.addEventListener('DOMContentLoaded', function() {
      // DOM Elements
      const addEventBtn = document.getElementById('addEventBtn');
      const addEventBtnEmpty = document.getElementById('addEventBtnEmpty');
      const addEventModal = document.getElementById('addEventModal');
      const closeAddModal = document.getElementById('closeAddModal');
      const cancelAddEvent = document.getElementById('cancelAddEvent');
      const addEventForm = document.getElementById('addEventForm');
      const imageModal = document.getElementById('imageModal');
      const closeImageModalBtn = document.getElementById('closeImageModal');
      const imageModalTitle = document.getElementById('imageModalTitle');
      const selectImagesBtn = document.getElementById('selectImagesBtn');
      const imageUpload = document.getElementById('imageUpload');
      const imagesGrid = document.getElementById('imagesGrid');
      const imagesLoading = document.getElementById('imagesLoading');
      const loadingOverlay = document.getElementById('loadingOverlay');
      const editEventModal = document.getElementById('editEventModal');
      const closeEditModal = document.getElementById('closeEditModal');
      const cancelEditEvent = document.getElementById('cancelEditEvent');
      const editEventForm = document.getElementById('editEventForm');

      // Event Listeners
      addEventBtn?.addEventListener('click', () => openAddEventModal());
      addEventBtnEmpty?.addEventListener('click', () => openAddEventModal());
      closeAddModal?.addEventListener('click', () => closeAddEventModal());
      cancelAddEvent?.addEventListener('click', () => closeAddEventModal());
      closeEditModal?.addEventListener('click', () => closeEditEventModal());
      cancelEditEvent?.addEventListener('click', () => closeEditEventModal());
      closeImageModalBtn?.addEventListener('click', () => closeImageModal());
      addEventForm?.addEventListener('submit', handleAddEvent);
      editEventForm?.addEventListener('submit', handleEditEvent);
      selectImagesBtn?.addEventListener('click', () => imageUpload.click());
      imageUpload?.addEventListener('change', handleImageUpload);

      // Event delegation for dynamic buttons
      document.addEventListener('click', (e) => {
        if (e.target.closest('.manage-images-btn')) {
          const btn = e.target.closest('.manage-images-btn');
          currentEventId = btn.dataset.eventId;
          currentEventTitle = btn.dataset.eventTitle;
          openImageModal();
        } else if (e.target.closest('.edit-event-btn')) {
          const btn = e.target.closest('.edit-event-btn');
          openEditEventModal(btn);
        } else if (e.target.closest('.toggle-active-btn')) {
          const btn = e.target.closest('.toggle-active-btn');
          const eventId = btn.dataset.eventId;
          const currentStatus = btn.dataset.currentStatus === 'true';
          toggleEventStatus(eventId, currentStatus);
        } else if (e.target.closest('.delete-event-btn')) {
          const btn = e.target.closest('.delete-event-btn');
          const eventId = btn.dataset.eventId;
          const eventTitle = btn.dataset.eventTitle;
          deleteEvent(eventId, eventTitle);
        } else if (e.target.closest('.set-primary-btn')) {
          const btn = e.target.closest('.set-primary-btn');
          const imageId = btn.dataset.imageId;
          setPrimaryImage(imageId);
        } else if (e.target.closest('.delete-image-btn')) {
          const btn = e.target.closest('.delete-image-btn');
          const imageId = btn.dataset.imageId;
          deleteImage(imageId);
        }
      });

      // Functions
      function openAddEventModal() {
        addEventModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeAddEventModal() {
        addEventModal.classList.add('hidden');
        document.body.style.overflow = 'auto';
        addEventForm.reset();
        clearAddEventEditor();
      }

      function openImageModal() {
        imageModalTitle.textContent = `Manage Images - ${currentEventTitle}`;
        imageModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        loadEventImages();
      }

      function closeImageModal() {
        imageModal.classList.add('hidden');
        document.body.style.overflow = 'auto';
        currentEventId = null;
        currentEventTitle = '';
      }

      function openEditEventModal(btn) {
        const eventId = btn.dataset.eventId;
        const eventTitle = btn.dataset.eventTitle;
        const eventDate = btn.dataset.eventDate;
        const eventLocation = btn.dataset.eventLocation;
        const eventDescription = btn.dataset.eventDescription;
        const eventCategory = btn.dataset.eventCategory;

        document.getElementById('editEventId').value = eventId;
        document.getElementById('editEventTitle').value = eventTitle;
        document.getElementById('editEventDate').value = eventDate;
        document.getElementById('editEventLocation').value = eventLocation;
        document.getElementById('editEventDescription').value = eventDescription;
        document.getElementById('editEventCategory').value = eventCategory;

        // Update rich text editor content
        updateEditEventModal(btn);

        editEventModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeEditEventModal() {
        editEventModal.classList.add('hidden');
        document.body.style.overflow = 'auto';
        editEventForm.reset();
        clearEditEventEditor();
      }

      function showLoading() {
        loadingOverlay.classList.remove('hidden');
      }

      function hideLoading() {
        loadingOverlay.classList.add('hidden');
      }

      async function handleAddEvent(e) {
        e.preventDefault();
        showLoading();

        try {
          const formData = new FormData(addEventForm);
          
          const response = await fetch('/api/admin/events?action=create', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            closeAddEventModal();
            window.location.reload();
          } else {
            alert('Error creating event: ' + (result.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error creating event:', error);
          alert('Error creating event. Please try again.');
        } finally {
          hideLoading();
        }
      }

      async function handleEditEvent(e) {
        e.preventDefault();
        showLoading();

        try {
          const formData = new FormData(editEventForm);
          
          const response = await fetch('/api/admin/events?action=update', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            closeEditEventModal();
            window.location.reload();
          } else {
            alert('Error updating event: ' + (result.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error updating event:', error);
          alert('Error updating event. Please try again.');
        } finally {
          hideLoading();
        }
      }

      async function toggleEventStatus(eventId, currentStatus) {
        showLoading();

        try {
          const formData = new FormData();
          formData.append('id', eventId);
          formData.append('active', !currentStatus);
          
          const response = await fetch('/api/admin/events?action=toggle-status', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            window.location.reload();
          } else {
            alert('Error updating event status: ' + (result.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error updating event status:', error);
          alert('Error updating event status. Please try again.');
        } finally {
          hideLoading();
        }
      }

      async function loadEventImages() {
        imagesLoading.classList.remove('hidden');
        imagesGrid.innerHTML = '';

        try {
          const response = await fetch(`/api/admin/events?event_id=${currentEventId}`);
          const result = await response.json();

          if (result.success) {
            displayImages(result.images || []);
          } else {
            console.error('Error loading images:', result.error);
          }
        } catch (error) {
          console.error('Error loading images:', error);
        } finally {
          imagesLoading.classList.add('hidden');
        }
      }

      function displayImages(images) {
        imagesGrid.innerHTML = '';

        images.forEach(image => {
          const imageDiv = document.createElement('div');
          imageDiv.className = 'relative group bg-slate-100 rounded-xl overflow-hidden aspect-square';
          
          imageDiv.innerHTML = `
            <img src="${image.image_url}" alt="${image.image_alt || ''}" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center gap-2">
              <button 
                class="set-primary-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-lg transition-colors ${image.is_cover ? 'bg-green-600 hover:bg-green-700' : ''}"
                data-image-id="${image.id}"
                title="${image.is_cover ? 'Primary Image' : 'Set as Primary'}"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </button>
              <button 
                class="delete-image-btn bg-red-600 hover:bg-red-700 text-white p-2 rounded-lg transition-colors"
                data-image-id="${image.id}"
                title="Delete Image"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
            ${image.is_cover ? '<div class="absolute top-2 left-2 bg-green-600 text-white px-2 py-1 rounded-lg text-xs font-medium">Primary</div>' : ''}
          `;

          imagesGrid.appendChild(imageDiv);
        });

        // Add event listeners for image actions
        document.querySelectorAll('.set-primary-btn').forEach(btn => {
          btn.addEventListener('click', () => setPrimaryImage(btn.dataset.imageId));
        });

        // Note: delete-image-btn listeners are handled by the main document event listener
      }

      async function handleImageUpload(e) {
        const files = Array.from(e.target.files);
        if (files.length === 0) return;

        showLoading();

        try {
          const formData = new FormData();
          formData.append('event_id', currentEventId);
          
          files.forEach(file => {
            formData.append('images', file);
          });

          const response = await fetch('/api/admin/events?action=upload-images', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            loadEventImages(); // Reload images
            imageUpload.value = ''; // Clear file input
          } else {
            alert('Error uploading images: ' + (result.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error uploading images:', error);
          alert('Error uploading images. Please try again.');
        } finally {
          hideLoading();
        }
      }

      async function setPrimaryImage(imageId) {
        showLoading();

        try {
          const formData = new FormData();
          formData.append('event_id', currentEventId);
          formData.append('image_id', imageId);

          const response = await fetch('/api/admin/events?action=set-primary-image', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            loadEventImages(); // Reload images
          } else {
            alert('Error setting primary image: ' + (result.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error setting primary image:', error);
          alert('Error setting primary image. Please try again.');
        } finally {
          hideLoading();
        }
      }

      async function deleteImage(imageId) {
        if (!confirm('Are you sure you want to delete this image?')) return;

        showLoading();

        try {
          const formData = new FormData();
          formData.append('image_id', imageId);

          const response = await fetch('/api/admin/events?action=delete-image', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            loadEventImages(); // Reload images
          } else {
            alert('Error deleting image: ' + (result.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error deleting image:', error);
          alert('Error deleting image. Please try again.');
        } finally {
          hideLoading();
        }
      }

      async function deleteEvent(eventId, eventTitle) {
        if (!confirm(`Are you sure you want to delete "${eventTitle}"? This will also delete all associated images.`)) return;

        showLoading();

        try {
          const formData = new FormData();
          formData.append('id', eventId);

          const response = await fetch('/api/admin/events?action=delete', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (result.success) {
            window.location.reload();
          } else {
            alert('Error deleting event: ' + (result.error || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error deleting event:', error);
          alert('Error deleting event. Please try again.');
        } finally {
          hideLoading();
        }
      }

      // Close modals on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (!addEventModal.classList.contains('hidden')) {
            closeAddEventModal();
          } else if (!editEventModal.classList.contains('hidden')) {
            closeEditEventModal();
        } else if (!imageModal.classList.contains('hidden')) {
          closeImageModal();
        }
      }
    });

    // Close modals on backdrop click
    addEventModal?.addEventListener('click', (e) => {
      if (e.target === addEventModal) {
        closeAddEventModal();
      }
    });

    editEventModal?.addEventListener('click', (e) => {
      if (e.target === editEventModal) {
        closeEditEventModal();
      }
    });

    imageModal?.addEventListener('click', (e) => {
      if (e.target === imageModal) {
        closeImageModal();
      }
    });

    }); // End of DOMContentLoaded
  </script>

  <!-- Pell Rich Text Editor -->
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/pell@1.0.6/dist/pell.min.css">
  
  <script is:inline>
    // Ensure window object exists for Pell
    if (typeof window !== 'undefined') {
      window.pell = window.pell || {};
    }
  </script>
  
  <script src="https://cdn.jsdelivr.net/npm/pell@1.0.6/dist/pell.min.js" defer></script>
  
  <script is:inline>
    // Rich Text Editor Setup
    let addEventEditor = null;
    let editEventEditor = null;

    // Wait for both DOM and Pell to be loaded
    function initializeRichTextEditors() {
      console.log('Initializing rich text editors...');
      
      // Check if pell is loaded with timeout
      let attempts = 0;
      const maxAttempts = 50;
      
      const checkPell = () => {
        attempts++;
        console.log(`Checking for pell... attempt ${attempts}`);
        
        if (typeof window.pell !== 'undefined') {
          console.log('Pell loaded successfully');
          
          // Initialize Add Event Editor
          const addEventDescriptionEditor = document.getElementById('addEventDescriptionEditor');
          if (addEventDescriptionEditor) {
            console.log('Add Event Editor element found, initializing...');
            try {
              addEventEditor = window.pell.init({
                 element: addEventDescriptionEditor,
                 onChange: html => {
                   document.getElementById('addEventDescription').value = html;
                 },
                 defaultParagraphSeparator: 'div',
                 styleWithCSS: true,
                 actions: [
                   'bold',
                   'italic',
                   'underline',
                   'strikethrough',
                   {
                     name: 'heading1',
                     icon: '<b>H1</b>',
                     title: 'Heading 1',
                     result: () => window.pell.exec('formatBlock', '<h1>')
                   },
                   {
                     name: 'heading2',
                     icon: '<b>H2</b>',
                     title: 'Heading 2',
                     result: () => window.pell.exec('formatBlock', '<h2>')
                   },
                   'paragraph',
                   'quote',
                   {
                     name: 'olist',
                     icon: '1.',
                     title: 'Ordered List',
                     result: () => window.pell.exec('insertOrderedList')
                   },
                   {
                     name: 'ulist',
                     icon: '•',
                     title: 'Unordered List',
                     result: () => window.pell.exec('insertUnorderedList')
                   },
                   {
                     name: 'code',
                     icon: '&lt;/&gt;',
                     title: 'Code',
                     result: () => window.pell.exec('formatBlock', '<pre>')
                   },
                   'line',
                   'link',
                   'image'
                 ],
                 classes: {
                   actionbar: 'pell-actionbar',
                   button: 'pell-button',
                   content: 'pell-content',
                   selected: 'pell-button-selected'
                 }
               });
              console.log('Add Event Editor initialized successfully');
            } catch (error) {
              console.error('Error initializing Add Event Editor:', error);
            }
          }
          
          // Initialize Edit Event Editor
          const editEventDescriptionEditor = document.getElementById('editEventDescriptionEditor');
          if (editEventDescriptionEditor) {
            console.log('Edit Event Editor element found, initializing...');
            try {
              editEventEditor = window.pell.init({
                 element: editEventDescriptionEditor,
                 onChange: html => {
                   document.getElementById('editEventDescription').value = html;
                 },
                 defaultParagraphSeparator: 'div',
                 styleWithCSS: true,
                 actions: [
                   'bold',
                   'italic',
                   'underline',
                   'strikethrough',
                   {
                     name: 'heading1',
                     icon: '<b>H1</b>',
                     title: 'Heading 1',
                     result: () => window.pell.exec('formatBlock', '<h1>')
                   },
                   {
                     name: 'heading2',
                     icon: '<b>H2</b>',
                     title: 'Heading 2',
                     result: () => window.pell.exec('formatBlock', '<h2>')
                   },
                   'paragraph',
                   'quote',
                   {
                     name: 'olist',
                     icon: '1.',
                     title: 'Ordered List',
                     result: () => window.pell.exec('insertOrderedList')
                   },
                   {
                     name: 'ulist',
                     icon: '•',
                     title: 'Unordered List',
                     result: () => window.pell.exec('insertUnorderedList')
                   },
                   {
                     name: 'code',
                     icon: '&lt;/&gt;',
                     title: 'Code',
                     result: () => window.pell.exec('formatBlock', '<pre>')
                   },
                   'line',
                   'link',
                   'image'
                 ],
                 classes: {
                   actionbar: 'pell-actionbar',
                   button: 'pell-button',
                   content: 'pell-content',
                   selected: 'pell-button-selected'
                 }
               });
              console.log('Edit Event Editor initialized successfully');
            } catch (error) {
              console.error('Error initializing Edit Event Editor:', error);
            }
          }
          
        } else if (attempts < maxAttempts) {
          console.log('Pell not loaded yet, retrying...');
          setTimeout(checkPell, 100);
        } else {
          console.error('Pell failed to load after maximum attempts');
        }
      };
      
      checkPell();
    }

    document.addEventListener('DOMContentLoaded', function() {
      // Initialize rich text editors after DOM is loaded
      initializeRichTextEditors();
    });

    // Update the openEditEventModal function to set editor content
    function updateEditEventModal(btn) {
      const eventDescription = btn.dataset.eventDescription || '';
      
      // Set the hidden textarea value
      const textarea = document.getElementById('editEventDescription');
      if (textarea) {
        textarea.value = eventDescription;
      }
      
      // Set the rich text editor content
      setTimeout(() => {
        if (editEventEditor && editEventEditor.content) {
          editEventEditor.content.innerHTML = eventDescription;
        }
      }, 100);
    }

    // Update the closeAddEventModal function to clear editor content
    function clearAddEventEditor() {
      if (addEventEditor && addEventEditor.content) {
        addEventEditor.content.innerHTML = '';
      }
      const textarea = document.querySelector('#addEventForm textarea[name="description"]');
      if (textarea) {
        textarea.value = '';
      }
    }

    // Update the closeEditEventModal function to clear editor content
    function clearEditEventEditor() {
      if (editEventEditor && editEventEditor.content) {
        editEventEditor.content.innerHTML = '';
      }
      const textarea = document.getElementById('editEventDescription');
      if (textarea) {
        textarea.value = '';
      }
    }
  </script>

  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</Layout>