---
import Layout from '../../layouts/Layout.astro';
import { supabaseAdmin } from '../../lib/supabase-admin';

// Check authentication
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}

// Fetch analytics data
let dashboardData = {
  totalForms: 0,
  totalResponses: 0,
  averageRating: 0,
  responseRate: 0,
  recentActivity: [],
  topPerformingForms: [],
  ratingDistribution: {},
  responsesTrend: [],
  activeFormsCount: 0
};

try {
  // Get total forms count
  const { count: formsCount } = await supabaseAdmin
    .from('review_forms')
    .select('*', { count: 'exact', head: true })
    .eq('created_by', user.id);
  
  dashboardData.totalForms = formsCount || 0;

  // Get total responses count
  const { count: responsesCount } = await supabaseAdmin
    .from('form_responses')
    .select('*', { count: 'exact', head: true })
    .in('form_id', 
      (await supabaseAdmin
        .from('review_forms')
        .select('id')
        .eq('created_by', user.id)
      ).data?.map(f => f.id) || []
    );
  
  dashboardData.totalResponses = responsesCount || 0;

  // Get active forms count
  const { count: activeFormsCount } = await supabaseAdmin
    .from('review_forms')
    .select('*', { count: 'exact', head: true })
    .eq('created_by', user.id)
    .eq('active', true);
  
  dashboardData.activeFormsCount = activeFormsCount || 0;

  // Calculate response rate
  dashboardData.responseRate = dashboardData.totalForms > 0 
    ? Math.round((dashboardData.totalResponses / dashboardData.totalForms) * 100) / 100 
    : 0;

  // Get recent activity (last 10 responses)
  const { data: recentResponses } = await supabaseAdmin
    .from('form_responses')
    .select(`
      id,
      created_at,
      review_forms!inner(name, id)
    `)
    .in('form_id', 
      (await supabaseAdmin
        .from('review_forms')
        .select('id')
        .eq('created_by', user.id)
      ).data?.map(f => f.id) || []
    )
    .order('created_at', { ascending: false })
    .limit(10);

  dashboardData.recentActivity = recentResponses || [];

  // Get top performing forms
  const { data: topForms } = await supabaseAdmin
    .from('review_forms')
    .select(`
      id,
      name,
      form_responses(count)
    `)
    .eq('created_by', user.id)
    .order('created_at', { ascending: false })
    .limit(5);

  dashboardData.topPerformingForms = topForms || [];

} catch (error) {
  console.error('Error fetching dashboard data:', error);
}
---

<Layout title="Analytics Dashboard - LbisTech">
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Analytics Dashboard</h1>
            <p class="mt-1 text-sm text-gray-500">Real-time insights and comprehensive analytics</p>
          </div>
          <div class="flex space-x-3">
            <button id="refreshData" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-coral-600 hover:bg-coral-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-coral-500 transition-colors">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              Refresh Data
            </button>
            <button id="exportReport" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-coral-500 transition-colors">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Export Report
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Real-time Status Bar -->
      <div class="mb-8">
        <div class="bg-white rounded-lg shadow-sm border p-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse mr-2"></div>
                <span class="text-sm font-medium text-gray-700">Live Dashboard</span>
              </div>
              <div class="text-sm text-gray-500">
                Last updated: <span id="lastUpdated">Just now</span>
              </div>
            </div>
            <div class="flex items-center space-x-6">
              <div class="text-center">
                <div class="text-2xl font-bold text-green-600" id="liveResponseCount">{dashboardData.totalResponses}</div>
                <div class="text-xs text-gray-500">Total Responses</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-blue-600" id="activeFormsCount">{dashboardData.activeFormsCount}</div>
                <div class="text-xs text-gray-500">Active Forms</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Key Metrics Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Total Forms -->
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg shadow-lg p-6 text-white transform hover:scale-105 transition-transform duration-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-blue-100 text-sm font-medium">Total Forms</p>
              <p class="text-3xl font-bold">{dashboardData.totalForms}</p>
            </div>
            <div class="bg-blue-400 bg-opacity-30 rounded-full p-3">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
                <path fill-rule="evenodd" d="M4 5a2 2 0 012-2v1a1 1 0 001 1h6a1 1 0 001-1V3a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Total Responses -->
        <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-lg shadow-lg p-6 text-white transform hover:scale-105 transition-transform duration-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-green-100 text-sm font-medium">Total Responses</p>
              <p class="text-3xl font-bold">{dashboardData.totalResponses}</p>
            </div>
            <div class="bg-green-400 bg-opacity-30 rounded-full p-3">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Average Rating -->
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-lg shadow-lg p-6 text-white transform hover:scale-105 transition-transform duration-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-yellow-100 text-sm font-medium">Average Rating</p>
              <p class="text-3xl font-bold">{dashboardData.averageRating.toFixed(1)}</p>
            </div>
            <div class="bg-yellow-400 bg-opacity-30 rounded-full p-3">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Response Rate -->
        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-lg shadow-lg p-6 text-white transform hover:scale-105 transition-transform duration-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-purple-100 text-sm font-medium">Response Rate</p>
              <p class="text-3xl font-bold">{dashboardData.responseRate}%</p>
            </div>
            <div class="bg-purple-400 bg-opacity-30 rounded-full p-3">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
        <!-- Response Trends Chart -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Response Trends</h3>
            <div class="flex space-x-2">
              <button class="px-3 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors" data-period="7d">7D</button>
              <button class="px-3 py-1 text-xs font-medium text-white bg-coral-600 rounded-md hover:bg-coral-700 transition-colors" data-period="30d">30D</button>
              <button class="px-3 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors" data-period="90d">90D</button>
            </div>
          </div>
          <div class="h-64">
            <canvas id="responseTrendsChart"></canvas>
          </div>
        </div>

        <!-- Rating Distribution Chart -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Rating Distribution</h3>
            <div class="text-sm text-gray-500">Last 30 days</div>
          </div>
          <div class="h-64">
            <canvas id="ratingDistributionChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Detailed Analytics Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Recent Activity -->
        <div class="lg:col-span-2 bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Activity</h3>
          <div class="space-y-4">
            {dashboardData.recentActivity.length > 0 ? (
              dashboardData.recentActivity.map((activity) => (
                <div class="flex items-center space-x-4 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                  <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                      <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900">
                      New response for "{activity.review_forms.name}"
                    </p>
                    <p class="text-sm text-gray-500">
                      {new Date(activity.created_at).toLocaleDateString()} at {new Date(activity.created_at).toLocaleTimeString()}
                    </p>
                  </div>
                </div>
              ))
            ) : (
              <div class="text-center py-8">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No recent activity</h3>
                <p class="mt-1 text-sm text-gray-500">Get started by creating your first form.</p>
              </div>
            )}
          </div>
        </div>

        <!-- Top Performing Forms -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Top Performing Forms</h3>
          <div class="space-y-4">
            {dashboardData.topPerformingForms.length > 0 ? (
              dashboardData.topPerformingForms.map((form, index) => (
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                  <div class="flex items-center space-x-3">
                    <div class="flex-shrink-0">
                      <div class={`w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold ${
                        index === 0 ? 'bg-yellow-500' : 
                        index === 1 ? 'bg-gray-400' : 
                        index === 2 ? 'bg-orange-500' : 'bg-blue-500'
                      }`}>
                        {index + 1}
                      </div>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-gray-900">{form.name}</p>
                      <p class="text-xs text-gray-500">{form.form_responses?.length || 0} responses</p>
                    </div>
                  </div>
                </div>
              ))
            ) : (
              <div class="text-center py-4">
                <p class="text-sm text-gray-500">No forms available</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <script>
    // Initialize charts and real-time features
    document.addEventListener('DOMContentLoaded', function() {
      // Response Trends Chart
      const responseTrendsCtx = document.getElementById('responseTrendsChart').getContext('2d');
      const responseTrendsChart = new Chart(responseTrendsCtx, {
        type: 'line',
        data: {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
          datasets: [{
            label: 'Responses',
            data: [12, 19, 3, 5, 2, 3],
            borderColor: 'rgb(239, 68, 68)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.1)'
              }
            },
            x: {
              grid: {
                display: false
              }
            }
          }
        }
      });

      // Rating Distribution Chart
      const ratingDistributionCtx = document.getElementById('ratingDistributionChart').getContext('2d');
      const ratingDistributionChart = new Chart(ratingDistributionCtx, {
        type: 'doughnut',
        data: {
          labels: ['5 Stars', '4 Stars', '3 Stars', '2 Stars', '1 Star'],
          datasets: [{
            data: [40, 30, 15, 10, 5],
            backgroundColor: [
              '#10B981',
              '#3B82F6',
              '#F59E0B',
              '#EF4444',
              '#6B7280'
            ],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                padding: 20,
                usePointStyle: true
              }
            }
          }
        }
      });

      // Real-time updates
      function updateLastUpdated() {
        document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();
      }

      // Update every 30 seconds
      setInterval(updateLastUpdated, 30000);

      // Refresh data button
      document.getElementById('refreshData').addEventListener('click', function() {
        // Add loading state
        this.innerHTML = '<svg class="animate-spin w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Refreshing...';
        
        // Simulate data refresh
        setTimeout(() => {
          location.reload();
        }, 1000);
      });

      // Export report button
      document.getElementById('exportReport').addEventListener('click', function() {
        // Implement export functionality
        alert('Export functionality will be implemented in the next phase');
      });
    });
  </script>
</Layout>