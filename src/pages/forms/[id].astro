---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase.ts';

export const prerender = false;

const { id } = Astro.params;

// Fetch form data
let form = null;
let fields = [];
let error = null;

if (id) {
  try {
    // Get form template
    const { data: formData, error: formError } = await supabase
      .from('form_templates')
      .select('*')
      .eq('id', id)
      .eq('is_active', true)
      .single();

    if (formError) throw formError;

    // Get form fields
    const { data: fieldsData, error: fieldsError } = await supabase
      .from('form_fields')
      .select('*')
      .eq('form_id', id)
      .order('field_order');

    if (fieldsError) throw fieldsError;

    form = formData;
    fields = fieldsData || [];
  } catch (err) {
    console.error('Error fetching form:', err);
    error = 'Form not found or inactive';
  }
}

if (!form) {
  return Astro.redirect('/404');
}
---

<Layout title={`${form.name} - LbisTech`}>
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
        <!-- Form Header -->
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-gray-900 mb-4">{form.name}</h1>
          {form.description && (
            <p class="text-gray-600 text-lg">{form.description}</p>
          )}
        </div>

        <!-- Form -->
        <form id="public-form" class="space-y-6">
          {fields.map((field, index) => (
            <div class="form-group">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {field.label}
                {field.is_required && <span class="text-red-500 ml-1">*</span>}
              </label>
              
              {field.field_type === 'text' && (
                <input 
                  type="text" 
                  name={`field_${field.id}`}
                  placeholder={field.placeholder || ''}
                  required={field.is_required}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral-500 focus:border-coral-500 transition-colors"
                />
              )}
              
              {field.field_type === 'textarea' && (
                <textarea 
                  name={`field_${field.id}`}
                  placeholder={field.placeholder || ''}
                  required={field.is_required}
                  rows="4"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral-500 focus:border-coral-500 transition-colors"
                ></textarea>
              )}
              
              {field.field_type === 'dropdown' && (
                <select 
                  name={`field_${field.id}`}
                  required={field.is_required}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral-500 focus:border-coral-500 transition-colors"
                >
                  <option value="">Select an option</option>
                  {field.options && field.options.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              )}
              
              {field.field_type === 'multiple_choice' && (
                <div class="space-y-3">
                  {field.options && field.options.map((option) => (
                    <div class="flex items-center">
                      <input 
                        type="radio" 
                        name={`field_${field.id}`}
                        value={option}
                        required={field.is_required}
                        class="h-4 w-4 text-coral-600 focus:ring-coral-500 border-gray-300"
                      />
                      <label class="ml-3 text-sm text-gray-700">{option}</label>
                    </div>
                  ))}
                </div>
              )}
              
              {field.field_type === 'checkbox' && (
                <div class="flex items-center">
                  <input 
                    type="checkbox" 
                    name={`field_${field.id}`}
                    value="checked"
                    required={field.is_required}
                    class="h-4 w-4 text-coral-600 focus:ring-coral-500 border-gray-300 rounded"
                  />
                  <label class="ml-3 text-sm text-gray-700">Check this option</label>
                </div>
              )}
              
              {field.field_type === 'rating' && (
                <div class="flex space-x-2" data-rating-field={`field_${field.id}`}>
                  {[1, 2, 3, 4, 5].map((rating) => (
                    <button 
                      type="button" 
                      class="rating-star text-gray-300 hover:text-yellow-400 focus:text-yellow-400 transition-colors"
                      data-rating={rating}
                    >
                      <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                      </svg>
                    </button>
                  ))}
                  <input type="hidden" name={`field_${field.id}`} required={field.is_required} />
                </div>
              )}
              
              {field.field_type === 'date' && (
                <input 
                  type="date" 
                  name={`field_${field.id}`}
                  required={field.is_required}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral-500 focus:border-coral-500 transition-colors"
                />
              )}
              
              {field.field_type === 'number' && (
                <input 
                  type="number" 
                  name={`field_${field.id}`}
                  placeholder={field.placeholder || ''}
                  required={field.is_required}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-coral-500 focus:border-coral-500 transition-colors"
                />
              )}
            </div>
          ))}
          
          <!-- Submit Button -->
          <div class="pt-6">
            <button 
              type="submit" 
              class="w-full bg-coral-500 hover:bg-coral-600 text-white font-medium py-4 px-6 rounded-lg transition-colors focus:ring-2 focus:ring-coral-500 focus:ring-offset-2"
            >
              Submit Form
            </button>
          </div>
        </form>
        
        <!-- Success Message -->
        <div id="success-message" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg">
          <div class="flex">
            <svg class="w-5 h-5 text-green-400 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <div>
              <h3 class="text-sm font-medium text-green-800">Form submitted successfully!</h3>
              <p class="text-sm text-green-700 mt-1">Thank you for your submission.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ formId: id }}>
    // Rating functionality
    document.querySelectorAll('[data-rating-field]').forEach(ratingGroup => {
      const stars = ratingGroup.querySelectorAll('.rating-star');
      const hiddenInput = ratingGroup.querySelector('input[type="hidden"]');
      
      stars.forEach((star, index) => {
        star.addEventListener('click', () => {
          const rating = parseInt(star.dataset.rating);
          hiddenInput.value = rating;
          
          // Update star colors
          stars.forEach((s, i) => {
            if (i < rating) {
              s.classList.remove('text-gray-300');
              s.classList.add('text-yellow-400');
            } else {
              s.classList.remove('text-yellow-400');
              s.classList.add('text-gray-300');
            }
          });
        });
      });
    });

    // Form submission
    document.getElementById('public-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const submissionData = {};
      
      // Convert FormData to object
      for (let [key, value] of formData.entries()) {
        submissionData[key] = value;
      }
      
      try {
        const response = await fetch('/api/forms/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
              form_id: formId,
              submission_data: submissionData
            })
        });
        
        if (response.ok) {
          document.getElementById('public-form').style.display = 'none';
          document.getElementById('success-message').classList.remove('hidden');
        } else {
          alert('Error submitting form. Please try again.');
        }
      } catch (error) {
        console.error('Error submitting form:', error);
        alert('Error submitting form. Please try again.');
      }
    });
  </script>
</Layout>