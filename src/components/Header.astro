---
const currentPath = Astro.url.pathname;
---

<header class="bg-white shadow-lg sticky top-0 z-50">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-gradient-to-br from-primary-900 to-primary-700 rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">L</span>
        </div>
        <span class="text-2xl font-bold text-primary-900">LbisTech</span>
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class={`hover:text-coral-500 transition-colors ${currentPath === '/' ? 'text-coral-500 font-semibold' : 'text-gray-700'}`}>
          Home
        </a>
        <a href="/courses" class={`hover:text-coral-500 transition-colors ${currentPath === '/courses' ? 'text-coral-500 font-semibold' : 'text-gray-700'}`}>
          Courses
        </a>
        <a href="/blog" class={`hover:text-coral-500 transition-colors ${currentPath.startsWith('/blog') ? 'text-coral-500 font-semibold' : 'text-gray-700'}`}>
          Blog
        </a>
        <a href="/trainers" class={`hover:text-coral-500 transition-colors ${currentPath === '/trainers' ? 'text-coral-500 font-semibold' : 'text-gray-700'}`}>
          Trainers
        </a>
        
        <!-- About Dropdown -->
        <div class="relative group">
          <button class={`hover:text-coral-500 transition-colors flex items-center ${currentPath === '/about' || currentPath === '/events' || currentPath === '/our-success' ? 'text-coral-500 font-semibold' : 'text-gray-700'}`}>
            About
            <svg class="w-4 h-4 ml-1 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="py-2">
              <a href="/about" class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-coral-500 transition-colors">
                About Us
              </a>
              <a href="/events" class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-coral-500 transition-colors">
                Events
              </a>
              <a href="/our-success" class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-coral-500 transition-colors">
                Our Success
              </a>
            </div>
          </div>
        </div>
        
        <a href="/contact" class={`hover:text-coral-500 transition-colors ${currentPath === '/contact' ? 'text-coral-500 font-semibold' : 'text-gray-700'}`}>
          Contact
        </a>
        
        {Astro.locals.user ? (
          <div class="flex items-center space-x-4">
            <a href="/dashboard" class="text-gray-700 hover:text-coral-500 transition-colors">
              Dashboard
            </a>
            <div class="w-8 h-8 bg-coral-500 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">
                {Astro.locals.user.first_name[0]}{Astro.locals.user.last_name[0]}
              </span>
            </div>
          </div>
        ) : (
          <div class="flex items-center space-x-4">
            <a href="/auth/login" class="text-gray-700 hover:text-coral-500 transition-colors">
              Sign In
            </a>
            <a href="/auth/signup" class="bg-coral-500 hover:bg-coral-600 text-white px-6 py-2 rounded-lg transition-colors">
              Get Started
            </a>
          </div>
        )}
      </div>
      
      <!-- Mobile Menu Button -->
      <button id="mobile-menu-button" class="md:hidden text-gray-700 hover:text-coral-500">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    
    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t">
      <div class="flex flex-col space-y-3 pt-4">
        <a href="/" class="text-gray-700 hover:text-coral-500 py-2">Home</a>
        <a href="/courses" class="text-gray-700 hover:text-coral-500 py-2">Courses</a>
        <a href="/blog" class="text-gray-700 hover:text-coral-500 py-2">Blog</a>
        <a href="/trainers" class="text-gray-700 hover:text-coral-500 py-2">Trainers</a>
        
        <!-- About Section -->
        <div class="py-2">
          <div class="text-gray-700 font-semibold mb-2">About</div>
          <div class="pl-4 space-y-2">
            <a href="/about" class="block text-gray-600 hover:text-coral-500 py-1">About Us</a>
            <a href="/events" class="block text-gray-600 hover:text-coral-500 py-1">Events</a>
            <a href="/our-success" class="block text-gray-600 hover:text-coral-500 py-1">Our Success</a>
          </div>
        </div>
        
        <a href="/contact" class="text-gray-700 hover:text-coral-500 py-2">Contact</a>
        
        {Astro.locals.user ? (
          <div class="space-y-2">
            <a href="/dashboard" class="text-gray-700 hover:text-coral-500 py-2 block">Dashboard</a>
            <div class="text-sm text-gray-500 py-2">
              Signed in as {Astro.locals.user.first_name} {Astro.locals.user.last_name}
            </div>
          </div>
        ) : (
          <div class="space-y-2">
            <a href="/auth/login" class="text-gray-700 hover:text-coral-500 py-2 block">Sign In</a>
            <a href="/auth/signup" class="bg-coral-500 hover:bg-coral-600 text-white px-4 py-2 rounded-lg text-center block">
              Get Started
            </a>
          </div>
        )}
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>