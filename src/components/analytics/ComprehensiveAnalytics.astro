        <!-- Opportunities -->
        <div class="bg-yellow-50 rounded-lg p-4">
          <div class="flex items-center mb-3">
            <svg class="w-6 h-6 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
            </svg>
            <h4 class="text-lg font-semibold text-yellow-800">Opportunities</h4>
          </div>
          <ul class="space-y-2 text-sm text-yellow-700">
            <li>• Increase response rates on weekends</li>
            <li>• Focus on 3-star rating improvements</li>
            <li>• Expand mobile accessibility</li>
            <li>• Enhance follow-up processes</li>
          </ul>
        </div>

        <!-- Recommendations -->
        <div class="bg-blue-50 rounded-lg p-4">
          <div class="flex items-center mb-3">
            <svg class="w-6 h-6 text-blue-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
            </svg>
            <h4 class="text-lg font-semibold text-blue-800">Recommendations</h4>
          </div>
          <ul class="space-y-2 text-sm text-blue-700">
            <li>• Implement automated reminders</li>
            <li>• Add incentives for completion</li>
            <li>• Create targeted improvement plans</li>
            <li>• Schedule regular review cycles</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
if (typeof window !== 'undefined') {
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize trend charts
    const trendsData = [];
    
    if (document.getElementById('responseTrendsChart')) {
      const ctx = document.getElementById('responseTrendsChart').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: {
          datasets: [{
            label: 'Daily Responses',
            data: trendsData,
            borderColor: '#3B82F6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            x: {
              type: 'time',
              time: {
                unit: 'day'
              }
            },
            y: {
              beginAtZero: true
            }
          }
        }
      });
    }

    if (document.getElementById('dailyTrendsChart')) {
      const dailyCtx = document.getElementById('dailyTrendsChart').getContext('2d');
      new Chart(dailyCtx, {
        type: 'bar',
        data: {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          datasets: [{
            label: 'Responses by Day',
            data: [12, 15, 18, 14, 16, 8, 6],
            backgroundColor: [
              '#EF4444',
              '#F97316',
              '#EAB308',
              '#22C55E',
              '#3B82F6',
              '#8B5CF6',
              '#EC4899'
            ],
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            y: {
              beginAtZero: true
            }
          }
        }
      });
    }
  });
}
</script>

<style>
.analytics-section {
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.comprehensive-analytics {
  max-width: 100%;
  overflow-x: hidden;
}

canvas {
  max-width: 100%;
  height: auto;
}
</style>