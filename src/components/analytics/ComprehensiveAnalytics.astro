        <div class="col-span-1">
          <h4 class="text-lg font-semibold text-gray-800 mb-4">Rating Distribution</h4>
          <div class="space-y-3">
            {[5, 4, 3, 2, 1].map(rating => (
              <div class="flex items-center space-x-3">
