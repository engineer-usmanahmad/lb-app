        <!-- Average Time -->
        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-lg p-4 text-white">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-purple-100 text-sm">Avg. Time</p>
              <p class="text-2xl font-bold">{analyticsData.responseAnalysis.averageTimeToComplete || 'N/A'}</p>
            </div>
            <svg class="w-8 h-8 text-purple-200" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>

        <!-- Response Rate -->
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 rounded-lg p-4 text-white">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-orange-100 text-sm">Response Rate</p>
              <p class="text-2xl font-bold">{Math.round(analyticsData.responseAnalysis.completionRate * 0.8)}%</p>
            </div>
            <svg class="w-8 h-8 text-orange-200" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Response Trends Chart -->
      <div class="mb-6">
        <h4 class="text-lg font-semibold text-gray-800 mb-4">Response Trends</h4>
        <div class="h-64 bg-gray-50 rounded-lg flex items-center justify-center">
          <canvas id="responseTrendsChart" class="w-full h-full"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Trend Analysis Section -->
  <div class="analytics-section mb-8">
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="text-xl font-bold text-gray-900 mb-6">Trend Analysis</h3>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Daily Trends -->
        <div>
          <h4 class="text-lg font-semibold text-gray-800 mb-4">Daily Response Pattern</h4>
          <div class="h-48 bg-gray-50 rounded-lg flex items-center justify-center">
            <canvas id="dailyTrendsChart" class="w-full h-full"></canvas>
          </div>
        </div>

        <!-- Growth Metrics -->
        <div>
          <h4 class="text-lg font-semibold text-gray-800 mb-4">Growth Metrics</h4>
          <div class="space-y-4">
            <div class="flex items-center justify-between p-4 bg-green-50 rounded-lg">
              <div>
                <p class="text-sm font-medium text-green-800">Growth Rate</p>
                <p class="text-xs text-green-600">Month over month</p>
              </div>
              <div class="text-2xl font-bold text-green-600">+{analyticsData.trendAnalysis.growthRate || 15}%</div>
            </div>
            
            <div class="flex items-center justify-between p-4 bg-blue-50 rounded-lg">
              <div>
                <p class="text-sm font-medium text-blue-800">Peak Response Time</p>
                <p class="text-xs text-blue-600">Most active period</p>
              </div>
              <div class="text-lg font-bold text-blue-600">2:00 PM - 4:00 PM</div>
            </div>
            
            <div class="flex items-center justify-between p-4 bg-purple-50 rounded-lg">
              <div>
                <p class="text-sm font-medium text-purple-800">Best Day</p>
                <p class="text-xs text-purple-600">Highest response rate</p>
              </div>
              <div class="text-lg font-bold text-purple-600">Wednesday</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Performance Insights -->
  <div class="analytics-section">
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h3 class="text-xl font-bold text-gray-900 mb-6">Performance Insights</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Strengths -->
        <div class="bg-green-50 rounded-lg p-4">
          <div class="flex items-center mb-3">
            <svg class="w-6 h-6 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <h4 class="text-lg font-semibold text-green-800">Strengths</h4>
