                  </svg>
                </div>
                <div class="flex-1">
                  <div class="bg-gray-200 rounded-full h-2">
                    <div 
                      class={`h-2 rounded-full ${
                        rating === 5 ? 'bg-green-500' :
                        rating === 4 ? 'bg-blue-500' :
                        rating === 3 ? 'bg-yellow-500' :
                        rating === 2 ? 'bg-orange-500' : 'bg-red-500'
