              <p class="text-2xl font-bold">{analyticsData.responseAnalysis.totalResponses}</p>
            </div>
            <svg class="w-8 h-8 text-blue-200" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7z" clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>

        <!-- Completion Rate -->
        <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-lg p-4 text-white">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-green-100 text-sm">Completion Rate</p>
              <p class="text-2xl font-bold">{analyticsData.responseAnalysis.completionRate}%</p>
            </div>
            <svg class="w-8 h-8 text-green-200" fill="currentColor" viewBox="0 0 20 20">
