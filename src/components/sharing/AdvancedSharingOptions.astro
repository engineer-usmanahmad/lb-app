  .grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .social-share-btn,
  .share-option {
    padding: 12px;
  }
  
  .social-share-btn svg,
  .share-option svg {
    width: 24px;
    height: 24px;
  }
}

@media (max-width: 480px) {
  .grid {
    grid-template-columns: 1fr;
  }
}
</style>