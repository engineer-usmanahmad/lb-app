---
// AnnouncementSlider.astro - Professional course announcement slider
---

<!-- Add top margin to prevent overlap with sticky header -->
<div class="announcement-slider-container relative overflow-hidden mt-0">
  <!-- Slider Wrapper -->
  <div class="slider-wrapper relative h-[600px] lg:h-[500px]">
    
    <!-- Slide 1: AWS 3-in-1 Certification -->
    <div class="slide active" data-slide="1">
      <div class="slide-background bg-gradient-to-br from-[#1e3a5f] to-[#2d4a6d] relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10">
          <div class="aws-pattern absolute top-10 right-10 text-6xl">☁️</div>
          <div class="aws-pattern absolute bottom-20 left-20 text-4xl">🔧</div>
          <div class="aws-pattern absolute top-1/2 right-1/4 text-3xl">⚡</div>
        </div>
        
        <!-- Floating Particles -->
        <div class="particles absolute inset-0">
          <div class="particle particle-1"></div>
          <div class="particle particle-2"></div>
          <div class="particle particle-3"></div>
        </div>
        
        <div class="container mx-auto px-6 h-full flex items-center">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 w-full items-center">
            
            <!-- Left Content (60%) -->
            <div class="lg:col-span-3 text-white z-10">
              <div class="course-tag text-[#ef5753] text-sm uppercase font-semibold mb-4 tracking-wider">
                🎓 COMPREHENSIVE AWS TRAINING
              </div>
              
              <h2 class="text-4xl lg:text-5xl font-bold mb-4 leading-tight">
                Master AWS Cloud with<br>
                <span class="text-[#ef5753]">3-in-1 Certification</span>
              </h2>
              
              <p class="text-xl text-gray-300 mb-2 font-medium">
                Solutions Architect | Developer | SysOps Administrator
              </p>
              
              <p class="text-gray-400 mb-6 text-lg leading-relaxed">
                Complete AWS journey covering all three Associate certifications 
                with hands-on labs and real-world projects.
              </p>
              
              <!-- Features -->
              <div class="features mb-8 space-y-3">
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">3 AWS Certifications in 1 Course</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">50+ Hands-on Labs</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">Real-world Projects</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">Lifetime Access</span>
                </div>
              </div>
              
              <!-- Pricing -->
              <div class="pricing mb-8">
                <span class="original-price text-gray-500 text-lg line-through mr-4">PKR 60,000</span>
                <span class="sale-price text-3xl font-bold text-[#ef5753]">PKR 48,000</span>
              </div>
              
              <!-- Buttons -->
              <div class="buttons flex flex-col sm:flex-row gap-4 mb-6">
                <a href="/enroll/aws-3-in-1" class="enroll-btn bg-gradient-to-r from-[#ef5753] to-[#ff6b6b] text-white px-9 py-4 rounded-full font-semibold text-lg shadow-lg hover:scale-105 transition-all duration-300 text-center inline-block">
                  Enroll Now
                </a>
                <a href="/courses/aws-3-in-1" class="details-btn border-2 border-white/50 text-white px-9 py-4 rounded-full font-medium text-lg hover:bg-white hover:text-[#1e3a5f] transition-all duration-300 text-center inline-block">
                  View Details
                </a>
              </div>
              
              <!-- Urgency Banner -->
              <div class="urgency-banner bg-black/30 backdrop-blur-sm px-4 py-3 rounded-lg border border-white/20">
                <span class="text-yellow-400 mr-2">⏰</span>
                <span class="text-white text-sm font-medium">Limited Seats - Batch Starting Soon!</span>
              </div>
            </div>
            
            <!-- Right Visual (40%) -->
            <div class="lg:col-span-2 relative h-80 lg:h-full flex items-center justify-center">
              <div class="aws-visual relative">
                <!-- AWS Logo -->
                <div class="aws-logo text-6xl lg:text-8xl text-[#ff9900] mb-8 text-center floating-animation">
                  <svg viewBox="0 0 100 60" class="w-24 h-16 lg:w-32 lg:h-20 mx-auto">
                    <path fill="#ff9900" d="M15.7 26.4c0-1.5.1-2.7.4-3.6.2-.9.6-1.8 1.1-2.6.2-.3.3-.6.3-.8 0-.4-.3-.6-.8-.6-.4 0-.8.1-1.2.4-1.9 1.3-2.9 3.3-2.9 6.1 0 2.7.9 4.8 2.8 6.2.4.3.8.4 1.2.4.5 0 .8-.2.8-.6 0-.2-.1-.5-.3-.8-.5-.8-.9-1.7-1.1-2.6-.3-.9-.4-2.1-.4-3.6zm8.9-8.5c-2.4 0-4.3.7-5.8 2.1-.3.3-.5.6-.5 1 0 .3.2.4.5.4.2 0 .5-.1.8-.4 1.2-1 2.6-1.5 4.2-1.5 1.9 0 3.4.6 4.4 1.7 1 1.1 1.5 2.6 1.5 4.4v.8l-5.3.3c-2.8.2-4.9.7-6.4 1.7-1.5 2.2 2.4-2.2 4.2 0 1.6.5 2.9 1.6 3.9 1.1 1 2.4 1.5 4 1.5 1.9 0 3.6-.8 5.1-2.4.2.8.5 1.4.9 1.8.4.4.9.6 1.6.6.4 0 .9-.1 1.4-.3.5-.2.8-.4.8-.7 0-.2-.1-.4-.2-.5-.3-.3-.5-.7-.6-1.2-.1-.5-.2-1.2-.2-2.1v-6.2c0-2.4-.6-4.3-1.9-5.6-1.3-1.3-3.1-2-5.4-2zm2.5 15.1c0 1.5-.5 2.8-1.4 3.8-.9 1-2 1.5-3.2 1.5-1 0-1.8-.3-2.4-.8-.6-.5-.9-1.3-.9-2.2 0-1.1.4-2 1.3-2.6.9-.6 2.2-1 4-1.2l2.6-.2v1.7z"/>
                  </svg>
                </div>
                
                <!-- Certification Badges -->
                <div class="certification-badges absolute -top-4 -right-4 space-y-2">
                  <div class="badge bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full text-xs text-white floating-animation-delayed">
                    Solutions Architect
                  </div>
                  <div class="badge bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full text-xs text-white floating-animation-delayed-2">
                    Developer
                  </div>
                  <div class="badge bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full text-xs text-white floating-animation-delayed-3">
                    SysOps Admin
                  </div>
                </div>
                
                <!-- Service Icons -->
                <div class="service-icons absolute inset-0">
                  <div class="icon ec2 absolute top-0 left-0 text-2xl opacity-60 floating-animation">🖥️</div>
                  <div class="icon s3 absolute top-0 right-0 text-2xl opacity-60 floating-animation-delayed">🗄️</div>
                  <div class="icon lambda absolute bottom-0 left-0 text-2xl opacity-60 floating-animation-delayed-2">⚡</div>
                  <div class="icon rds absolute bottom-0 right-0 text-2xl opacity-60 floating-animation-delayed-3">🗃️</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Slide 2: DevOps Zero to Hero -->
    <div class="slide" data-slide="2">
      <div class="slide-background bg-gradient-to-br from-[#1e3a5f] to-[#2d4a6d] relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10">
          <div class="devops-pattern absolute top-10 right-10 text-6xl">🔄</div>
          <div class="devops-pattern absolute bottom-20 left-20 text-4xl">⚙️</div>
          <div class="devops-pattern absolute top-1/2 right-1/4 text-3xl">🚀</div>
        </div>
        
        <!-- Floating Particles -->
        <div class="particles absolute inset-0">
          <div class="particle particle-1"></div>
          <div class="particle particle-2"></div>
          <div class="particle particle-3"></div>
        </div>
        
        <div class="container mx-auto px-6 h-full flex items-center">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 w-full items-center">
            
            <!-- Left Content (60%) -->
            <div class="lg:col-span-3 text-white z-10">
              <div class="course-tag text-[#ef5753] text-sm uppercase font-semibold mb-4 tracking-wider">
                🚀 COMPLETE DEVOPS TRANSFORMATION
              </div>
              
              <h2 class="text-4xl lg:text-5xl font-bold mb-4 leading-tight">
                DevOps Zero to<br>
                <span class="text-[#ef5753]">Hero Journey</span>
              </h2>
              
              <p class="text-xl text-gray-300 mb-2 font-medium">
                From Basics to Advanced Production Deployments
              </p>
              
              <p class="text-gray-400 mb-6 text-lg leading-relaxed">
                Master complete DevOps lifecycle with CI/CD, containerization, 
                orchestration, and cloud automation.
              </p>
              
              <!-- Features -->
              <div class="features mb-8 space-y-3">
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">12+ DevOps Tools Covered</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">Jenkins, Docker, Kubernetes, Terraform</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">CI/CD Pipeline Implementation</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">Cloud Deployments (AWS/Azure)</span>
                </div>
              </div>
              
              <!-- Pricing -->
              <div class="pricing mb-8">
                <span class="original-price text-gray-500 text-lg line-through mr-4">PKR 75,000</span>
                <span class="sale-price text-3xl font-bold text-[#ef5753]">PKR 60,000</span>
              </div>
              
              <!-- Buttons -->
              <div class="buttons flex flex-col sm:flex-row gap-4 mb-6">
                <a href="/enroll/devops-zero-to-hero" class="enroll-btn bg-gradient-to-r from-[#ef5753] to-[#ff6b6b] text-white px-9 py-4 rounded-full font-semibold text-lg shadow-lg hover:scale-105 transition-all duration-300 text-center inline-block">
                  Enroll Now
                </a>
                <a href="/courses/devops-zero-to-hero" class="details-btn border-2 border-white/50 text-white px-9 py-4 rounded-full font-medium text-lg hover:bg-white hover:text-[#1e3a5f] transition-all duration-300 text-center inline-block">
                  View Details
                </a>
              </div>
              
              <!-- Urgency Banner -->
              <div class="urgency-banner bg-black/30 backdrop-blur-sm px-4 py-3 rounded-lg border border-white/20">
                <span class="text-yellow-400 mr-2">⏰</span>
                <span class="text-white text-sm font-medium">Early Bird Offer - Save 32%!</span>
              </div>
            </div>
            
            <!-- Right Visual (40%) -->
            <div class="lg:col-span-2 relative h-80 lg:h-full flex items-center justify-center">
              <div class="devops-visual relative">
                <!-- DevOps Infinity Loop -->
                <div class="infinity-loop text-6xl lg:text-8xl text-[#ef5753] mb-8 text-center rotating-animation">
                  ∞
                </div>
                
                <!-- Tool Icons in Circle -->
                <div class="tool-circle absolute inset-0 w-48 h-48 mx-auto">
                  <div class="tool jenkins absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-2 text-2xl rotating-tools" style="color: #d33833;">🔧</div>
                  <div class="tool docker absolute top-1/4 right-0 transform translate-x-2 text-2xl rotating-tools" style="color: #2496ed;">🐳</div>
                  <div class="tool kubernetes absolute bottom-1/4 right-0 transform translate-x-2 text-2xl rotating-tools" style="color: #326ce5;">⚙️</div>
                  <div class="tool git absolute bottom-0 left-1/2 transform -translate-x-1/2 translate-y-2 text-2xl rotating-tools" style="color: #f05032;">📝</div>
                  <div class="tool terraform absolute bottom-1/4 left-0 transform -translate-x-2 text-2xl rotating-tools" style="color: #623ce4;">🏗️</div>
                  <div class="tool ansible absolute top-1/4 left-0 transform -translate-x-2 text-2xl rotating-tools" style="color: #ee0000;">⚡</div>
                </div>
                
                <!-- Pipeline Visualization -->
                <div class="pipeline absolute -bottom-8 left-1/2 transform -translate-x-1/2 flex space-x-2">
                  <div class="pipeline-step w-3 h-3 bg-green-400 rounded-full pulse-animation"></div>
                  <div class="pipeline-step w-3 h-3 bg-yellow-400 rounded-full pulse-animation-delayed"></div>
                  <div class="pipeline-step w-3 h-3 bg-blue-400 rounded-full pulse-animation-delayed-2"></div>
                  <div class="pipeline-step w-3 h-3 bg-purple-400 rounded-full pulse-animation-delayed-3"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Slide 3: Docker & Kubernetes Mastery -->
    <div class="slide" data-slide="3">
      <div class="slide-background bg-gradient-to-br from-[#1e3a5f] to-[#2d4a6d] relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10">
          <div class="container-pattern absolute top-10 right-10 text-6xl">📦</div>
          <div class="container-pattern absolute bottom-20 left-20 text-4xl">🚢</div>
          <div class="container-pattern absolute top-1/2 right-1/4 text-3xl">⚓</div>
        </div>
        
        <!-- Floating Particles -->
        <div class="particles absolute inset-0">
          <div class="particle particle-1"></div>
          <div class="particle particle-2"></div>
          <div class="particle particle-3"></div>
        </div>
        
        <div class="container mx-auto px-6 h-full flex items-center">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 w-full items-center">
            
            <!-- Left Content (60%) -->
            <div class="lg:col-span-3 text-white z-10">
              <div class="course-tag text-[#ef5753] text-sm uppercase font-semibold mb-4 tracking-wider">
                🎉 NEW COURSE LAUNCH
              </div>
              
              <h2 class="text-4xl lg:text-5xl font-bold mb-4 leading-tight">
                Complete Docker &<br>
                <span class="text-[#ef5753]">Kubernetes Mastery</span>
              </h2>
              
              <p class="text-xl text-gray-300 mb-2 font-medium">
                Basics to Advanced Level
              </p>
              
              <p class="text-gray-400 mb-6 text-lg leading-relaxed">
                Master containerization and orchestration from Docker fundamentals 
                to advanced Kubernetes deployments.
              </p>
              
              <!-- Features -->
              <div class="features mb-8 space-y-3">
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">21 Comprehensive Modules</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">6+ Real-World Projects</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">Docker & Kubernetes Mastery</span>
                </div>
                <div class="flex items-center text-white">
                  <span class="text-green-400 mr-3 text-lg">✓</span>
                  <span class="text-base">Cloud Deployments (EKS, GKE)</span>
                </div>
              </div>
              
              <!-- Pricing -->
              <div class="pricing mb-8">
                <span class="original-price text-gray-500 text-lg line-through mr-4">PKR 21,999</span>
                <span class="sale-price text-3xl font-bold text-[#ef5753]">PKR 14,999</span>
              </div>
              
              <!-- Buttons -->
              <div class="buttons flex flex-col sm:flex-row gap-4 mb-6">
                <a href="/enroll/docker-kubernetes-mastery" class="enroll-btn bg-gradient-to-r from-[#ef5753] to-[#ff6b6b] text-white px-9 py-4 rounded-full font-semibold text-lg shadow-lg hover:scale-105 transition-all duration-300 text-center inline-block">
                  Enroll Now
                </a>
                <a href="/courses/docker-kubernetes-mastery" class="details-btn border-2 border-white/50 text-white px-9 py-4 rounded-full font-medium text-lg hover:bg-white hover:text-[#1e3a5f] transition-all duration-300 text-center inline-block">
                  View Details
                </a>
              </div>
              
              <!-- Urgency Banner -->
              <div class="urgency-banner bg-black/30 backdrop-blur-sm px-4 py-3 rounded-lg border border-white/20">
                <span class="text-yellow-400 mr-2">⏰</span>
                <span class="text-white text-sm font-medium">Launch Special: Limited Time 32% OFF!</span>
              </div>
            </div>
            
            <!-- Right Visual (40%) -->
            <div class="lg:col-span-2 relative h-80 lg:h-full flex items-center justify-center">
              <div class="docker-k8s-visual relative">
                <!-- Docker + Kubernetes Combined -->
                <div class="combined-logo flex items-center justify-center mb-8">
                  <div class="docker-whale text-5xl lg:text-7xl mr-4 floating-animation" style="color: #2496ed;">🐳</div>
                  <div class="plus text-3xl text-white mx-2">+</div>
                  <div class="k8s-wheel text-5xl lg:text-7xl ml-4 rotating-animation" style="color: #326ce5;">⚙️</div>
                </div>
                
                <!-- Container Boxes -->
                <div class="container-stack absolute -bottom-4 left-1/2 transform -translate-x-1/2">
                  <div class="container-box w-8 h-6 bg-blue-500/60 rounded mb-1 container-animation"></div>
                  <div class="container-box w-8 h-6 bg-green-500/60 rounded mb-1 container-animation-delayed"></div>
                  <div class="container-box w-8 h-6 bg-purple-500/60 rounded container-animation-delayed-2"></div>
                </div>
                
                <!-- Orchestration Network -->
                <div class="network-lines absolute inset-0">
                  <div class="network-line absolute top-1/4 left-1/4 w-1/2 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
                  <div class="network-line absolute top-3/4 left-1/4 w-1/2 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
                  <div class="network-line absolute left-1/4 top-1/4 w-px h-1/2 bg-gradient-to-b from-transparent via-white/30 to-transparent"></div>
                  <div class="network-line absolute right-1/4 top-1/4 w-px h-1/2 bg-gradient-to-b from-transparent via-white/30 to-transparent"></div>
                </div>
                
                <!-- Pod Icons -->
                <div class="pod-icons absolute inset-0">
                  <div class="pod absolute top-0 right-0 text-lg opacity-60 floating-animation">🔵</div>
                  <div class="pod absolute bottom-0 left-0 text-lg opacity-60 floating-animation-delayed">🟢</div>
                  <div class="pod absolute top-1/2 left-0 text-lg opacity-60 floating-animation-delayed-2">🟣</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Navigation Controls -->
  <div class="navigation-controls">
    <!-- Arrow Buttons -->
    <button class="nav-btn prev-btn absolute left-6 top-1/2 transform -translate-y-1/2 w-12 h-12 rounded-full border-2 border-white/50 bg-black/20 backdrop-blur-sm text-white hover:bg-white/20 transition-all duration-300 z-20">
      <svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    
    <button class="nav-btn next-btn absolute right-6 top-1/2 transform -translate-y-1/2 w-12 h-12 rounded-full border-2 border-white/50 bg-black/20 backdrop-blur-sm text-white hover:bg-white/20 transition-all duration-300 z-20">
      <svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    
    <!-- Pagination Dots with better positioning and padding -->
    <div class="pagination-dots absolute bottom-8 left-1/2 transform -translate-x-1/2 flex space-x-3 z-20 pb-4">
      <button class="dot w-3 h-3 rounded-full bg-[#ef5753] transition-all duration-300" data-slide="1"></button>
      <button class="dot w-3 h-3 rounded-full bg-white/30 hover:bg-white/50 transition-all duration-300" data-slide="2"></button>
      <button class="dot w-3 h-3 rounded-full bg-white/30 hover:bg-white/50 transition-all duration-300" data-slide="3"></button>
    </div>
  </div>
</div>

<script>
  // Slider functionality with auto-play
  document.addEventListener('DOMContentLoaded', function() {
    let currentSlide = 1;
    const totalSlides = 3;
    let autoSlideInterval;
    
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.querySelector('.prev-btn');
    const nextBtn = document.querySelector('.next-btn');
    
    // Show specific slide
    function showSlide(slideNumber) {
      // Hide all slides
      slides.forEach(slide => {
        slide.classList.remove('active');
        slide.style.display = 'none';
      });
      
      // Show current slide
      const targetSlide = document.querySelector(`[data-slide="${slideNumber}"]`);
      if (targetSlide) {
        targetSlide.classList.add('active');
        targetSlide.style.display = 'block';
      }
      
      // Update dots
      dots.forEach((dot, index) => {
        dot.classList.remove('bg-[#ef5753]');
        dot.classList.add('bg-white/30');
        if (index + 1 === slideNumber) {
          dot.classList.add('bg-[#ef5753]');
          dot.classList.remove('bg-white/30');
        }
      });
      
      currentSlide = slideNumber;
    }
    
    // Next slide function
    function nextSlide() {
      const next = currentSlide >= totalSlides ? 1 : currentSlide + 1;
      showSlide(next);
    }
    
    // Previous slide function
    function prevSlide() {
      const prev = currentSlide <= 1 ? totalSlides : currentSlide - 1;
      showSlide(prev);
    }
    
    // Start auto-play
    function startAutoPlay() {
      autoSlideInterval = setInterval(nextSlide, 6500); // Change slide every 6.5 seconds
    }
    
    // Stop auto-play
    function stopAutoPlay() {
      if (autoSlideInterval) {
        clearInterval(autoSlideInterval);
      }
    }
    
    // Event listeners for navigation buttons
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        stopAutoPlay();
        nextSlide();
        startAutoPlay(); // Restart auto-play after manual navigation
      });
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        stopAutoPlay();
        prevSlide();
        startAutoPlay(); // Restart auto-play after manual navigation
      });
    }
    
    // Event listeners for dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopAutoPlay();
        showSlide(index + 1);
        startAutoPlay(); // Restart auto-play after manual navigation
      });
    });
    
    // Pause auto-play on hover
    const sliderContainer = document.querySelector('.announcement-slider-container');
    if (sliderContainer) {
      sliderContainer.addEventListener('mouseenter', stopAutoPlay);
      sliderContainer.addEventListener('mouseleave', startAutoPlay);
