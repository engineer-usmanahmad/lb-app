    animation: float 7s ease-in-out infinite;
  }
  
  /* Animations */
  @keyframes float {
    0%, 100% { transform: translateY(0px) translateX(0px); }
    25% { transform: translateY(-20px) translateX(10px); }
    50% { transform: translateY(-10px) translateX(-5px); }
    75% { transform: translateY(-15px) translateX(5px); }
  }
  
  .floating-animation {
    animation: floating 3s ease-in-out infinite;
  }
  
  .floating-animation-delayed {
    animation: floating 3s ease-in-out infinite 0.5s;
  }
  
  .floating-animation-delayed-2 {
    animation: floating 3s ease-in-out infinite 1s;
  }
  
  .floating-animation-delayed-3 {
    animation: floating 3s ease-in-out infinite 1.5s;
  }
  
  @keyframes floating {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  .rotating-animation {
    animation: rotate 10s linear infinite;
  }
  
  .rotating-tools {
    animation: rotateTools 15s linear infinite;
  }
  
  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  @keyframes rotateTools {
    from { transform: rotate(0deg) translateX(60px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(60px) rotate(-360deg); }
  }
  
  .pulse-animation {
    animation: pulse 2s ease-in-out infinite;
  }
  
  .pulse-animation-delayed {
    animation: pulse 2s ease-in-out infinite 0.3s;
  }
  
  .pulse-animation-delayed-2 {
    animation: pulse 2s ease-in-out infinite 0.6s;
  }
  
  .pulse-animation-delayed-3 {
    animation: pulse 2s ease-in-out infinite 0.9s;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }
  
  .container-animation {
    animation: containerDeploy 3s ease-in-out infinite;
  }
  
  .container-animation-delayed {
    animation: containerDeploy 3s ease-in-out infinite 0.5s;
  }
  
  .container-animation-delayed-2 {
    animation: containerDeploy 3s ease-in-out infinite 1s;
  }
  
  @keyframes containerDeploy {
    0%, 100% { transform: translateY(0px) scale(1); opacity: 1; }
    50% { transform: translateY(-5px) scale(1.05); opacity: 0.8; }
  }
  
  /* Button Hover Effects */
  .enroll-btn {
    box-shadow: 0 6px 20px rgba(239, 87, 83, 0.4);
  }
  
  .enroll-btn:hover {
    box-shadow: 0 8px 25px rgba(239, 87, 83, 0.6);
  }
  
  /* Navigation */
  .nav-btn:hover {
    transform: translateY(-50%) scale(1.1);
  }
  
  .dot.active {
    background-color: #ef5753;
  }
  
  /* Responsive Design - Enhanced */
  @media (max-width: 767px) {
    .announcement-slider-container {
      min-height: auto;
      padding: 40px 0;
    }
    
    .slide-background {
      padding: 2rem 0;
      min-height: auto;
    }
    
    .slide .grid {
      flex-direction: column;
      min-height: auto;
      gap: 2rem;
    }
    
    .lg\\:col-span-3,
    .lg\\:col-span-2 {
      flex: none;
      width: 100%;
      padding-right: 0;
    }
    
    .lg\\:col-span-2 {
      min-height: 300px;
      margin-top: 30px;
      height: auto;
    }
    
    .text-4xl.lg\\:text-5xl {
      font-size: 2rem;
      line-height: 1.2;
    }
    
    .buttons {
      flex-direction: column;
    }
    
    .enroll-btn,
    .details-btn {
      width: 100%;
      text-align: center;
    }
    
    .nav-btn,
    .slider-button-prev,
    .slider-button-next {
      display: none;
    }
    
    /* Mobile Icon Sizes */
    .certification-badge, .aws-badge { width: 70px !important; height: 70px !important; }
    .tool-icon, .devops-icon, .tool { width: 55px !important; height: 55px !important; font-size: 2rem !important; }
    .docker-logo, .kubernetes-logo, .docker-whale, .k8s-wheel { width: 100px !important; height: 100px !important; font-size: 4rem !important; }
    .infinity-loop { font-size: 4rem !important; }
  }
  
  @media (min-width: 768px) and (max-width: 1199px) {
    .announcement-slider-container {
      min-height: 550px;
      padding: 60px 0;
    }
    
    .slide .grid {
      gap: 40px;
    }
    
    .lg\\:col-span-3 {
      flex: 0 0 60%;
    }
    
    .lg\\:col-span-2 {
      flex: 0 0 35%;
      min-height: 400px;
    }
    
    .text-4xl.lg\\:text-5xl {
      font-size: 2.5rem;
    }
    
    /* Tablet Icon Sizes */
    .certification-badge, .aws-badge { width: 85px !important; height: 85px !important; }
    .tool-icon, .devops-icon, .tool { width: 70px !important; height: 70px !important; font-size: 2.5rem !important; }
    .docker-logo, .kubernetes-logo, .docker-whale, .k8s-wheel { width: 120px !important; height: 120px !important; font-size: 5.5rem !important; }
    .infinity-loop { font-size: 5rem !important; }
  }