---
// AnnouncementSlider.astro - Professional course announcement slider
---

<!-- Add top margin to prevent overlap with sticky header -->
<div class="announcement-slider-container relative overflow-hidden mt-0 font-sans bg-slate-900">
  <!-- Slider Wrapper -->
  <div class="slider-wrapper relative min-h-[700px] h-auto flex flex-col">
    
    <!-- Slide 1: AWS 3-in-1 Certification -->
    <div class="slide active h-full flex-1 w-full" data-slide="1">
      <div class="slide-background bg-gradient-to-br from-[#0f172a] via-[#1e293b] to-[#0f172a] relative overflow-hidden h-full">
        <!-- Abstract Tech Background -->
        <div class="absolute inset-0 opacity-20">
          <div class="absolute top-0 left-0 w-full h-full bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4xKSIvPjwvc3ZnPg==')] mask-image-gradient"></div>
          <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl"></div>
          <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>
        </div>
        
        <div class="container mx-auto px-6 h-auto lg:h-full pt-20 pb-24 lg:pt-20 lg:pb-24 flex items-start lg:items-center relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 w-full items-center">
            
            <!-- Left Content -->
            <div class="text-white space-y-6">
              <div class="inline-flex items-center space-x-2 bg-blue-500/10 border border-blue-500/20 rounded-full px-4 py-1.5 backdrop-blur-sm">
                <span class="flex h-2 w-2 relative">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                </span>
                <span class="text-blue-200 text-sm font-medium tracking-wide">PREMIUM CLOUD TRAINING</span>
              </div>
              
              <h2 class="text-4xl lg:text-6xl font-bold leading-tight">
                Master AWS Cloud<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">3-in-1 Certification</span>
              </h2>
              
              <p class="text-lg text-slate-300 max-w-xl leading-relaxed">
                The ultimate path to becoming a Cloud Architect. Cover Solutions Architect, Developer, and SysOps Administrator in one comprehensive program.
              </p>
              
              <div class="grid grid-cols-2 gap-4 max-w-md">
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>3 Certifications</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>50+ Hands-on Labs</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Lifetime Access</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Real Projects</span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <a href="/enroll/aws-3-in-1" class="group relative px-8 py-4 bg-blue-600 hover:bg-blue-500 rounded-lg text-white font-semibold transition-all duration-300 shadow-[0_0_20px_rgba(37,99,235,0.3)] hover:shadow-[0_0_30px_rgba(37,99,235,0.5)] overflow-hidden">
                  <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
                  <span class="relative flex items-center justify-center gap-2">
                    Enroll Now
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </span>
                </a>
                <div class="flex items-center gap-3 px-6">
                  <div class="text-right">
                    <div class="text-sm text-slate-400 line-through">PKR 60,000</div>
                    <div class="text-2xl font-bold text-white">PKR 48,000</div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Right Visual (Professional SVG Composition) -->
            <div class="relative h-[400px] flex items-center justify-center lg:justify-end">
              <div class="relative w-80 h-80">
                <!-- Glowing Orb -->
                <div class="absolute inset-0 bg-blue-500/20 rounded-full blur-[60px] animate-pulse-slow"></div>
                
                <!-- Central Cloud Icon -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-gradient-to-br from-white to-blue-100 rounded-2xl shadow-2xl flex items-center justify-center z-20 animate-float">
                  <svg class="w-20 h-20 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.42 9.22a7.5 7.5 0 0 0-13.84 2.3C2.18 11.96 0 13.98 0 16.5A5.5 5.5 0 0 0 5.5 22h13A5.5 5.5 0 0 0 24 16.5c0-2.82-2.11-5.18-4.83-5.45c-.25-2.03-1.1-3.95-2.75-5.28z"/>
                  </svg>
                </div>

                <!-- Orbiting Elements -->
                <div class="absolute inset-0 animate-spin-slow">
                  <!-- Satellite 1 -->
                  <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-16 h-16 bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl flex flex-col items-center justify-center shadow-xl transform hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-yellow-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    <span class="text-[8px] font-bold text-slate-300">ARCH</span>
                  </div>
                  <!-- Satellite 2 -->
                  <div class="absolute bottom-10 -right-4 w-16 h-16 bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl flex flex-col items-center justify-center shadow-xl transform rotate-120 hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-green-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                    <span class="text-[8px] font-bold text-slate-300">DEV</span>
                  </div>
                  <!-- Satellite 3 -->
                  <div class="absolute bottom-10 -left-4 w-16 h-16 bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl flex flex-col items-center justify-center shadow-xl transform rotate-240 hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 text-purple-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                    <span class="text-[8px] font-bold text-slate-300">OPS</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Slide 2: DevOps Zero to Hero -->
    <div class="slide h-full flex-1 w-full" data-slide="2">
      <div class="slide-background bg-gradient-to-br from-[#0f172a] via-[#0f252a] to-[#0f172a] relative overflow-hidden h-full">
        <!-- Abstract Tech Background -->
        <div class="absolute inset-0 opacity-20">
          <div class="absolute top-0 right-0 w-full h-full bg-[linear-gradient(rgba(16,185,129,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.05)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-emerald-500/10 rounded-full blur-[100px]"></div>
        </div>
        
        <div class="container mx-auto px-6 h-auto lg:h-full pt-20 pb-24 lg:pt-20 lg:pb-24 flex items-start lg:items-center relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 w-full items-center">
            
            <!-- Left Content -->
            <div class="text-white space-y-6">
              <div class="inline-flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full px-4 py-1.5 backdrop-blur-sm">
                <span class="flex h-2 w-2 relative">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="text-emerald-200 text-sm font-medium tracking-wide">CAREER TRANSFORMATION</span>
              </div>
              
              <h2 class="text-4xl lg:text-6xl font-bold leading-tight">
                DevOps Zero to<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-400">Hero Journey</span>
              </h2>
              
              <p class="text-lg text-slate-300 max-w-xl leading-relaxed">
                Bridge the gap between development and operations. Master the complete CI/CD lifecycle, automation, and infrastructure as code.
              </p>
              
              <div class="grid grid-cols-2 gap-4 max-w-md">
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>12+ Tools Covered</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>CI/CD Pipelines</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Terraform & Ansible</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Job Ready Skills</span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <a href="/enroll/devops-zero-to-hero" class="group relative px-8 py-4 bg-emerald-600 hover:bg-emerald-500 rounded-lg text-white font-semibold transition-all duration-300 shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] overflow-hidden">
                  <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
                  <span class="relative flex items-center justify-center gap-2">
                    Start Journey
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </span>
                </a>
                <div class="flex items-center gap-3 px-6">
                  <div class="text-right">
                    <div class="text-sm text-slate-400 line-through">PKR 75,000</div>
                    <div class="text-2xl font-bold text-white">PKR 60,000</div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Right Visual (Infinity Loop SVG) -->
            <div class="relative h-[400px] flex items-center justify-center lg:justify-end">
              <div class="relative w-96 h-64">
                <svg class="w-full h-full drop-shadow-2xl animate-float" viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <!-- Infinity Path Background -->
                  <path d="M100,50 C70,50 70,20 40,20 S10,35 10,50 S20,80 40,80 S70,50 100,50 S130,20 160,20 S190,35 190,50 S180,80 160,80 S130,50 100,50" 
                        stroke="#0f3d3e" stroke-width="12" stroke-linecap="round"/>
                  
                  <!-- Infinity Path Active -->
                  <path class="animate-draw-path" d="M100,50 C70,50 70,20 40,20 S10,35 10,50 S20,80 40,80 S70,50 100,50 S130,20 160,20 S190,35 190,50 S180,80 160,80 S130,50 100,50" 
                        stroke="url(#gradient-devops)" stroke-width="6" stroke-linecap="round" stroke-dasharray="400" stroke-dashoffset="400"/>

                  
                  <defs>
                    <linearGradient id="gradient-devops" x1="0" y1="0" x2="200" y2="0">
                      <stop offset="0%" stop-color="#34d399"/>
                      <stop offset="100%" stop-color="#2dd4bf"/>
                    </linearGradient>
                  </defs>
                </svg>
                
                <!-- Floating Icons around loop -->
                <div class="absolute top-0 left-1/4 animate-bounce-slow text-3xl">⚙️</div>
                <div class="absolute bottom-0 right-1/4 animate-bounce-delayed text-3xl">🚀</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Slide 3: Docker & Kubernetes -->
    <div class="slide h-full flex-1 w-full" data-slide="3">
      <div class="slide-background bg-gradient-to-br from-[#0f172a] via-[#1e1b4b] to-[#0f172a] relative overflow-hidden h-full">
        <!-- Abstract Tech Background -->
        <div class="absolute inset-0 opacity-20">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(99,102,241,0.1)_0,transparent_70%)]"></div>
          <div class="grid grid-cols-6 gap-4 absolute inset-0 transform -skew-y-12 scale-150 opacity-10">
             <div class="h-full w-1 bg-indigo-500/50"></div>
             <div class="h-full w-1 bg-indigo-500/50"></div>
             <div class="h-full w-1 bg-indigo-500/50"></div>
             <div class="h-full w-1 bg-indigo-500/50"></div>
             <div class="h-full w-1 bg-indigo-500/50"></div>
             <div class="h-full w-1 bg-indigo-500/50"></div>
          </div>
        </div>
        
        <div class="container mx-auto px-6 h-auto lg:h-full pt-20 pb-24 lg:pt-20 lg:pb-24 flex items-start lg:items-center relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 w-full items-center">
            
            <!-- Left Content -->
            <div class="text-white space-y-6">
              <div class="inline-flex items-center space-x-2 bg-indigo-500/10 border border-indigo-500/20 rounded-full px-4 py-1.5 backdrop-blur-sm">
                <span class="flex h-2 w-2 relative">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                </span>
                <span class="text-indigo-200 text-sm font-medium tracking-wide">CONTAINER MASTERY</span>
              </div>
              
              <h2 class="text-4xl lg:text-6xl font-bold leading-tight">
                Docker & Kubernetes<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-pink-400">Master Class</span>
              </h2>
              
              <p class="text-lg text-slate-300 max-w-xl leading-relaxed">
                Scale your applications with confidence. Learn to containerize, orchestrate, and manage microservices at scale.
              </p>
              
              <div class="grid grid-cols-2 gap-4 max-w-md">
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Production Deployment</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Microservices Arch</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Helm Charts</span>
                </div>
                <div class="flex items-center space-x-2 text-sm text-slate-300">
                  <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Cloud Native</span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <a href="/enroll/docker-kubernetes-mastery" class="group relative px-8 py-4 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-white font-semibold transition-all duration-300 shadow-[0_0_20px_rgba(79,70,229,0.3)] hover:shadow-[0_0_30px_rgba(79,70,229,0.5)] overflow-hidden">
                  <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
                  <span class="relative flex items-center justify-center gap-2">
                    Enroll Now
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </span>
                </a>
                <div class="flex items-center gap-3 px-6">
                  <div class="text-right">
                    <div class="text-sm text-slate-400 line-through">PKR 21,999</div>
                    <div class="text-2xl font-bold text-white">PKR 14,999</div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Right Visual (3D Cubes) -->
            <div class="relative h-[400px] flex items-center justify-center lg:justify-end perspective-1000">
              <div class="relative transform-style-3d animate-float">
                <!-- CSS 3D Cube Cluster -->
                <div class="grid grid-cols-2 gap-4 transform rotate-x-12 rotate-y-12 rotate-z-12">
                   <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-blue-700 rounded-lg shadow-lg opacity-90 backdrop-blur-sm border border-white/20"></div>
                   <div class="w-24 h-24 bg-gradient-to-br from-indigo-500 to-indigo-700 rounded-lg shadow-lg opacity-90 backdrop-blur-sm border border-white/20 mt-8"></div>
                   <div class="w-24 h-24 bg-gradient-to-br from-purple-500 to-purple-700 rounded-lg shadow-lg opacity-90 backdrop-blur-sm border border-white/20 -mt-8"></div>
                   <div class="w-24 h-24 bg-gradient-to-br from-pink-500 to-pink-700 rounded-lg shadow-lg opacity-90 backdrop-blur-sm border border-white/20"></div>
                </div>
                <!-- Connecting Lines -->
                <div class="absolute inset-0 pointer-events-none">
                   <svg class="w-full h-full absolute top-0 left-0" style="overflow: visible">
                      <line x1="20%" y1="20%" x2="80%" y2="80%" stroke="rgba(255,255,255,0.2)" stroke-width="2" />
                      <line x1="80%" y1="20%" x2="20%" y2="80%" stroke="rgba(255,255,255,0.2)" stroke-width="2" />
                   </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  </div>
  
  <!-- Navigation Controls -->
  <div class="navigation-controls absolute bottom-8 left-0 right-0 z-30 pointer-events-none">
    <div class="container mx-auto px-6 relative flex justify-between items-center h-full">
      <!-- Arrow Buttons -->
      <button class="nav-btn prev-btn w-12 h-12 rounded-full border border-white/20 bg-black/20 backdrop-blur-md text-white hover:bg-white/20 transition-all duration-300 pointer-events-auto flex items-center justify-center group">
        <svg class="w-6 h-6 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      
      <!-- Pagination Dots -->
      <div class="pagination-dots flex space-x-3 pointer-events-auto bg-black/20 backdrop-blur-md px-4 py-2 rounded-full border border-white/10">
        <button class="dot w-2.5 h-2.5 rounded-full bg-white transition-all duration-300" data-slide="1"></button>
        <button class="dot w-2.5 h-2.5 rounded-full bg-white/30 hover:bg-white/50 transition-all duration-300" data-slide="2"></button>
        <button class="dot w-2.5 h-2.5 rounded-full bg-white/30 hover:bg-white/50 transition-all duration-300" data-slide="3"></button>
      </div>
      
      <button class="nav-btn next-btn w-12 h-12 rounded-full border border-white/20 bg-black/20 backdrop-blur-md text-white hover:bg-white/20 transition-all duration-300 pointer-events-auto flex items-center justify-center group">
        <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
  // Slider functionality with auto-play
  document.addEventListener('DOMContentLoaded', function() {
    let currentSlide = 1;
    const totalSlides = 3;
    let autoSlideInterval;
    
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.querySelector('.prev-btn');
    const nextBtn = document.querySelector('.next-btn');
    
    // Show specific slide
    function showSlide(slideNumber) {
      // Hide all slides
      slides.forEach(slide => {
        slide.classList.remove('active');
        slide.style.opacity = '0';
        setTimeout(() => {
            if(!slide.classList.contains('active')) slide.style.display = 'none';
        }, 500); // Fade out duration
      });
      
      // Show current slide
      const targetSlide = document.querySelector(`[data-slide="${slideNumber}"]`);
      if (targetSlide) {
        targetSlide.style.display = 'block';
        // Force reflow
        targetSlide.offsetHeight; 
        targetSlide.classList.add('active');
        targetSlide.style.opacity = '1';
      }
      
      // Update dots
      dots.forEach((dot, index) => {
        dot.classList.remove('bg-white', 'w-8');
        dot.classList.add('bg-white/30', 'w-2.5');
        if (index + 1 === slideNumber) {
          dot.classList.remove('bg-white/30', 'w-2.5');
          dot.classList.add('bg-white', 'w-8'); // Active dot is wider
        }
      });
      
      currentSlide = slideNumber;
    }
    
    // Next slide function
    function nextSlide() {
      const next = currentSlide >= totalSlides ? 1 : currentSlide + 1;
      showSlide(next);
    }
    
    // Previous slide function
    function prevSlide() {
      const prev = currentSlide <= 1 ? totalSlides : currentSlide - 1;
      showSlide(prev);
    }
    
    // Start auto-play
    function startAutoPlay() {
      autoSlideInterval = setInterval(nextSlide, 6500); // Change slide every 6.5 seconds
    }
    
    // Stop auto-play
    function stopAutoPlay() {
      if (autoSlideInterval) {
        clearInterval(autoSlideInterval);
      }
    }
    
    // Event listeners for navigation buttons
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        stopAutoPlay();
        nextSlide();
        startAutoPlay();
      });
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        stopAutoPlay();
        prevSlide();
        startAutoPlay();
      });
    }
    
    // Event listeners for dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopAutoPlay();
        showSlide(index + 1);
        startAutoPlay();
      });
    });
    
    // Pause auto-play on hover
    const sliderContainer = document.querySelector('.announcement-slider-container');
    if (sliderContainer) {
      sliderContainer.addEventListener('mouseenter', stopAutoPlay);
      sliderContainer.addEventListener('mouseleave', startAutoPlay);
    }
    
    // Initialize slider
    showSlide(1);
    startAutoPlay();
  });
</script>

<style>
  .announcement-slider-container {
    /* Ensure no clipping */
    overflow: hidden; 
  }
  
  .slide {
    transition: opacity 0.5s ease-in-out;
  }
  
  /* Animations */
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
  .animate-shimmer { animation: shimmer 2s infinite; }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }
  .animate-float { animation: float 6s ease-in-out infinite; }
  
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow { animation: spin-slow 20s linear infinite; }
  
  @keyframes draw-path {
    0% { stroke-dashoffset: 400; }
    100% { stroke-dashoffset: 0; }
  }
  .animate-draw-path { animation: draw-path 3s ease-out forwards infinite; }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.1); }
  }
  .animate-pulse-slow { animation: pulse-slow 4s ease-in-out infinite; }
</style>
