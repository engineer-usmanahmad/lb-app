---
---

<section class="py-24 bg-slate-900 relative overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-5"></div>
  <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"></div>
  
  <!-- Animated Background Blobs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl mix-blend-screen filter animate-pulse-slow"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl mix-blend-screen filter animate-pulse-slow delay-1000"></div>
  
  <div class="container mx-auto px-4 text-center relative z-10">
    
    <!-- Heading & Subheading -->
    <div class="max-w-4xl mx-auto mb-16 animate-fade-in">
      <div class="inline-block px-4 py-1.5 mb-6 rounded-full bg-teal-500/10 border border-teal-500/20 backdrop-blur-sm">
        <span class="text-teal-400 font-semibold tracking-wide text-sm uppercase">🚀 Career Acceleration Platform</span>
      </div>
      
      <h2 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight text-white tracking-tight">
        Where Tech Talent Gets <br class="hidden md:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">Career-Ready</span>
      </h2>
      
      <p class="text-xl md:text-2xl text-slate-300 font-light mb-8 max-w-2xl mx-auto">
        Empowering Professionals, Engineering Futures
      </p>
      
      <p class="text-lg text-slate-400 leading-relaxed max-w-3xl mx-auto">
        LbisTech isn't just another training institute, we're a career acceleration platform that transforms motivated individuals into certified, job-ready technology professionals through expert-led, hands-on programs with lifetime support.
      </p>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16 max-w-6xl mx-auto">
      
      <!-- Stat 1: Students -->
      <div class="group bg-white/5 backdrop-blur-md rounded-2xl p-8 border border-white/10 hover:border-teal-500/30 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:shadow-teal-500/10 animate-slide-up" style="animation-delay: 0.1s;">
        <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-teal-500 to-emerald-500 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-white mb-2 tracking-tight">5,000+</div>
        <div class="text-teal-200 font-medium uppercase tracking-wider text-sm">Students Trained</div>
      </div>

      <!-- Stat 2: Success Rate -->
      <div class="group bg-white/5 backdrop-blur-md rounded-2xl p-8 border border-white/10 hover:border-teal-500/30 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:shadow-teal-500/10 animate-slide-up" style="animation-delay: 0.2s;">
        <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-white mb-2 tracking-tight">98%</div>
        <div class="text-blue-200 font-medium uppercase tracking-wider text-sm">Success Rate</div>
      </div>

      <!-- Stat 3: Community -->
      <div class="group bg-white/5 backdrop-blur-md rounded-2xl p-8 border border-white/10 hover:border-teal-500/30 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:shadow-teal-500/10 animate-slide-up" style="animation-delay: 0.3s;">
        <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="text-4xl font-bold text-white mb-2 tracking-tight">8,000+</div>
        <div class="text-purple-200 font-medium uppercase tracking-wider text-sm">Community Members</div>
      </div>
      
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-6 justify-center animate-slide-up" style="animation-delay: 0.4s;">
      <a href="/courses" class="group relative px-8 py-4 bg-gradient-to-r from-teal-500 to-emerald-500 rounded-full text-white font-bold text-lg shadow-lg hover:shadow-teal-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
        <span class="relative z-10 flex items-center">
          Explore Our Programs
          <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </a>
      
      <a href="/our-success" class="group px-8 py-4 bg-white/5 border border-white/20 hover:bg-white/10 rounded-full text-white font-bold text-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-white/40">
        <span class="flex items-center">
          Success Stories
          <svg class="w-5 h-5 ml-2 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </span>
      </a>
    </div>

  </div>
</section>

<style>
  /* Animations */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from { 
      opacity: 0; 
      transform: translateY(30px); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0); 
    }
  }

  @keyframes pulseSlow {
    0%, 100% { opacity: 0.1; transform: scale(1); }
    50% { opacity: 0.2; transform: scale(1.1); }
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }
  
  .animate-slide-up {
    opacity: 0;
    animation: slideUp 0.8s ease-out forwards;
  }
  
  .animate-pulse-slow {
    animation: pulseSlow 6s infinite ease-in-out;
  }
</style>
